{"version":"2.0","class":"dataset","label":"Income quintile share ratio (S80/S20) by sex","source":"ESTAT","updated":"2026-10-20T11:00:00+0200","value":{"0":6.96,"1":6.73,"2":6.47,"3":6.11,"4":6.01,"5":5.56,"6":5.68,"7":5.82,"8":6.01,"9":6.23,"10":6.01,"11":5.88,"12":5.75,"13":5.22,"14":5.16,"15":4.99,"16":5.66,"17":5.13,"18":5.60,"19":5.20,"20":4.86},"id":["freq","age","sex","unit","geo","time"],"size":[1,1,1,1,1,21],"dimension":{"freq":{"label":"Time frequency","category":{"index":{"A":0},"label":{"A":"Annual"}}},"age":{"label":"Age class","category":{"index":{"TOTAL":0},"label":{"TOTAL":"Total"}}},"sex":{"label":"Sex","category":{"index":{"T":0},"label":{"T":"Total"}}},"unit":{"label":"Unit of measure","category":{"index":{"RAT":0},"label":{"RAT":"Ratio"}}},"geo":{"label":"Geopolitical entity (reporting)","category":{"index":{"PT":0},"label":{"PT":"Portugal"}}},"time":{"label":"Time","category":{"index":{"2005":0,"2006":1,"2007":2,"2008":3,"2009":4,"2010":5,"2011":6,"2012":7,"2013":8,"2014":9,"2015":10,"2016":11,"2017":12,"2018":13,"2019":14,"2020":15,"2021":16,"2022":17,"2023":18,"2024":19,"2025":20},"label":{"2005":"2005","2006":"2006","2007":"2007","2008":"2008","2009":"2009","2010":"2010","2011":"2011","2012":"2012","2013":"2013","2014":"2014","2015":"2015","2016":"2016","2017":"2017","2018":"2018","2019":"2019","2020":"2020","2021":"2021","2022":"2022","2023":"2023","2024":"2024","2025":"2025"}}}},"extension":{"lang":"EN","description":"The ratio of total income received by the 20 % of the population with the highest income (top quintile) to that received by the 20 % of the population with the lowest income (lowest quintile). Income must be understood as equivalised disposable income. The indicator is based on the EU-SILC (statistics on income, social inclusion and living conditions).","id":"TESSI180","agencyId":"ESTAT","version":"1.0","datastructure":{"id":"TESSI180","agencyId":"ESTAT","version":"79.0"},"annotation":[{"type":"CREATED","date":"2010-09-09T16: