{"version":"2.0","class":"dataset","label":"Perceived independence of the justice system","source":"ESTAT","updated":"2026-01-08T23:00:00+0100","value":{"0":33,"1":42,"2":50,"3":42,"4":40,"5":48,"6":47,"7":49,"8":53,"9":58},"id":["freq","lev_perc","unit","geo","time"],"size":[1,1,1,1,10],"dimension":{"freq":{"label":"Time frequency","category":{"index":{"A":0},"label":{"A":"Annual"}}},"lev_perc":{"label":"Level of perception","category":{"index":{"VG_FG":0},"label":{"VG_FG":"Very good or fairly good"}}},"unit":{"label":"Unit of measure","category":{"index":{"PC":0},"label":{"PC":"Percentage"}}},"geo":{"label":"Geopolitical entity (reporting)","category":{"index":{"PT":0},"label":{"PT":"Portugal"}}},"time":{"label":"Time","category":{"index":{"2016":0,"2017":1,"2018":2,"2019":3,"2020":4,"2021":5,"2022":6,"2023":7,"2024":8,"2025":9},"label":{"2016":"2016","2017":"2017","2018":"2018","2019":"2019","2020":"2020","2021":"2021","2022":"2022","2023":"2023","2024":"2024","2025":"2025"}}}},"extension":{"lang":"EN","description":"The indicator is designed to explore respondents’ perceptions about the independence of the judiciary across EU Member States, looking specifically at the perceived independence of the courts and judges in a country. Data on the perceived independence of the justice system stem from annual Flash Eurobarometer surveys starting in 2016 on behalf of the European Commission’s Directorate-General for Justice and Consumers.","id":"SDG_16_40","agencyId":"ESTAT","version":"1.0","datastructure":{"id":"SDG_16_40","agencyId":"ESTAT","version":"28.0"},"annotation":[{"type":"CREATED","date":"2017-11-06T15:08:55+0100"},{"type":"DISSEMINATION_DOI_XML","title":"<adms:identifier xmlns:adms=\"http://www.w3.org/ns/adms#\" xmlns:skos=\"http://www.w3.org/2004/02/skos/core.html\" xmlns:dct=\"http://purl.org/dc/terms/\" xmlns:rdf=\"http://www.w3.org/1999/02/22-rdf-syntax-ns#\"><adms:Identifier rdf:about=\"https://doi.org/10.2908/SDG_16_40\"><skos:notation rdf:datatype=\"ht