diff --git a/scripts/check-paridade-graficos.mjs b/scripts/check-paridade-graficos.mjs
new file mode 100644
--- /dev/null
+++ b/scripts/check-paridade-graficos.mjs
@@ -0,0 +1,51 @@
+/** COR-AGUA: a paridade dos blocos não vê os dados que os gráficos leem. */
+import fs from 'node:fs';
+import path from 'node:path';
+import {pathToFileURL} from 'node:url';
+import {parse} from 'node-html-parser';
+
+export function valoresNumericos(valor, caminho = '', resultado = {}) {
+  if (typeof valor === 'number') resultado[caminho] = valor;
+  else if (valor && typeof valor === 'object') {
+    for (const [chave, filho] of Object.entries(valor)) valoresNumericos(filho, caminho + '/' + chave, resultado);
+  }
+  return resultado;
+}
+export function compararDados(pt, en) {
+  const a = valoresNumericos(pt), b = valoresNumericos(en);
+  return [...new Set([...Object.keys(a), ...Object.keys(b)])].sort().flatMap(caminho =>
+    a[caminho] === b[caminho] ? [] : [{caminho, pt:a[caminho] ?? null, en:b[caminho] ?? null}]);
+}
+export function compararHtml(pt, en) {
+  const dados = html => {
+    const no = parse(html).querySelector('script#payload[type="application/json"]');
+    return no ? JSON.parse(no.textContent) : null;
+  };
+  const a = dados(pt), b = dados(en);
+  if (!a && !b) return {medido:false, diferencas:[]};
+  if (!a || !b) return {medido:true, diferencas:[{caminho:'payload', razao:'dados ausentes numa edição'}]};
+  return {medido:true, diferencas:compararDados(a, b)};
+}
+export function conferirGraficos(raiz = 'dist') {
+  const fontes = !fs.existsSync(path.join(raiz, 'estudos'));
+  const estudos = fontes ? raiz : path.join(raiz, 'estudos');
+  const erros = [], medidos = [];
+  for (const estudo of fs.readdirSync(estudos).sort()) {
+    const pt = fontes ? path.join(raiz, estudo, 'pt.html') : path.join(estudos, estudo, 'documento/index.html');
+    const en = fontes ? path.join(raiz, estudo, 'en.html') : path.join(raiz, 'en/studies', estudo, 'document/index.html');
+    if (!fs.existsSync(pt) || !fs.existsSync(en)) continue;
+    const r = compararHtml(fs.readFileSync(pt, 'utf8'), fs.readFileSync(en, 'utf8'));
+    if (r.medido) medidos.push(estudo);
+    for (const diferenca of r.diferencas) erros.push({estudo, ...diferenca});
+  }
+  if (!medidos.length) erros.push({razao:'nenhum estudo bilingue com dados de gráficos medido'});
+  return {medidos, erros};
+}
+if (process.argv[1] && import.meta.url === pathToFileURL(path.resolve(process.argv[1])).href) {
+  try {
+    const r = conferirGraficos(process.argv[2] ?? 'dist');
+    console.log(`paridade dos gráficos: ${r.medidos.length} estudos bilingues; ${r.erros.length} diferenças`);
+    for (const e of r.erros) console.error(JSON.stringify(e));
+    process.exitCode = r.erros.length ? 1 : 0;
+  } catch { console.error('paridade dos gráficos: HTML ou dados JSON ilegíveis'); process.exitCode = 1; }
+}
diff --git a/tests/edicoes/testemunhas.mjs b/tests/edicoes/testemunhas.mjs
new file mode 100644
--- /dev/null
+++ b/tests/edicoes/testemunhas.mjs
@@ -0,0 +1,19 @@
+import assert from 'node:assert/strict';
+import {createHash} from 'node:crypto';
+import {conferirTestemunhas} from '../../scripts/historia-edicoes-conferir.mjs';
+import {HOST_PREFIX, HOST_HEAD, HOST_SUFFIX, RUNTIME_OPEN, RUNTIME_CLOSE} from '../../scripts/normalize-study.mjs';
+const sha = b => createHash('sha256').update(b).digest('hex');
+const corpo = '<p>A fonte publicou 12.</p>';
+const normalizado = Buffer.from(HOST_PREFIX + HOST_HEAD + corpo + HOST_SUFFIX);
+const bruto = runtime => Buffer.from(HOST_PREFIX + RUNTIME_OPEN + runtime + RUNTIME_CLOSE + HOST_HEAD + corpo + HOST_SUFFIX);
+const entrada = {slug:'planta', lang:'pt', raw_file:'_raw/planta.pt.html', artifact_url:'https://example.test/artefacto', primeira_edicao:{commit:'a'.repeat(40), sha256:sha(normalizado)}};
+const medir = (e, bytes, opcoes) => conferirTestemunhas({edicoes:[e]}, () => bytes, opcoes);
+assert.deepEqual(medir(entrada, bruto('runtime original')), {erros:[], avisos:[]});
+assert.deepEqual(medir(entrada, bruto('outro runtime')), {erros:[], avisos:[]});
+assert.equal(medir(entrada, Buffer.from(bruto('runtime').toString().replace('12', '13'))).erros.length, 1);
+assert.equal(medir(entrada, Buffer.from('invólucro inválido')).erros.length, 1);
+assert.equal(medir(entrada, Buffer.from('invólucro inválido'), {permitirAusencia:true}).erros.length, 1);
+const motor = {...entrada}; delete motor.artifact_url;
+assert.deepEqual(medir(motor, normalizado), {erros:[], avisos:[]});
+assert.equal(medir(motor, bruto('runtime')).erros.length, 1);
+console.log('ED1 testemunhas: 7 controlos e plantas; só a origem externa normaliza o runtime.');
diff --git a/tests/leituras/paridade-graficos.mjs b/tests/leituras/paridade-graficos.mjs
new file mode 100644
--- /dev/null
+++ b/tests/leituras/paridade-graficos.mjs
@@ -0,0 +1,23 @@
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import {compararDados, compararHtml, conferirGraficos} from '../../scripts/check-paridade-graficos.mjs';
+const pt = {prices:[{n:'Doméstico', v:1.348}, {n:'Rega', v:0.0706}]};
+const en = {prices:[{n:'Household', v:1.348}, {n:'Irrigation', v:0.0706}]};
+const html = d => '<script id="payload" type="application/json">' + JSON.stringify(d) + '</script>';
+assert.deepEqual(compararDados(pt, en), []);
+assert.deepEqual(compararDados(pt, {...en, prices:[...en.prices].reverse()}).map(d => d.caminho), ['/prices/0/v', '/prices/1/v']);
+assert.equal(compararDados(pt, {prices:[en.prices[0]]}).length, 1);
+assert.equal(compararHtml(html(pt), '<p>Sem dados.</p>').diferencas.length, 1);
+assert.throws(() => compararHtml('<script id="payload" type="application/json">inválido</script>', html(en)));
+const raiz = fs.mkdtempSync(path.join(os.tmpdir(), 'coragua-graficos-'));
+try {
+  const escrever = (rota, dados) => {const p = path.join(raiz, rota); fs.mkdirSync(path.dirname(p), {recursive:true}); fs.writeFileSync(p, html(dados));};
+  escrever('estudos/planta/documento/index.html', pt);
+  escrever('en/studies/planta/document/index.html', en);
+  assert.deepEqual(conferirGraficos(raiz), {medidos:['planta'], erros:[]});
+  escrever('en/studies/planta/document/index.html', {prices:[{...en.prices[0], v:1.61}, en.prices[1]]});
+  assert.deepEqual(conferirGraficos(raiz).erros, [{estudo:'planta', caminho:'/prices/0/v', pt:1.348, en:1.61}]);
+} finally { fs.rmSync(raiz, {recursive:true, force:true}); }
+console.log('paridade dos gráficos: 7 plantas, incluindo alteração de um valor num estudo bilingue');
