+    # B2: observações anteriores da mesma série, lidas nos ficheiros alojados.
+    out["anteriores"] = {}
+    for chave, ficheiro, medida, coordenadas, periodo in (
+        ("e2", "gov_10dd_edpt1.json", "e2-saldo", {"freq": "A", "unit": "PC_GDP", "sector": "S13", "na_item": "B9", "geo": "PT"}, "2024"),
+        ("t4b", "earn_gr_gpgr2.json", "t4b-disparidade", {"freq": "A", "unit": "PC", "nace_r2": "B-S_X_O", "geo": "PT"}, "2023"),
+    ):
+        out["anteriores"][chave] = eurostat_series(source / "eurostat" / ficheiro, medida, coordenadas, period=periodo)
+
+    # O gráfico foi conferido na página do PDF: CFP é a série vermelha.
+    # A posição no texto extraído e os dois pontos da série são controlos;
+    # a frase transcrita inclui título, painel Anual, anos e legenda.
+    caminho = source / "text" / "parecer-2026-02-rap26.txt"
+    grafico = caminho.read_text(encoding="utf-8").split("\f")[9].splitlines()
+    if (grafico[10].strip() != "11,9" or grafico[16].strip() != "6,4"
+            or grafico[25].split()[:2] != ["2024", "2025"]
+            or "CFP" not in grafico[26] or grafico[4].strip() != "Anual"):
+        raise Fail("CFP: os pontos, anos ou legenda do painel Anual do gráfico não são os conferidos")
+    out["anteriores"]["e4"] = pdf_sentence(
+        caminho, "e4-despesa-liquida", "crescimento da despesa liquida em 2024",
+        page=10, first=1, last=27,
+        opens_with="Gráfico 2 – Crescimento e desvio da despesa líquida em 2025",
+        closes_with="Desvio CFP POEN-MP (Recomendado)", value=grafico[10].strip())
+
+    out["habitacao"] = {}
+    for geo, periodos in (("PT", ("2025", "2024")), ("EU27_2020", ("2025",))):
+        for periodo in periodos:
+            out["habitacao"][(geo, periodo)] = eurostat_series(
+                source / "eurostat" / f"tessi164_{geo}.json", "sobrecarga-inquilinos",
+                {"freq": "A", "unit": "PC", "tenure": "RENT_MKT", "geo": geo},
+                period=periodo, label_dimensions=("tenure",))
+
     out["niveis"] = ine_niveis_geograficos(source / "ine" / "0012656_meta.json")
     out["titles"] = eurostat_titles(source / "eurostat" / "toc.txt")
     return out
