+#!/usr/bin/env python3
+"""As três respostas do Eurostat que selam pedaços de três perguntas do sítio.
+
+    python3 indicators/out/b2-2026-09-23/perguntas/pedir.py
+
+Escrito a 23.09.2026 pelo construtor da segunda passagem de correção da peça 1
+do B2 do sítio (Claude Opus 5.5), pelo achado 8 da leitura a frio: cada pedaço
+de cada pergunta apoia-se numa origem selada ou num campo selado da linha, e
+onde faltar pede-se a metainformação do indicador pelo cliente da casa e sela-se
+a origem no motor, com o endereço, a hora, o cliente e o sha256.
+
+Os três endereços são, carácter a carácter, o `source_url` das três linhas do
+sítio (a resposta de onde o valor já veio), e o que se lê delas é metainformação
+(a descrição do indicador e as etiquetas das dimensões), nunca um valor. O
+cliente é o da casa (`core.http.HttpClient`, com o nome `CASA_UA`), pela porta
+`condicional()`, que nunca passa por cache. Os bytes escrevem-se tal como
+vieram, e o registo de cada pedido vai para `pedidos.jsonl`.
+"""
+import json
+import sys
+from datetime import datetime, timezone
+from pathlib import Path
+
+AQUI = Path(__file__).resolve().parent
+RAIZ = AQUI.parents[3]
+sys.path.insert(0, str(RAIZ))
+from core.http import CASA_UA, HttpClient  # noqa: E402
+
+BASE = "https://ec.europa.eu/eurostat/api/dissemination/statistics/1.0/data/"
+PEDIDOS = (
+    ("desemprego-de-longa-duracao-2025", "tesem130.json", BASE + "tesem130?format=JSON&lang=EN&geo=PT&sex=T"),
+    ("jovens-nem-2025", "tipslm90.json", BASE + "tipslm90?format=JSON&lang=EN&geo=PT&unit=PC_POP"),
+    ("sobrecarga-do-custo-da-habitacao-2025", "tespm140.json", BASE + "tespm140?format=JSON&lang=EN&geo=PT&sex=T"),
+)
+
+cliente = HttpClient(user_agent=CASA_UA)
+registos = []
+for linha, ficheiro, url in PEDIDOS:
+    quando = datetime.now(timezone.utc).isoformat(timespec="seconds").replace("+00:00", "Z")
+    r = cliente.condicional(url)
+    if r.status != 200 or not r.corpo or r.erro:
+        raise SystemExit(f"{url}: estado {r.status}, erro {r.erro!r}; nada se escreve")
+    (AQUI / ficheiro).write_bytes(r.corpo)
+    registos.append({
+        "linha": linha, "url": url, "url_final": r.url_final, "file": ficheiro,
+        "timestamp_utc": quando, "http": str(r.status), "bytes": len(r.corpo),
+        "user_agent": CASA_UA, "cliente": "core.http.HttpClient.condicional",
+        "sha256": r.sha256,
+    })
+    print(f"{ficheiro}: {r.status}, {len(r.corpo)} bytes, sha256 {r.sha256}")
+(AQUI / "pedidos.jsonl").write_text("".join(json.dumps(x, ensure_ascii=False) + "\n" for x in registos),
+                                     encoding="utf-8")
diff --git a/publisher/dominios_b2_test.py b/publisher/dominios_b2_test.py
