+def associacao_habitacao(principal: str, pt: dict, ue: dict) -> str:
+    """Declara o agregado só depois de comparar as observações lidas da fonte."""
+    quadro_pt, quadro_ue = pt.get("dataset"), ue.get("dataset")
+    if quadro_pt != "TESSI164" or quadro_ue != quadro_pt:
+        raise Fail(f"Associação UE: quadro divergente: PT {quadro_pt!r}, UE {quadro_ue!r}")
+    cpt, cue = pt["coordinates"], ue["coordinates"]
+    for campo, nome in (("tenure", "regime"), ("unit", "unidade"), ("time", "período")):
+        if not cpt.get(campo) or cue.get(campo) != cpt[campo]:
+            raise Fail(f"Associação UE: {nome} divergente: PT {cpt.get(campo)!r}, UE {cue.get(campo)!r}")
+    if cpt.get("geo") != "PT" or cue.get("geo") != "EU27_2020":
+        raise Fail("Associação UE: as geografias têm de ser PT e EU27_2020")
+    if {k: v for k, v in cpt.items() if k != "geo"} != {k: v for k, v in cue.items() if k != "geo"}:
+        raise Fail("Associação UE: há outras coordenadas divergentes além da geografia")
+    if pt["unit_label"] != ue["unit_label"] or pt["period"] != ue["period"]:
+        raise Fail("Associação UE: a unidade ou o período lido diverge das coordenadas")
+    return (f"Agregado da União Europeia (EU27_2020) da medida «{principal}», "
+            "no mesmo quadro, regime de ocupação, unidade e período.")
+
