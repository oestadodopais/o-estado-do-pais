+"""Provas B2: coordenadas, etiqueta do regime e título da fonte, sem rede."""
+from __future__ import annotations
+import copy
+import json
+import tempfile
+from pathlib import Path
+from publisher.dominios_readers import eurostat_series
+from unittest.mock import patch
+from publisher import dominios_build as B
+
+
+def verifica_b2():
+    limpo = B.read_all(B.SOURCE)
+    claims, manifesto, _ = B.build()
+    por_id = {c["id"]: c for c in claims}
+    ids = {
+        "saldo-das-administracoes-publicas-2024": "0.6",
+        "disparidade-salarial-entre-sexos-2023": "8.6",
+        "crescimento-da-despesa-liquida-2024": "11,9",
+        "sobrecarga-do-custo-da-habitacao-inquilinos-mercado-2025": "27.2",
+        "sobrecarga-do-custo-da-habitacao-inquilinos-mercado-2024": "30.3",
+        "sobrecarga-do-custo-da-habitacao-inquilinos-mercado-2025-ue": "18.6",
+    }
+    for chave, valor in ids.items():
+        assert por_id[chave]["value"] == valor, (chave, por_id[chave]["value"])
+        assert next(m for m in manifesto if m["site_id"] == chave)["reference_date"] in ("2023", "2024", "2025")
+    provas = ["B2: as observações novas têm os valores e períodos declarados"]
+    principal = "sobrecarga-do-custo-da-habitacao-inquilinos-mercado-2025"
+    prefixo = f"Agregado da União Europeia (EU27_2020) da medida «{principal}»,"
+    nota = next(m for m in manifesto if m["site_id"] == principal + "-ue")["note_extra"]
+    assert nota.startswith(prefixo), nota
+    assert all("note_extra" not in m for m in manifesto if m["site_id"] != principal + "-ue")
+    provas.append("B2 associação: controlo positivo, declaração inicial só no agregado da medida existente")
+    # Cada planta relê uma cópia explicitamente estragada da resposta alojada.
+    # Não se apresenta a cópia como resposta autêntica, nem se mexe no manifesto
+    # de proveniência. A integração passa pelo mesmo build que escreve a nota.
+    original = json.loads((B.SOURCE / "eurostat/tessi164_EU27_2020.json").read_text())
+    for nome, campo, novo, razao in (
+        ("outro quadro", "dataset", "TESSI165", "quadro divergente"),
+        ("outro regime", "tenure", "OWN_L", "regime divergente"),
+        ("outra unidade", "unit", "PC_POP", "unidade divergente"),
+        ("outro período", "time", "2024", "período divergente"),
+    ):
+        doc = copy.deepcopy(original)
+        pick = {"freq": "A", "unit": "PC", "tenure": "RENT_MKT", "geo": "EU27_2020"}
+        periodo = "2025"
+        if campo == "dataset":
+            doc["extension"]["id"] = novo
+        elif campo == "time":
+            periodo = novo
+        elif campo == "unit":
+            categoria = doc["dimension"]["unit"]["category"]
+            categoria["index"][novo] = categoria["index"].pop("PC")
+            categoria["label"][novo] = categoria["label"].pop("PC")
+            pick[campo] = novo
+        else:
+            pick[campo] = novo
+        with tempfile.TemporaryDirectory() as pasta:
+            resposta = Path(pasta) / "resposta-estragada.json"
+            resposta.write_text(json.dumps(doc, ensure_ascii=False))
+            leitura = eurostat_series(resposta, "sobrecarga-inquilinos", pick,
+                                      period=periodo, label_dimensions=("tenure",))
+        copia = copy.deepcopy(limpo)
+        # Só os metadados da associação vêm desta releitura. O valor e o
+        # excerto de produção ficam intactos, isolando a guarda da associação.
+        for chave in ("dataset", "coordinates", "period", "unit_label"):
+            copia["habitacao"][("EU27_2020", "2025")][1][chave] = leitura[1][chave]
+        with patch.object(B, "read_all", return_value=copia):
+            try:
+                B.build()
+            except B.Fail as e:
+                assert razao in str(e), (nome, str(e))
+                provas.append(f"B2 associação: planta recusada, {nome}: {e}")
+            else:
+                raise AssertionError(f"B2 associação: estrago não visto: {nome}")
+    mutacoes = (
+        ("regime de outra série", "regime de ocupação não é", lambda d: d["habitacao"][("PT", "2025")][1]["dimension_labels"].update(tenure="Owner, with mortgage or loan")),
+        ("excerto sem regime", "falta a etiqueta", lambda d: d["habitacao"][("PT", "2025")][0].update(excerpt=d["habitacao"][("PT", "2025")][0]["excerpt"].replace("Tenure status: Tenant, rent at market price", "Tenant, rent at market price"))),
+        ("título de outro quadro", "título do pedido", lambda d: d["habitacao"][("PT", "2025")][1].update(label="Housing cost overburden rate")),
+        ("bandeira omitida", "precisa de uma declaração", lambda d: d["habitacao"][("PT", "2025")][1].update(flag="p")),
+    )
+    for nome, mensagem, estraga in mutacoes:
+        copia = copy.deepcopy(limpo)
+        estraga(copia)
+        with patch.object(B, "read_all", return_value=copia):
+            try:
+                B.build()
+            except B.Fail as e:
+                assert mensagem in str(e), (nome, str(e))
+            else:
+                raise AssertionError(f"B2: estrago não visto: {nome}")
+        provas.append(f"B2: planta recusada, {nome}")
+    assert B.build()[0] == claims, "B2: os dados limpos mudaram depois das plantas"
+    provas.append("B2: construção limpa igual depois das plantas")
+    return provas
+
+
+if __name__ == "__main__":
+    provas = verifica_b2()
+    for prova in provas:
+        print(prova)
+    print(f"DOMINIOS_B2_TEST: PASS, {len(provas)} conferências")
