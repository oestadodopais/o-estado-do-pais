---
import NomeDaMedida from '../NomeDaMedida.astro';
import Provenance from '../Provenance.astro';
import {getClaim} from '../../lib/ledger.mjs';
import {dataDaCasa} from '../../lib/datas.mjs';
import {t} from '../../i18n/strings.mjs';
import {linguaDaFonte,linguaDoTituloDoDocumento,linguaDaEdicao} from '../../i18n/lingua-dos-titulos.mjs';
const {entrada:e,lang='pt'}=Astro.props,linha=getClaim(e.claim),s=t(lang);
const valor=k=>e.field==='access_date'?dataDaCasa(e[k].valor):e[k].valor;
const lingua=k=>e.field==='source'?linguaDaFonte(e[k].valor,lang):e.field==='document.title'?linguaDoTituloDoDocumento(e[k].valor,lang):e.field==='document.edition'?linguaDaEdicao(e[k].valor,lang):['excerpt','document.locator'].includes(e.field)?linguaDoTituloDoDocumento(linha.document?.title,lang):undefined;
---
<p class="lugar-mudou-o-que">
  <NomeDaMedida linha={linha} lang={lang} escada="semana" />{' '}
  <time datetime={e.data} data-correcao-claim={e.claim} data-correcao-n={String(e.n)} data-correcao-campo="date">{dataDaCasa(e.data)}</time>{' '}
  <span data-correcao-claim={e.claim} data-correcao-n={String(e.n)} data-correcao-campo="field">{s.livro.linha.camposHistorico[e.field]}</span>{' '}
  <s lang={lingua('antes')} data-correcao-claim={e.claim} data-correcao-n={String(e.n)} data-correcao-campo="old_value">{valor('antes')}</s>{' '}
  <span lang={lingua('depois')} data-correcao-claim={e.claim} data-correcao-n={String(e.n)} data-correcao-campo="new_value">{valor('depois')}</span>{' '}
  <code data-correcao-claim={e.claim} data-correcao-n={String(e.n)} data-correcao-campo="id">{e.claim}</code>{' '}
  <Provenance id={e.claim} lang={lang} />
</p>
