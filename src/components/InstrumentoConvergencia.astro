---
/**
 * Instrumento n.º 1 — a régua da convergência, completa.
 *
 * ---------------------------------------------------------------------------
 * O QUE MUDOU COM A EMENDA 21 (27.08.2026)
 * ---------------------------------------------------------------------------
 * «`/regioes` é o índice com a régua da convergência completa: todas as regiões
 * em vigor, o país e a referência (UE-27 = 100), no computador com o eixo e no
 * telemóvel como lista com barras, uma linha por região, o 100 marcado, sem
 * rótulos no eixo.»
 *
 * Três coisas mudam, e as três são a mesma decisão:
 *
 *   1. **A régua vem completa do servidor.** Até aqui o servidor desenhava uma
 *      leitura (Portugal) e o JavaScript acrescentava as outras a pedido. Uma
 *      régua que só está completa com script não é a régua da página das
 *      regiões: a página tem de responder à pergunta sem script nenhum.
 *   2. **Não há região destacada** (Emenda 21c). Saíram as pastilhas de
 *      selecção, o estado «lida», o esbatimento das outras e a barra de
 *      distância da leitura corrente sobre o eixo. Um só estilo de marca, um só
 *      estilo de barra. Na página de uma região, o que a distingue é o
 *      CONTORNO, e só ele.
 *   3. **A barra desceu para a lista.** A gramática da Emenda 4 quer uma barra
 *      por leitura («barra = distância à referência»), e seis barras sobre o
 *      mesmo eixo sobrepõem-se todas, porque todas partem do 100. Cada leitura
 *      passa a ter a sua linha, com a sua barra: no telemóvel é a régua inteira
 *      (o eixo sai, e com ele os rótulos da escala), no computador é a lista das
 *      portas por baixo do eixo. É a mesma lista, e não duas.
 *
 * A GRAMÁTICA DA EMENDA 4, ONDE ELA SE LÊ:
 *   · referência a tinta à altura toda — a linha do 100, no eixo e em cada
 *     linha da lista;
 *   · barra = distância à referência — a barra de cada linha da lista;
 *   · traço fino = valor — a haste no eixo, o traço no fim da barra;
 *   · nenhuma barra sem referência publicada — uma região sem linhas não entra
 *     na lista de `src/lib/regioes.mjs` e por isso não tem linha nem barra.
 *
 * ---------------------------------------------------------------------------
 * AS TRÊS CAMADAS, E A QUE FALTA NO ÍNDICE (IDENTIDADE §4)
 * ---------------------------------------------------------------------------
 * «Todo o instrumento leva as três. … Ou ganha uma leitura breve, ou declara por
 * escrito porque não a tem.» Aqui declara-se o contrário, e por uma razão da
 * constituição:
 *
 *   · com `distinguida` (a página de uma região) o instrumento leva as duas
 *     camadas inteiras: **Relance** é o índice daquela região, sozinho, e
 *     **Leitura breve** é a frase daquela região com os seus selos;
 *   · sem `distinguida` (o índice, `/regioes`) **não há Relance**. Um número
 *     grande no cimo de uma régua completa seria uma das leituras posta acima
 *     das outras, que é exactamente o que a Emenda 21c proíbe. A camada de
 *     leitura breve fica, e é a lista: uma linha por região, com o seu valor,
 *     o seu selo e a sua distância desenhada.
 *
 * ---------------------------------------------------------------------------
 * TODOS OS NÚMEROS SÃO CITAÇÕES
 * ---------------------------------------------------------------------------
 * O valor desenhado, o valor da lista e a distância da frase são `<Claim/>`. Os
 * números do eixo são a régua, não uma medição, e vão marcados como tal. A lista
 * é a legenda de selos do instrumento (`data-legenda-selos`): é lá que o valor
 * desenhado dentro do `<svg>` tem a sua porta, pela convenção do §1.34.
 */
import { getClaim, parsePtNumber } from '../lib/ledger.mjs';
import { ESCALA, GEOMETRIA } from '../data/regioes.mjs';
import { leiturasDaRegua } from '../lib/regioes.mjs';
import { routePath } from '../lib/routes.mjs';
import { t } from '../i18n/strings.mjs';
import Claim from './Claim.astro';
import Provenance from './Provenance.astro';
import Frase from './Frase.astro';

/* `leituraNaCabeca` · a página da região passou a levar a frase da região como
   MANCHETE (01.09.2026), e uma frase dita duas vezes no mesmo ecrã, com o mesmo
   valor e o mesmo selo, é a repetição que a etapa 2i tirou da peça da região
   (achado 6, R4). Quem chama diz onde a frase vive; o índice das regiões, que
   não tem manchete de região, continua a rendê-la aqui. */
const { lang = 'pt', distinguida = null, leituraNaCabeca = false } = Astro.props;
const s = t(lang);

const { min, max, passo, rotuloAte, datum } = ESCALA;
const { largura, altura, esquerda: RL, direita: RR, eixoY: RY, patamares } = GEOMETRIA;

const X = (v) => RL + ((v - min) / (max - min)) * (RR - RL);
/* A escala da linha da lista, no seu próprio referencial de 600 unidades. É a
   MESMA escala do eixo (as mesmas pontas), noutra caixa: uma barra da lista e um
   marcador do eixo dizem a mesma distância. */
const LARGURA_BARRA = 600;
const P = (v) => ((v - min) / (max - min)) * LARGURA_BARRA;

/* --- as leituras, sempre a partir do livro-razão --- */
const leituras = leiturasDaRegua();
const dados = leituras.map((r) => {
  const valor = getClaim(r.valor);
  const distancia = getClaim(r.distancia);
  return {
    id: r.id,
    slug: r.slug,
    referencia: Boolean(r.referencia),
    nome: r.nome[lang],
    sinal: r.sinal,
    valor: parsePtNumber(valor.value),
    valor_claim: r.valor,
    valor_texto: valor.value,
    provisorio: valor.source_flag === 'p',
    distancia_claim: r.distancia,
    distancia_texto: distancia.value,
    frase: r.frase[lang],
    /* A porta de uma linha da lista. A referência não tem página (Portugal não é
       uma região), e a região da própria página não se liga a si mesma. */
    porta:
      r.referencia || r.slug === distinguida
        ? null
        : routePath('regiao', lang, { slug: r.slug }),
  };
});

const aDistinguir = dados.find((d) => d.slug === distinguida) ?? null;

/* --- marcas do eixo --- */
const ticks = [];
for (let v = min; v <= max; v += passo) {
  ticks.push({ v, maior: v % 10 === 0, x: X(v), rotulo: v % 10 === 0 && v <= rotuloAte });
}

/* ---------------------------------------------------------------------------
 * A DISTRIBUIÇÃO POR PATAMARES, FEITA NO SERVIDOR
 * ---------------------------------------------------------------------------
 * Era a conta do cliente («construir os rótulos, medi-los, e só depois
 * distribuí-los»), e com a régua completa passa a ser a conta da construção: sem
 * ela, o servidor desenhava seis rótulos uns por cima dos outros e o script
 * arrumava-os depois — a página estaria errada até o script correr.
 *
 * A LARGURA É ESTIMADA AQUI E MEDIDA NO CLIENTE, e é essa a única coisa que o
 * `convergencia.js` ainda faz: a estimativa `nome.length * 6.8` é a mesma que o
 * cliente já usava quando `getComputedTextLength()` falhava, e o script repõe as
 * caixas com as métricas reais do tipo quando ele estiver carregado. A página
 * está correcta sem o script; com ele, os rótulos ficam mais justos.
 *
 * A ordem é a do VALOR, e não a do ficheiro: a arrumação é geométrica, e um
 * empacotador que percorre a régua da esquerda para a direita nunca deixa um
 * rótulo para trás.
 */
const porValor = [...dados].sort((a, b) => a.valor - b.valor);
const fim = [];
const marcas = porValor.map((d) => {
  const w = Math.max(d.nome.length * 6.8, 34) + 18;
  const x = X(d.valor);
  let patamar = 0;
  while (patamar < patamares.length - 1 && fim[patamar] !== undefined && x - w / 2 < fim[patamar]) {
    patamar++;
  }
  fim[patamar] = x + w / 2;
  return { ...d, w, x, y: patamares[patamar] };
});

/* --- a ilha de dados que o cliente lê --- */
const ilha = {
  estrutura_motivo: 'escala-de-instrumento',
  estrutura: { min, max, passo, rotuloAte, datum, largura, altura, RL, RR, RY, patamares },
};
const ilhaJson = JSON.stringify(ilha).replace(/</g, '\\u003c');
---

<div class="instr instr-conv" data-instrumento="convergencia">
  {/* CAMADA 1 — RELANCE. Só na página de uma região: ver a nota da cabeça. */}
  {aDistinguir && (
    <div class="instr-top">
      <p class="layer-tag">{lang === 'pt' ? 'Relance' : 'At a glance'}</p>
      <div class="glance">
        <Claim id={aDistinguir.valor_claim} lang={lang} class="glance-num" as="div" />
        <span><Provenance id={aDistinguir.valor_claim} lang={lang} /></span>
        <div class="glance-meta">
          <div class="glance-name" data-lugar>{aDistinguir.nome}</div>
          <div class="glance-unit">
            <span data-nonledger="escala-de-instrumento">{s.home.instr1.glanceUnidade}</span> ·
            <span data-nonledger="data-de-referencia">{getClaim(aDistinguir.valor_claim).reference_date}</span>
          </div>
        </div>
      </div>
    </div>
  )}

  {/* ----------------------------------------------------------------------
      O EIXO · a forma do computador (Emenda 21a)
      ----------------------------------------------------------------------
      Sai abaixo de 640, e o que fica é a lista: a folha decide, como decide a
      pesquisa da primeira página. Os rótulos da escala são o que não cabe num
      telemóvel — foi a medição de 25.08 (achado B4) que o mostrou —, e a lista
      não os tem por isso mesmo.

      UM SÓ ESTILO DE MARCA. Nenhuma leitura vem acesa, esbatida ou maior;
      `data-contorno` é o único atributo que separa uma marca das outras, e ele
      só existe na página daquela região.
      ---------------------------------------------------------------------- */}
  <div class="svg-scroll conv-eixo">
    <svg
      class="rule-svg"
      viewBox={`0 0 ${largura} ${altura}`}
      role="img"
      aria-labelledby="ruleTitle ruleDesc"
      data-regua
    >
      <title id="ruleTitle" data-nonledger="escala-de-instrumento">{s.home.instr1.svgTitulo}</title>
      <desc id="ruleDesc" data-nonledger="escala-de-instrumento">{s.home.instr1.svgDescricao}</desc>

      <g data-nonledger="escala-de-instrumento">
        <line x1={RL} y1={RY} x2={RR} y2={RY} stroke="var(--axis)" stroke-width="1" />
        {
          ticks.map((tk) => (
            <line
              x1={tk.x}
              y1={RY}
              x2={tk.x}
              y2={RY + (tk.maior ? 8 : 4)}
              stroke="var(--axis)"
              stroke-width="1"
            />
          ))
        }
        {
          ticks
            .filter((tk) => tk.rotulo)
            .map((tk) => (
              <text
                x={tk.x}
                y={RY + 24}
                text-anchor="middle"
                class:list={['tk', tk.v === datum && 'tk-datum']}
              >
                {tk.v}
              </text>
            ))
        }
        {/* A REFERÊNCIA A TINTA, À ALTURA TODA (Emenda 4). */}
        <line x1={X(datum)} y1="42" x2={X(datum)} y2={RY + 8} stroke="var(--ink)" stroke-width="1.5" />
        <text x={X(datum)} y="30" text-anchor="middle" class="datum-label">
          {lang === 'pt' ? 'UE-27 = 100' : 'EU-27 = 100'}
        </text>
      </g>

      {/* As hastes vivem na sua própria camada, por baixo de todos os rótulos. */}
      <g data-stems>
        {
          marcas.map((m) => (
            <line
              data-stem={m.id}
              x1={m.x}
              y1={RY - 6}
              x2={m.x}
              y2={m.y + 4}
              stroke="var(--ink)"
              stroke-width="1.5"
            />
          ))
        }
      </g>

      <g data-marks>
        {
          marcas.map((m) => (
            <g class="mk" data-mk={m.id} data-contorno={m.slug === distinguida ? 'sim' : undefined}>
              <rect
                class="mk-chapa"
                x={m.x - m.w / 2}
                y={m.y - 37}
                width={m.w}
                height="41"
                fill="var(--paper)"
              />
              {/* O nome sobe seis unidades (2g, ponto 4): medidas as caixas dos
                  rótulos a 320 e a 390, o nome e o valor cruzavam-se com 18
                  unidades de patamar e ficam a 2,5px com 24. */}
              <text x={m.x} y={m.y - 24} text-anchor="middle" class="mk-name">{m.nome}</text>
              <Claim
                id={m.valor_claim}
                lang={lang}
                as="text"
                class="mk-val"
                x={m.x}
                y={m.y - 1}
                text-anchor="middle"
              />
              <circle cx={m.x} cy={RY} r="5" fill="var(--ink)" stroke="var(--paper)" stroke-width="1.5" />
            </g>
          ))
        }
      </g>
    </svg>
  </div>

  {/* ----------------------------------------------------------------------
      A LISTA · a forma do telemóvel, e as portas do computador
      ----------------------------------------------------------------------
      Uma linha por leitura (IDENTIDADE §11, móvel: «uma coisa por linha»), e em
      cada linha o nome, o valor e o selo num só grupo visível, «para que a porta
      nunca se separe do número que abre». A barra é a régua da Emenda 4 àquela
      escala: a calha, a referência a tinta à altura toda no 100, a barra da
      distância e o traço fino do valor. Sem rótulos no eixo: o 100 marca-se com
      a linha e diz-se uma vez, em cima.

      É ESTA A LEGENDA DE SELOS DO INSTRUMENTO (`data-legenda-selos`). O valor de
      cada leitura está desenhado dentro do `<svg>` do eixo, e um `<a>` dentro de
      um desenho não é uma porta que se veja: a porta daquele valor é o selo
      desta linha, pela convenção do §1.34. Nenhuma entrada está escondida.
      ---------------------------------------------------------------------- */}
  <div class="conv-lista-caixa">
    <p class="layer-tag">{lang === 'pt' ? 'Leitura breve' : 'Brief reading'}</p>
    {aDistinguir && !leituraNaCabeca && (
      <p class="brief-text">
        <Frase partes={aDistinguir.frase} lang={lang} selos={true} />
      </p>
    )}
    <p class="conv-lista-ref">
      <span data-nonledger="escala-de-instrumento">{lang === 'pt' ? 'UE-27 = 100' : 'EU-27 = 100'}</span>
    </p>
    <ul class="conv-lista" data-legenda-selos data-conv-lista>
      {
        dados.map((d) => (
          <li
            class="conv-linha"
            data-conv-linha={d.id}
            data-contorno={d.slug === distinguida ? 'sim' : undefined}
          >
            <span class="conv-cabeca">
              <span class="conv-nome">
                {d.porta ? <a href={d.porta}>{d.nome}</a> : <span data-lugar>{d.nome}</span>}
              </span>
              <span class="conv-valor">
                <Claim id={d.valor_claim} lang={lang} chip={true} />
              </span>
            </span>
            <svg
              class="conv-barra"
              viewBox={`0 0 ${LARGURA_BARRA} 24`}
              preserveAspectRatio="none"
              aria-hidden="true"
            >
              <line class="conv-calha" x1="0" y1="12" x2={LARGURA_BARRA} y2="12" />
              <rect
                class="conv-b"
                x={Math.min(P(datum), P(d.valor))}
                y="8"
                width={Math.max(Math.abs(P(d.valor) - P(datum)), 1)}
                height="8"
              />
              <line class="conv-ref" x1={P(datum)} y1="0" x2={P(datum)} y2="24" />
              <line class="conv-v" x1={P(d.valor)} y1="2" x2={P(d.valor)} y2="22" />
            </svg>
          </li>
        ))
      }
    </ul>
  </div>

  <p class="conv-significado">{s.home.instr1.significadoV}</p>

  <script type="application/json" data-ledger-json data-dados="convergencia" set:html={ilhaJson} />
</div>

<script src="/js/convergencia.js" defer is:inline></script>
