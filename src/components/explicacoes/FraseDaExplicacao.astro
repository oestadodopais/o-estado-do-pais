---
/**
 * UMA FRASE DE UMA EXPLICAÇÃO (bloco EX1, 05.10.2026).
 *
 * Rende a lista plana de pedaços que `explicacaoResolvida()` devolve (`src/lib/explicacoes.mjs`), e mais
 * nada: as palavras como texto, cada valor pelo `<Claim>` com o selo ao lado (com `selos`, que é o caso de
 * todos os parágrafos: onde aparece um valor, aparece o selo, `IDENTIDADE.md` §5.3), cada período pela
 * `<DataDaLinha>`, que o `check:formas` reconfere contra o campo da linha, e cada nome declarado de uma
 * função ou de um ministério num `<span data-explicacao-nome>`, que a célula da explicação compara com o nome
 * do projeto da linha. Nenhum pedaço de texto traz um algarismo: o resolvedor recusa-o antes de chegar aqui.
 */
import Claim from '../Claim.astro';
import Provenance from '../Provenance.astro';
import CampoDaLinha from '../CampoDaLinha.astro';
import { getClaim } from '../../lib/ledger.mjs';
import { routePath } from '../../lib/routes.mjs';
import DataDaLinha from '../DataDaLinha.astro';

const { partes, lang = 'pt', selos = true, recibos = false } = Astro.props;
// O fecho pertence à citação; a porta para a prova vem depois dele.
const renderizadas = partes.map((/** @type {any} */ p, /** @type {number} */ i) => {
  if (!recibos || !selos) return p;
  if (p?.literal?.campo === 'excerpt' && typeof partes[i + 1] === 'string' && partes[i + 1].startsWith('»')) return {...p, fecho: '»'};
  if (typeof p === 'string' && p.startsWith('»') && partes[i - 1]?.literal?.campo === 'excerpt') return p.slice(1);
  return p;
});
---

{
  renderizadas.map((/** @type {any} */ p) => {
    if (typeof p === 'string') return <Fragment set:text={p} />;
    if (p.selo && p.texto) return <a class="discussao-periodo" data-discussao-recibo={p.selo} href={routePath('linha', lang, {slug:p.selo})}>{p.texto}</a>;
    if (p.selo) return selos && <Provenance id={p.selo} lang={lang} inline={true} />;
    if (p.literal) {
      const l = p.literal;
      if (l.fragmento) return <Fragment><span class="discussao-literal" data-discussao-fragmento={l.campo}><span data-linha-claim={l.id} data-linha-campo={l.campo} data-linha-trecho={l.texto} lang={l.lingua}>{l.texto}</span>{l.sufixo}</span>{p.fecho}{recibos && selos && <Provenance id={l.id} lang={lang} />}</Fragment>;

      return <Fragment><a class="discussao-literal" href={l.campo === 'excerpt' ? getClaim(l.id).source_url : routePath('linha', lang, {slug:l.id})} data-discussao-literal={l.campo}><CampoDaLinha id={l.id} campo={l.campo} valor={l.texto} lang={lang} lingua={l.lingua} /></a>{p.fecho}{recibos && selos && l.campo === 'excerpt' && <Provenance id={l.id} lang={lang} />}</Fragment>;
    }
    if (p.verbatim) return <span data-verbatim={p.verbatim} set:text={p.texto} />;
    if (p.termo) return <span lang={p.lingua} set:text={p.termo} />;
    if (p.claim) return <Claim id={p.claim} lang={lang} chip={selos} sufixo={p.sufixo ?? ''} />;
    if (p.data) return recibos && selos ? <a class="discussao-periodo" data-discussao-periodo={p.data.id} href={routePath('linha', lang, {slug:p.data.id})}><DataDaLinha id={p.data.id} campo={p.data.campo} valor={p.data.valor} lang={lang} /></a> : <DataDaLinha id={p.data.id} campo={p.data.campo} valor={p.data.valor} lang={lang} />;
    return <span class="explicacao-nome" data-explicacao-nome={p.nome.id} set:text={p.nome.texto} />;
  })
}
