---
import FraseDaExplicacao from './FraseDaExplicacao.astro';
import PortasDaDiscussao from '../discussao/PortasDaDiscussao.astro';
import TituloDeTrabalho from '../TituloDeTrabalho.astro';
import BarrasDoLivro from '../formas/BarrasDoLivro.astro';
import { t } from '../../i18n/strings.mjs';
const { e, lang = 'pt', nivel = 2, portas = true } = Astro.props;
const slug = e.slug, s = t(lang), Titulo = nivel === 3 ? 'h3' : 'h2';
---
    {e.abertura.map((p) => (
      <p class="explicacao-p explicacao-abertura" data-explicacao-paragrafo={p.caminho} data-explicacao-declarado><FraseDaExplicacao partes={p.pedacos} lang={lang} /></p>
    ))}
    {e.seccoes.map((sec) => (
      <section class="explicacao-secao" data-explicacao-secao={sec.id} aria-labelledby={`explicacao-${sec.id}`}>
        <Titulo class="explicacao-secao-titulo" id={`explicacao-${sec.id}`} data-explicacao-declarado><FraseDaExplicacao partes={sec.tituloPedacos} lang={lang} selos={false} /></Titulo>
        {sec.blocos.map((b) => b.tipo === 'figura'
          ? <BarrasDoLivro modelo={b.modelo} lang={lang} explicacao={slug} />
          : <p class="explicacao-p" data-explicacao-paragrafo={b.caminho} data-explicacao-declarado><FraseDaExplicacao partes={b.pedacos} lang={lang} /></p>)}
        {portas && <PortasDaDiscussao lang={lang} linhas={sec.blocos.flatMap(b => b.tipo === 'figura' ? [] : b.pedacos.flatMap(p => typeof p === 'string' ? [] : 'claim' in p ? [p.claim] : 'data' in p ? [p.data.id] : 'literal' in p ? [p.literal.id] : []))} tematica={slug === 'dinheiro-do-estado-2026' && sec.id === 'por-funcao'} />}
      </section>
    ))}
    {e.naoDiz.length > 0 && (
      <section class="explicacao-secao explicacao-nao-diz" data-explicacao-secao="o-que-nao-diz" aria-labelledby="explicacao-o-que-nao-diz">
        <Titulo class="explicacao-secao-titulo" id="explicacao-o-que-nao-diz" data-explicacao-declarado>{s.explicacoes.oQueIstoNaoDiz}</Titulo>
        {e.naoDiz.map((p) => (
          <p class="explicacao-p" data-explicacao-paragrafo={p.caminho} data-explicacao-declarado><FraseDaExplicacao partes={p.pedacos} lang={lang} /></p>
        ))}
      </section>
    )}
    {/* AS PORTAS DO FIM (EX1-b, 06.10.2026): as que a explicação declara, pela ordem dela, na sua página própria; os números e as fontes, e,
        nesta, a página do tema «Estado e economia» (a decisão do lugar de direção sobre a I212). */}
    {portas && <p class="regra-portas explicacao-portas" data-explicacao-portas>
      {e.portas.map((p, i) => <>{i > 0 && ' '}<a href={p.href} data-explicacao-porta-do-fim={p.entrada ?? p.rota}>{p.partes ? <FraseDaExplicacao partes={p.partes} lang={lang} selos={false} /> : p.rota === 'estudo' ? <TituloDeTrabalho titulo={p.texto} lang={lang} /> : p.texto} →</a></>)}
    </p>}
