---
/** N1: os mapas, as tabelas e a ausência municipal deixam a página do domínio. */
import Claim from './Claim.astro';
import Frase from './Frase.astro';
import { LEITURAS_DAS_MEDIDAS } from '../data/leituras-das-medidas.mjs';
import { MEDIDAS_DO_CONCELHO } from '../data/concelhos.mjs';
import { unidadeDaLinha } from '../i18n/unidades.mjs';
import CartaoDasCamaras from './CartaoDasCamaras.astro';
import { ENTRADAS } from '../data/primeira-pagina.mjs';
import MapaPorConcelho from './formas/MapaPorConcelho.astro';
import GeometriaDosConcelhos from './formas/GeometriaDosConcelhos.astro';
import { medidaPelaChave, AUSENCIAS_DO_DOMINIO_1 } from '../data/dominios.mjs';
import { mapaPorConcelho, linhasPorConcelho } from '../lib/dominios.mjs';
import { periodoDasCamaras } from '../lib/prova.mjs';
import { getClaim, parsePtNumber } from '../lib/ledger.mjs';
import { routePath } from '../lib/routes.mjs';
import { t } from '../i18n/strings.mjs';
import '../styles/dominio.css';
import '../styles/cartao-medida.css';
import '../styles/pais.css';
const { lang = 'pt' } = Astro.props;
const s = t(lang);
const limite = medidaPelaChave('E5');
const ganho = medidaPelaChave('T3');
const corte = parsePtNumber(getClaim(limite.claim).value);
if (corte === null) throw new Error('O limite legal tem de ser um número.');
const cortes = [1200, 1400, 1600, 1800];
const marca = (n) => ({ nl: String(n), motivo: 'escala-de-instrumento' });
const rotulosGanho = [
  [s.dominios.mapaMenosDe, marca(cortes[0])],
  ...cortes.slice(0, -1).map((c, i) => [marca(`${c}${s.dominios.mapaA}${cortes[i + 1]}`)]),
  [marca(cortes.at(-1)), s.dominios.mapaOuMais],
];
const mapas = [
  { chave: 'indice', medida: limite, mapa: mapaPorConcelho(linhasPorConcelho('indice'), [corte], { igualdadeDentro: true }), paleta: 'limiar', rotulos: [[s.estado.lei.dentro], [s.estado.lei.fora]] },
  { chave: 'ganho', medida: ganho, mapa: mapaPorConcelho(linhasPorConcelho('ganho'), cortes), paleta: 'escala', rotulos: rotulosGanho },
];
/* N1d: o período é comum às linhas efetivamente desenhadas, não ao limite legal.
   A definição do ganho já está declarada; só se resolve o seu período municipal. */
const contextos = Object.fromEntries(mapas.map(({ chave, medida, mapa }) => {
  const linhas = mapa.unidades.flatMap((u) => u.concelhos).filter((c) => c.id).map((c) => getClaim(c.id));
  /* Évora é derivada e não repete a data: o resolvedor existente lê as origens. */
  const dataComum = chave === 'indice' ? periodoDasCamaras() : { id: linhas[0]?.id, periodo: linhas[0]?.reference_date };
  if (!linhas.length || (chave === 'ganho' && (linhas.some((l) => !l.reference_date) || new Set(linhas.map((l) => l.reference_date)).size !== 1))) throw new Error(`O mapa ${chave} não tem um período comum nas suas linhas.`);
  const periodo = { data: { id: dataComum.id, campo: 'reference_date', valor: dataComum.periodo } };
  const nacional = chave === 'ganho' ? getClaim(medida.claim) : null;
  if (nacional && (nacional.reference_date !== linhas[0].reference_date || linhas.some((l) => l.unit !== nacional.unit))) throw new Error('O ganho de Portugal não tem o período e a unidade das linhas municipais.');
  const definicao = chave === 'ganho'
    ? LEITURAS_DAS_MEDIDAS[medida.claim][lang].map((p) => {
        if (typeof p === 'string') return p;
        if (p.periodo === 'proprio') return periodo;
        throw new Error('A definição do ganho ganhou um pedaço que o contexto municipal não resolve.');
      })
    : [lang === 'pt' ? 'Em ' : 'In ', periodo, '. ', ...MEDIDAS_DO_CONCELHO.find((m) => m.chave === chave).nota[lang]];
  return [chave, { definicao, nacional, unidade: nacional && unidadeDaLinha(nacional.unit, lang).texto }];
}));
const entrada = ENTRADAS.find((e) => e.id === 'lugares');
---
<section class="lugar-sec" data-comparacoes-concelhos aria-labelledby="comparacoes-concelhos-k">
  <h2 class="eyebrow" id="comparacoes-concelhos-k" data-lugares-seccao>{entrada.seccoes[3].nome[lang]}</h2>
  <CartaoDasCamaras lang={lang} />
  <GeometriaDosConcelhos mapa={mapas[0].mapa} />
  {mapas.map(({ chave, medida, mapa, paleta, rotulos }) => (
    <article class="dominio-medida" id={`m-${medida.chave.toLowerCase()}`} data-medida={medida.chave} data-leitura-linha={medida.claim}>
      <h3 class="dominio-pergunta" id={`k-${medida.chave.toLowerCase()}`}>{medida.pergunta[lang]}</h3>
      <p class="dominio-contexto" data-contexto-municipal={chave}>
        <span data-definicao-municipal><Frase partes={contextos[chave].definicao} lang={lang} /></span>
        {contextos[chave].nacional && <span data-referencia-portugal>{' Portugal: '}<Claim id={contextos[chave].nacional.id} lang={lang} chip sufixo={`\u00a0${contextos[chave].unidade}`} />.</span>}
      </p>
      {/* P4-d (02.10.2026): o mapa da dívida diz, na legenda e no cabeçalho da tabela, a unidade da casa e o teto do
          cartão do índice de dívida, lidos da declaração da medida e da linha do limite. O mapa dos ganhos não declara
          unidade da casa, e continua com a unidade das suas linhas. */}
      <MapaPorConcelho s={s} lang={lang} mapa={mapa} paleta={paleta} rotulos={rotulos} rota={(slug) => routePath('municipio', lang, { slug })} nomeada={`k-${medida.chave.toLowerCase()}`} chave={chave} unidadeDaCasa={MEDIDAS_DO_CONCELHO.find((m) => m.chave === chave)?.unidadeDaCasa ?? null} tecto={MEDIDAS_DO_CONCELHO.find((m) => m.chave === chave)?.tecto ?? null} />
    </article>
  ))}
  {AUSENCIAS_DO_DOMINIO_1.map((a) => (
    <article class="dominio-medida dominio-ausente" id={`m-${a.chave.toLowerCase()}`} data-ausencia={a.chave}>
      <h3 class="dominio-pergunta">{a.pergunta[lang]}</h3>
      <p class="dominio-sem-numero">{s.dominios.ausenciaResposta}</p>
      <p class="dominio-fonte"><span class="dominio-data-k">{s.dominios.ausenciaProcurado}</span>{' '}<span>{a.procurado[lang]}</span><span data-nonledger="identificador-tecnico">{a.codigo}</span></p>
      <p class="dominio-razao">{a.razao[lang]}</p>
    </article>
  ))}
</section>

<style>
  .dominio-contexto { max-width: 65ch; margin: 0 0 1.5rem; line-height: 1.6; }
</style>
