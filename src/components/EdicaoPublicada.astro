---
import { primeiraEdicao, dataAtualizacaoDaEdicao } from '../lib/edicoes.mjs';
import { documentosDoEstudo } from '../lib/documentos.mjs';
import { dataPublicacao } from '../lib/publicacao.mjs';
import { dataDaCasa } from '../lib/datas.mjs';
import { ROTULOS_B1 } from '../data/rotulos-b1.mjs';
const { work, lang } = Astro.props;
const principal = work.editions.find(e => e.lang === lang) ?? work.editions[0];
const documento = documentosDoEstudo(work.slug).find(d => d.lang === principal.lang);
const primeira = primeiraEdicao(work.slug, principal.lang);
const data = dataPublicacao(work, principal);
const atualizada = dataAtualizacaoDaEdicao(work.slug, principal.lang, data);
const rotulos = ROTULOS_B1[lang];
if (!documento) throw new Error(`Edição sem documento ou data: ${work.slug}/${principal.lang}`);
---
<p class="estudo-publicado" data-estudo-edicao={`${work.slug}/${principal.lang}`}>
  {atualizada && primeira && <><a data-voz href={primeira.rota} hreflang={principal.lang === 'pt' ? 'pt-PT' : 'en'}>{rotulos.primeiraEdicao}</a>{' · '}</>}
  <a data-voz={atualizada ? true : undefined} href={documento.rota} hreflang={principal.lang === 'pt' ? 'pt-PT' : 'en'}>{atualizada ? rotulos.edicaoAtual : data ? rotulos.edicao : rotulos.edicaoPreparacao}</a>
  {data && <><span aria-hidden="true"> · </span><span data-voz>{rotulos.publicado}</span>{' '}
  <time datetime={data} data-nonledger="data-do-repositorio">{dataDaCasa(data)}</time></>}
  {atualizada && <><span aria-hidden="true"> · </span><span data-voz>{rotulos.atualizado}</span>{' '}
  <time datetime={atualizada} data-estudo-atualizacao data-nonledger="data-editorial" data-data-origem="edicoes.data">{dataDaCasa(atualizada)}</time></>}
</p>
