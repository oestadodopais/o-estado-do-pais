---
import '../../styles/discussao.css';
import { DISCUSSAO } from '../../data/discussao.mjs';
import { itensSobreLinhas, portaDoItem } from '../../lib/discussao.mjs';
interface Props { linhas?: string[]; lang?: 'pt' | 'en'; tematica?: boolean; }
const { linhas = [], lang = 'pt', tematica = false } = Astro.props;
const itens = itensSobreLinhas(linhas, lang, tematica);
---
{itens.map(e => <p class="regra-portas discussao-porta" data-discussao-integracao={e.slug} data-discussao-condicao={tematica ? 'tematica' : 'linhas'}><a href={portaDoItem(e.slug, lang)} data-voz>{DISCUSSAO.porta[lang]} <span>{e.tituloTexto}</span></a></p>)}
