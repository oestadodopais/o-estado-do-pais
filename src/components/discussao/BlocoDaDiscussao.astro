---
import FraseDaExplicacao from '../explicacoes/FraseDaExplicacao.astro';
import { DISCUSSAO } from '../../data/discussao.mjs';
import { itensResolvidos, portaDoItem } from '../../lib/discussao.mjs';
import { primeirasFrases } from '../../lib/estudos-b1.mjs';
import { dataDaCasa } from '../../lib/datas.mjs';
import { routePath } from '../../lib/routes.mjs';
interface Props { lang?: 'pt' | 'en'; }
const { lang = 'pt' } = Astro.props;
---
<section class="pp-discussao" data-discussao-inicio aria-labelledby="discussao-inicio">
  <h2 class="pp-sec-k" id="discussao-inicio"><a href={routePath('discussao', lang)} data-voz>{DISCUSSAO.titulo[lang]} →</a></h2>
  <ul class="discussao-sumario">{itensResolvidos(lang).map(e => {
    const conclusao = e.abertura[0];
    if (!conclusao || !e.escrita) throw new Error(`FP2: abertura ou escrita ausente em ${e.slug}`);
    return <li>
      <a href={portaDoItem(e.slug, lang)} data-discussao-porta={e.slug}><FraseDaExplicacao partes={e.titulo} lang={lang} selos={false} /></a>
      <p data-discussao-resumo><time datetime={e.escrita} data-nonledger="data-editorial" data-data-origem="escrita.declarada">{dataDaCasa(e.escrita)}</time>{' · '}<span data-discussao-conclusao><FraseDaExplicacao partes={primeirasFrases(conclusao.pedacos, 1)} lang={lang} selos={false} /></span></p>
    </li>;
  })}</ul>
</section>
