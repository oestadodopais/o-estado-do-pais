---
import ListaDeDossies from '../dossies/ListaDeDossies.astro';
import { listagensDoInicio } from '../../lib/listagens-do-inicio.mjs';
import FraseDaExplicacao from '../explicacoes/FraseDaExplicacao.astro';
import { DISCUSSAO } from '../../data/discussao.mjs';
import { itensResolvidos, portaDoItem } from '../../lib/discussao.mjs';
import { primeirasFrases } from '../../lib/estudos-b1.mjs';
import { dataDaCasa } from '../../lib/datas.mjs';
import { routePath } from '../../lib/routes.mjs';
interface Props { lang?: 'pt' | 'en'; itens?: ReturnType<typeof itensResolvidos>; dossie?: boolean; entradasDoInicio?: any[]; }
const { lang = 'pt', itens = itensResolvidos(lang), dossie = false, entradasDoInicio = listagensDoInicio(lang).discussao } = Astro.props;
const entradas = dossie ? itens.map(item=>({item,grupo:null})) : entradasDoInicio.map(e=>({item:e.tipo==='dossie'?null:e.peca,grupo:e.tipo==='dossie'?e.dossie:null}));
---
{entradas.length > 0 && <section class="pp-discussao" data-discussao-inicio={dossie ? undefined : true} data-dossie-discussao={dossie || undefined} aria-labelledby="discussao-inicio">
  <h2 class="pp-sec-k" id="discussao-inicio">{dossie ? DISCUSSAO.titulo[lang] : <a href={routePath('discussao', lang)} data-voz>{DISCUSSAO.titulo[lang]} →</a>}</h2>
  <ul class="discussao-sumario">{entradas.map(({item:e, grupo:d}) => {
    if (d) return <li data-discussao-dossie={d.slug}><ListaDeDossies lang={lang} entradas={[d]} /></li>;
    if (!e) return null;
    const conclusao = e.abertura[0];
    if (!conclusao || !e.escrita) throw new Error(`FP2: abertura ou escrita ausente em ${e.slug}`);
    return <li data-dossie-peca={dossie ? `discussao:${e.slug}` : undefined} data-discussao-integracao={dossie ? e.slug : undefined} data-discussao-condicao={dossie ? 'pertenca-ao-dossie' : undefined}>
      <a href={portaDoItem(e.slug, lang)} data-discussao-porta={e.slug}><FraseDaExplicacao partes={e.titulo} lang={lang} selos={false} /></a>
      <p class={dossie ? "explicacao-p" : undefined} data-discussao-resumo><time datetime={e.escrita} data-nonledger="data-editorial" data-data-origem="escrita.declarada">{dataDaCasa(e.escrita)}</time>{' · '}<span data-discussao-conclusao><FraseDaExplicacao partes={primeirasFrases(conclusao.pedacos, 1)} lang={lang} selos={dossie} /></span></p>
    </li>;
  })}</ul>
</section>}
