---
/**
 * Uma frase feita de pedaços. Nenhum pedaço de texto pode trazer um número:
 * se trouxer, o portão de HTML apanha-o.
 *
 *   'palavras'                    — texto corrido
 *   { claim: 'id' }               — um número, citado do livro-razão. Com a
 *                                   propriedade `selos`, sai com o selo ao lado.
 *   { claim: 'id', sufixo: '%' }  — o mesmo, com o símbolo da unidade colado
 *                                   ao valor e antes do selo (§11).
 *   { ref: '2024' }               — ano ou período de referência dos dados
 *   { nl: '100', motivo: '…' }    — outro contexto estrutural declarado
 *   { forte: '…' }                — negrito
 *   { email: '…' }                — endereço de correio, como ligação mailto.
 *                                   Abre o programa de correio de quem lê, e o
 *                                   endereço fica também à vista para se poder
 *                                   copiar: nem toda a gente tem um programa
 *                                   de correio configurado, e um botão que não
 *                                   faz nada é pior do que texto.
 *   { marcador: '…', gloss: '…' } — marcador por resolver, em chip visível.
 *                                   O marcador fica sempre em português, como
 *                                   na origem; na edição inglesa leva glosa.
 */
import Claim from './Claim.astro';
import { routePath } from '../lib/routes.mjs';

/**
 * `selos` — todo o `{ claim: … }` desta frase sai com o seu selo ao lado.
 *
 * IDENTIDADE §5.3: «onde aparece um valor, aparece o selo. Sem excepção de
 * página.» Uma frase corrida com quatro medições precisa de quatro portas, não
 * de uma no fim do parágrafo. Fica opcional porque as páginas anteriores a
 * 15.08.2026 não o fazem e não se reescrevem aqui; tudo o que este bloco
 * constrói passa `selos`.
 */
const { partes, lang = 'pt', selos = false } = Astro.props;
---

{
  partes.map((parte) => {
    if (typeof parte === 'string') return <Fragment set:text={parte} />;
    if (parte.claim)
      return <Claim id={parte.claim} lang={lang} chip={selos} sufixo={parte.sufixo ?? ''} />;
    if (parte.ref) return <span data-nonledger="data-de-referencia">{parte.ref}</span>;
    if (parte.forte) return <strong set:text={parte.forte} />;
    if (parte.email)
      return (
        <a class="ligacao-email" href={`mailto:${parte.email}`}>
          {parte.email}
        </a>
      );
    if (parte.marcador)
      return (
        <>
          {/* B5: o marcador leva a porta da sua página, e o texto e a classe
              não mudam (`IDENTIDADE.md` §6). */}
          <a class="marcador" href={routePath('marcador', lang)} lang="pt-PT">[{parte.marcador}]</a>
          {lang !== 'pt' && parte.gloss && (
            <span class="marcador-gloss"> ({parte.gloss})</span>
          )}
        </>
      );
    return <span data-nonledger={parte.motivo}>{parte.nl}</span>;
  })
}
