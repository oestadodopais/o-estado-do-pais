---
import TextoDoNome from '../TextoDoNome.astro';
import CampoDaLinha from '../CampoDaLinha.astro';
import Provenance from '../Provenance.astro';
import { getClaim } from '../../lib/ledger.mjs';
import { dataDaCasa } from '../../lib/datas.mjs';
import { textoDocumentalConferido } from '../../lib/prova-efeitos.mjs';
import { textoDaHabitacao } from '../../lib/historia-do-valor.mjs';
import { KIND_LABELS } from '../../data/correcoes.mjs';
import { unidadeDaLinha } from '../../i18n/unidades.mjs';
import { linguaDoRotuloDaFonte, linguaDoTituloDoDocumento } from '../../i18n/lingua-dos-titulos.mjs';
import { t } from '../../i18n/strings.mjs';
const { e, lang = 'pt' } = Astro.props;
const s = t(lang);
const rotulo = (kind) => KIND_LABELS[kind]?.[lang] ?? kind;
const linguaDaCorrecaoTextual = (id) => {
  const linha = getClaim(id);
  return ((linha.afirmacao === true && linha.unit === 'afirmação') || textoDocumentalConferido(linha) || textoDaHabitacao(linha)) ? linguaDoTituloDoDocumento(linha.document?.title, lang) : undefined;
};

---
<li class="registo-mudanca" data-mudanca="correcao" data-correcao-entrada={e.claim}>
  <time class="log-data" datetime={e.data} data-correcao-claim={e.claim} data-correcao-n={String(e.n)} data-correcao-campo="date">{dataDaCasa(e.data)}</time>
  <a class="registo-lugar" href={e.lugar.rota}>{e.lugar.nome}</a>

  <div class="registo-mudanca-corpo">
    
    <p class="registo-mudanca-o-que">
      {e.nome?.fonte && (
        <span class="registo-mudanca-nome" data-nome={e.nome.fonte} data-de-linha={e.claim} data-de-familia={e.nome.fonte === 'familia' ? e.nome.familia : undefined}>
          <TextoDoNome id={e.claim} texto={e.nome.texto} lang={lang} />
        </span>
      )}
      
      {e.nome?.campo && (
        <CampoDaLinha
          id={e.claim}
          campo={e.nome.campo}
          valor={e.nome.texto}
          lang={lang}
          class="registo-mudanca-nome"
          lingua={e.nome.campo === 'name'
            ? linguaDoRotuloDaFonte(e.nome.texto, lang)
            : linguaDoTituloDoDocumento(e.nome.texto, lang)}
        />
      )}
      <span class="registo-mudanca-par">
        <s
          lang={linguaDaCorrecaoTextual(e.claim)}
          data-correcao-claim={e.claim}
          data-correcao-n={String(e.n)}
          data-correcao-campo="old_value"
        >
          {e.antes}
        </s>
        {' → '}
        <span
          lang={linguaDaCorrecaoTextual(e.claim)}
          data-correcao-claim={e.claim}
          data-correcao-n={String(e.n)}
          data-correcao-campo="new_value"
        >
          {e.depois}
        </span>
        {' '}
        {e.unidade && (
          <CampoDaLinha
            id={e.claim}
            campo="unit"
            valor={unidadeDaLinha(e.unidade, lang).texto}
            lang={lang}
            lingua={unidadeDaLinha(e.unidade, lang).lingua}
          />
        )}
        
        <Provenance id={e.claim} lang={lang} />
      </span>
    </p>
    <p
      class="log-motivo"
      data-correcao-claim={e.claim}
      data-correcao-n={String(e.n)}
      data-correcao-campo="reason"
    >
      {e.motivo}
    </p>
    <p class="log-afirmacao">
      <span
        class="etiqueta-kind etiqueta-correcao"
        data-correcao-claim={e.claim}
        data-correcao-n={String(e.n)}
        data-correcao-campo="kind"
      >
        {rotulo(e.kind)}
      </span>
      {' '}
      {s.correcoes.colunaAfirmacao}:{' '}
      <code
        data-correcao-claim={e.claim}
        data-correcao-n={String(e.n)}
        data-correcao-campo="id"
      >
        {e.claim}
      </code>
    </p>
  </div>

</li>
