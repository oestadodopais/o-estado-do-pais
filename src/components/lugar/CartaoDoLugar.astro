---
/**
 * ---------------------------------------------------------------------------
 * O CARTÃO DE UMA MEDIDA DE UM LUGAR (B1, peça 2, 21.09.2026)
 * ---------------------------------------------------------------------------
 * A ANATOMIA É A DO CARTÃO DO P2, e não muda: o nome, o valor com a unidade e o
 * período numa linha, a régua, uma frase do que a medida mede, e uma marca da
 * fonte. As mesmas cinco classes (`cartao-medida-nome`, `-valor`, `-frase`,
 * `-regua`), a mesma folha, a mesma régua a medi-lo (`tests/cartao/cartao.mjs`).
 *
 * O QUE MUDA É DE ONDE VEM O QUE SE MOSTRA. As oito medidas de um concelho têm
 * nome, unidade, período e nota DECLARADOS em `src/data/concelhos.mjs`, escritos
 * uma vez para os 308; `CartaoDaMedida.astro` compõe os seus das vinte e uma
 * figuras dos painéis europeus, que declaram outra coisa noutro sítio. Duas
 * origens, a mesma anatomia.
 *
 * UMA FRASE DE DEFINIÇÃO SÓ. A nota de uma medida é o que ela mede; onde a nota
 * tem duas frases, o cartão leva a primeira (a dívida total declara, a seguir à
 * definição, o que a coluna exclui, e isso é ressalva de recibo).
 *
 * O VALOR QUE A FONTE NÃO PUBLICOU. Onde o valor da linha é uma marca da fonte
 * («N.d.»), o cartão escreve no lugar dele o que a marca quer dizer, em
 * português corrente, e o selo ao lado continua a abrir a linha onde a marca
 * está transcrita. Não há `data-claim` nenhum: o que está ali não é o valor.
 *
 * A AUSÊNCIA NÃO SE ESCREVE. Sem régua, o cartão não diz «sem valor de
 * referência»: não se diz o que não há.
 */
import Claim from '../Claim.astro';
import CampoDaLinha from '../CampoDaLinha.astro';
import Provenance from '../Provenance.astro';
import Frase from '../Frase.astro';
import { unidadeDaLinha } from '../../i18n/unidades.mjs';
import { marcaDoValor, provenienciaIncompleta } from '../../lib/ledger.mjs';
import { atrasoDaLinha } from '../../lib/frescura.mjs';
import { dataDaCasa } from '../../lib/datas.mjs';

const { tile, lang = 'pt', s } = Astro.props;

const marca = marcaDoValor(tile.linha?.value);
/* A UNIDADE É A DA LINHA, TAL COMO A LINHA A ESCREVE (achado D2 da leitura do
   lugar de direção, 21.09.2026). O cartão do índice de dívida dizia
   «Percentagem», e a linha escreve «% (limite legal = 150)»: sem a escala,
   «105,5 · Percentagem · dentro do limite legal» lê-se como uma contradição a
   quem espera o limite nos 100, e «419,5 · fora do limite legal» não diz fora de
   quê. O texto vem de `unidadeDaLinha()`, que é o dicionário das unidades que o
   `check:lingua` confere, e entra por `CampoDaLinha`, que o compara carácter a
   carácter com o campo `unit` daquela linha. Não é uma segunda marca da fonte: é
   o mesmo número da mesma linha, dito na unidade dela. */
const unidade = unidadeDaLinha(tile.linha?.unit ?? '', lang);

/** A primeira frase de uma nota declarada. Uma nota é uma lista de pedaços. */
function primeiraFrase(partes) {
  if (!Array.isArray(partes)) return null;
  const saida = [];
  for (const parte of partes) {
    if (typeof parte !== 'string') {
      saida.push(parte);
      continue;
    }
    const fim = parte.match(/[.!?](?=\s|$)/);
    if (fim) {
      saida.push(parte.slice(0, /** @type {number} */ (fim.index) + 1));
      return saida;
    }
    saida.push(parte);
  }
  return saida.length ? saida : null;
}

const frase = tile.derivada ? null : primeiraFrase(tile.nota?.[lang] ?? null);
/* A RÉGUA É A PALAVRA DO ESTADO, e só existe onde há teto publicado e valor
   para comparar: é a do índice de dívida contra o limite legal, e quem a
   calcula é `pecasDoConcelho()`, com a linha do teto. */
const palavra =
  tile.estado === 'dentro' ? s.estado.lei.dentro : tile.estado === 'fora' ? s.estado.lei.fora : null;
/* A FONTE JÁ PUBLICOU UM PERÍODO MAIS RECENTE (bloco R1, 23.09.2026, I146). O
   recibo de Mourão diz «Último período publicado pela fonte: 2026-07; nesta
   linha: 2025-12», e o cartão mostrava «dezembro de 2025» sem dizer que havia
   dados mais novos. O cartão passa a dizê-lo ao pé do período, numa frase curta,
   com a data em que isso se leu. A série e o período da fonte são os de
   `src/data/frescura.mjs`, pela mesma conta que o recibo faz
   (`atrasoDaLinha()`); a frase só se rende quando o período da fonte é mais
   recente do que o da linha, e o `check:formas` (F17) confere as duas coisas.
   Nenhum valor muda. */
const atraso = tile.linha ? atrasoDaLinha(tile.linha) : null;
const maisRecente = Boolean(atraso && tile.linha?.reference_date && atraso.periodoDaFonte > tile.linha.reference_date);
const periodoDaFonte = (() => {
  if (!maisRecente || !atraso) return null;
  const [ano, mes] = atraso.periodoDaFonte.split('-');
  const nome = s.cartao.meses[Number(mes) - 1];
  return lang === 'pt' ? `${nome} de ${ano}` : `${nome} ${ano}`;
})();
---

<article
  class="cartao-medida"
  data-cartao-medida={tile.claim}
  data-medida-chave={tile.chave}
  data-estado={provenienciaIncompleta(tile.linha) ? 'por-confirmar' : 'completa'}
>
  <span class="cartao-medida-nome" data-nome="concelho" data-de-linha={tile.claim}>
    {tile.nome[lang] ?? tile.nome.pt}
  </span>

  <p class="cartao-medida-valor">
    <span class="cartao-medida-quantidade">
    {
      marca ? (
        <span class="cartao-medida-marca">{s.municipio.semValorPublicado}</span>
      ) : (
        <Claim id={tile.claim} lang={lang} as="span" class="cartao-medida-num" />
      )
    }
    <CampoDaLinha
      id={tile.claim}
      campo="unit"
      valor={unidade.texto}
      lang={lang}
      class="cartao-medida-unidade"
      lingua={unidade.lingua}
    />
    </span>
    <span class="cartao-medida-periodo">
      {' · '}
      <Frase partes={tile.periodo[lang]} lang={lang} />
      {atraso && periodoDaFonte && (
        <span class="cartao-medida-frescura" data-frescura={atraso.id}>
          {' ('}<span data-voz>{s.cartao.fonteJaPublicou}</span>{' '}
          <span data-nonledger="periodo-da-fonte" data-de-serie={atraso.id}>{periodoDaFonte}</span>
          {'; '}<span data-voz>{s.cartao.lidoA}</span>{' '}
          <span data-nonledger="data-da-conferencia" data-de-serie-lida={atraso.id}>{dataDaCasa(atraso.origem.lidoEm)}</span>{')'}
        </span>
      )}
    </span>
    <Provenance id={tile.claim} lang={lang} />
  </p>

  {
    palavra && (
      <p class="cartao-medida-regua">
        <span class="cartao-medida-regua-item">
          <span data-voz>{palavra}</span>
        </span>
      </p>
    )
  }
  {frase && <p class="cartao-medida-frase"><Frase partes={frase} lang={lang} /></p>}
</article>
