---
/**
 * O registo de correções.
 *
 * Dois grupos, não uma lista. A distinção é o ponto:
 *
 *   Correções    — o valor publicado estava errado. É a confissão, e é a razão
 *                  de o registo existir. Vem primeiro, com peso, e é o que a
 *                  contagem conta.
 *   Atualizações — o valor estava certo e deixou de estar. Vem depois, em
 *                  surdina, uma linha cada.
 *
 * As **revisões de proveniência** não são listadas aqui, e é decisão. Uma
 * mudança de endereço não é uma alteração do que foi publicado; são muitas de
 * cada vez (nove no mesmo dia, quando duas fontes mudaram de sítio) e, postas a
 * par das confissões, afogavam-nas — que é a regra em cascata do
 * `ledger/README.md`. Aparecem aqui como CONTAGEM, com o caminho para as linhas
 * que as trazem, e por extenso na história de cada uma dessas linhas.
 *
 * Nada aqui é escrito à mão: as entradas vêm do campo corrections das próprias
 * afirmações, e cada pedaço renderizado — data, natureza, valor antigo, valor
 * novo, motivo e id — é conferido pelo portão contra o livro-razão. Nem o
 * conteúdo nem a classificação podem ser reescritos em silêncio.
 *
 * O motivo é o único pedaço que muda de língua: `reason` na edição portuguesa,
 * `reason_en` na inglesa. A escolha é feita em motivoDaEntrada(), e o portão
 * confere, em cada edição, o motivo da língua daquela edição.
 */
import { entradasDoRegisto, motivoDaEntrada } from '../lib/ledger.mjs';
import { KIND_LABELS } from '../data/correcoes.mjs';
import { caminhoDaLinha } from '../lib/livro.mjs';
import Claim from './Claim.astro';
import { t } from '../i18n/strings.mjs';

const { lang = 'pt' } = Astro.props;
const s = t(lang);

const correcoes = entradasDoRegisto('correcao');
const actualizacoes = entradasDoRegisto('actualizacao');
/* As revisões de proveniência entram como contagem e como caminho, não como
   lista: ver o cabeçalho deste ficheiro. */
const revisoes = entradasDoRegisto('proveniencia');
/* Uma entrada por linha, a primeira de cada — a lista é a contagem, e cada
   item é a porta para a história completa daquela linha. O id vai marcado
   como campo de uma entrada do registo (data-correcao-*), que é a única
   origem que o portão aceita para uma cadeia com algarismos fora do
   livro-razão — e ele confere-a contra a própria afirmação. */
const primeiraPorLinha = [];
for (const e of revisoes) {
  if (!primeiraPorLinha.some((x) => x.claimId === e.claimId)) primeiraPorLinha.push(e);
}
primeiraPorLinha.sort((a, b) => a.claimId.localeCompare(b.claimId));

const rotulo = (kind) => KIND_LABELS[kind]?.[lang] ?? kind;

// Concordância: «1 correção publicada», «2 correções publicadas». O número em
// si vem do livro-razão; só a palavra que o acompanha é escolhida aqui.
const palavraConta = correcoes.length === 1 ? s.metodo.registoContaSing : s.metodo.registoConta;
---

<div class="registo">
  <!-- ============================ CORREÇÕES -->
  <section class="registo-grupo registo-grupo-correcoes" aria-labelledby="registo-correcoes">
    <div class="registo-cabeca">
      <h3 class="registo-titulo" id="registo-correcoes">{s.metodo.registoCorrecoesK}</h3>
      <p class="registo-conta">
        <Claim id="correcoes-publicadas" lang={lang} chip={true} /> {palavraConta}
      </p>
    </div>
    <p class="registo-nota">{s.metodo.registoCorrecoesNota}</p>

    {
      correcoes.length === 0 ? (
        <p class="log-vazio-v">{s.metodo.correcoesVazioV}</p>
      ) : (
        <div class="registo-lista">
          <div class="log-cabecalho">
            <span>{s.metodo.colunaData}</span>
            <span>{s.metodo.colunaAntigo}</span>
            <span>{s.metodo.colunaNovo}</span>
            <span>{s.metodo.colunaMotivo}</span>
          </div>
          {correcoes.map((e) => (
            <div class="log-linha">
              <span
                class="log-data"
                data-correcao-claim={e.claimId}
                data-correcao-n={String(e.n)}
                data-correcao-campo="date"
              >
                {e.date}
              </span>
              <span
                class="log-valor log-valor-antigo"
                data-correcao-claim={e.claimId}
                data-correcao-n={String(e.n)}
                data-correcao-campo="old_value"
              >
                {e.old_value}
              </span>
              <span
                class="log-valor"
                data-correcao-claim={e.claimId}
                data-correcao-n={String(e.n)}
                data-correcao-campo="new_value"
              >
                {e.new_value}
              </span>
              <div>
                <p
                  class="log-motivo"
                  data-correcao-claim={e.claimId}
                  data-correcao-n={String(e.n)}
                  data-correcao-campo="reason"
                >
                  {motivoDaEntrada(e, lang)}
                </p>
                <p class="log-afirmacao">
                  <span
                    class="etiqueta-kind etiqueta-correcao"
                    data-correcao-claim={e.claimId}
                    data-correcao-n={String(e.n)}
                    data-correcao-campo="kind"
                  >
                    {rotulo(e.kind)}
                  </span>
                  {' '}
                  {s.metodo.colunaAfirmacao}:{' '}
                  <code
                    data-correcao-claim={e.claimId}
                    data-correcao-n={String(e.n)}
                    data-correcao-campo="id"
                  >
                    {e.claimId}
                  </code>
                </p>
              </div>
            </div>
          ))}
        </div>
      )
    }
  </section>

  <!-- ============================ ATUALIZAÇÕES -->
  {
    actualizacoes.length > 0 && (
      <section class="registo-grupo registo-grupo-actualizacoes" aria-labelledby="registo-actualizacoes">
        <h3 class="registo-titulo registo-titulo-quieto" id="registo-actualizacoes">
          {s.metodo.registoActualizacoesK}
        </h3>
        <p class="registo-nota registo-nota-quieta">{s.metodo.registoActualizacoesNota}</p>

        <ul class="registo-linhas">
          {actualizacoes.map((e) => (
            <li class="registo-linha">
              <span
                class="log-data"
                data-correcao-claim={e.claimId}
                data-correcao-n={String(e.n)}
                data-correcao-campo="date"
              >
                {e.date}
              </span>
              <span class="registo-salto">
                <span
                  class="log-valor-antigo"
                  data-correcao-claim={e.claimId}
                  data-correcao-n={String(e.n)}
                  data-correcao-campo="old_value"
                >
                  {e.old_value}
                </span>
                <span aria-hidden="true"> → </span>
                <span
                  class="log-valor"
                  data-correcao-claim={e.claimId}
                  data-correcao-n={String(e.n)}
                  data-correcao-campo="new_value"
                >
                  {e.new_value}
                </span>
              </span>
              <span
                class="registo-motivo-curto"
                data-correcao-claim={e.claimId}
                data-correcao-n={String(e.n)}
                data-correcao-campo="reason"
              >
                {motivoDaEntrada(e, lang)}
              </span>
              <code
                class="registo-id"
                data-correcao-claim={e.claimId}
                data-correcao-n={String(e.n)}
                data-correcao-campo="id"
              >
                {e.claimId}
              </code>
              <span
                class="vh"
                data-correcao-claim={e.claimId}
                data-correcao-n={String(e.n)}
                data-correcao-campo="kind"
              >
                {rotulo(e.kind)}
              </span>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <!-- ============================ REVISÕES DE PROVENIÊNCIA -->
  {
    primeiraPorLinha.length > 0 && (
      <section class="registo-grupo" aria-labelledby="registo-proveniencia">
        <div class="registo-cabeca">
          <h3 class="registo-titulo" id="registo-proveniencia">{s.metodo.registoProvenienciaK}</h3>
        </div>
        <p class="registo-nota">{s.metodo.registoProvenienciaNota}</p>
        <ul class="registo-proveniencia-linhas">
          {primeiraPorLinha.map((e) => (
            <li>
              <a href={caminhoDaLinha(e.claimId, lang)}>
                <code
                  data-correcao-claim={e.claimId}
                  data-correcao-n={String(e.n)}
                  data-correcao-campo="id"
                >
                  {e.claimId}
                </code>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</div>
