---
import Frase from './Frase.astro';
const {medidas=[],lang='pt'}=Astro.props;
---
{medidas.length>0 && <div class="estudo-medidas" data-medidas-estudo>
  {medidas.map(m=><p class="estudo-medida" data-medida-estudo={m.claim}><Frase partes={[{claim:m.claim},' '+m.nome[lang][0],...m.nome[lang].slice(1)]} lang={lang} selos /></p>)}
</div>}
<style>
  .estudo-medidas { display: grid; gap: .5rem; margin-block: .75rem; }
  .estudo-medida { margin: 0; font-size: .9rem; line-height: 1.45; }
  /* EVL: reservar a área na linha impede que o nome, ao quebrar, ocupe o
     prolongamento invisível do selo. Vale para todas as medidas e larguras. */
  .estudo-medida :global(a.src-chip) {
    display: inline-flex;
    align-items: center;
    min-width: 44px;
    min-height: 44px;
  }
</style>
