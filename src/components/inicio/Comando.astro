---
/**
 * A LINHA DE COMANDO DA PRIMEIRA PÁGINA — âmbito e densidade.
 *
 * ---------------------------------------------------------------------------
 * SÃO LIGAÇÕES, E NÃO BOTÕES, ATÉ HAVER JAVASCRIPT
 * ---------------------------------------------------------------------------
 * Um botão sem JavaScript é um comando que não atende. Estes quatro comandos
 * saem do servidor como `<a href>` para um destino que existe e que faz sentido
 * sem script nenhum:
 *
 *   País        →  `/`                a própria primeira página, no seu defeito
 *   Concelho    →  `/municipios`      o índice dos 308, com a sua cobertura
 *   Relance     →  `/`                o defeito
 *   Leitura breve → `/?densidade=leitura`
 *
 * Quando o script assume, reescreve o `href` para a forma do estado
 * (`/?ambito=…`), acrescenta `role="button"` e `aria-pressed`, e passa a mudar a
 * página sem a recarregar. Até lá, e para quem nunca tiver script, os quatro
 * levam a alguma parte: é a diferença entre um comando degradado e um comando
 * partido.
 *
 * A densidade é o único dos dois que, sem script, não muda nada à vista: o
 * endereço `?densidade=leitura` é servido pela construção estática como o
 * defeito. A página di-lo, com `densidade.semJs`, em vez de deixar um comando a
 * fingir. Cada medida continua a abrir-se sozinha, porque a peça é um
 * `<details>` nativo.
 *
 * NENHUM ALGARISMO PASSA POR AQUI. Os rótulos são cinco palavras.
 */
const { s, hrefs } = Astro.props;

/* ---------------------------------------------------------------------------
 * UM COMANDO, NAS DUAS LARGURAS, COM DUAS POSIÇÕES (bloco A, itens A2 e A3)
 * ---------------------------------------------------------------------------
 * Eram três posições no computador («País · Região · Município») e dois botões
 * de outra forma e com outros nomes no telemóvel, ao lado do mapa: o mesmo
 * mecanismo com duas caras, e a do telemóvel a esconder que existia um terceiro
 * estado (achado C5 da auditoria de 25.08). Passa a ser este, e só este, nas
 * duas larguras; a folha muda-lhe o lugar na coluna e mais nada.
 *
 * «REGIÃO» SAI POR AGORA, e sai por uma razão de conteúdo e não de desenho: a
 * leitura regional desta página era a régua da convergência, que sai da primeira
 * página até haver a página das regiões (item A3). O estado continua a resolver
 * — `?ambito=regiao:<slug>` é endereço partilhável (Emenda 7) e rende a leitura
 * da região que já existe —, e a posição volta ao comando com essa página.
 *
 * Sem script as duas escolhas continuam a ser ligações para sítios que existem:
 * `/` para o país e `/municipios` para os 308.
 */
const AMBITOS = [
  { chave: 'pais', rotulo: s.ambito.pais, href: hrefs.pais },
  { chave: 'municipio', rotulo: s.ambito.municipio, href: hrefs.municipio },
];
const DENSIDADES = [
  { chave: 'relance', rotulo: s.densidade.relance, href: hrefs.relance },
  { chave: 'leitura', rotulo: s.densidade.leitura, href: hrefs.leitura },
];
---

<div class="cmd" data-comando>
  <div class="cmd-grupo">
    <span class="cmd-k" id="cmd-k-ambito">{s.ambito.rotulo}</span>
    <div class="cmd-segs" role="group" aria-labelledby="cmd-k-ambito" data-grupo="ambito">
      {
        AMBITOS.map((a) => (
          <a
            class="seg"
            href={a.href}
            data-modo={a.chave}
            aria-current={a.chave === 'pais' ? 'true' : undefined}
          >
            {a.rotulo}
          </a>
        ))
      }
    </div>
  </div>

  <div class="cmd-grupo">
    <span class="cmd-k" id="cmd-k-densidade">{s.densidade.rotulo}</span>
    <div class="cmd-segs" role="group" aria-labelledby="cmd-k-densidade" data-grupo="densidade">
      {
        DENSIDADES.map((d) => (
          <a
            class="seg"
            href={d.href}
            data-densidade={d.chave}
            aria-current={d.chave === 'relance' ? 'true' : undefined}
          >
            {d.rotulo}
          </a>
        ))
      }
    </div>
  </div>
</div>

{/* A LINHA «SEM JAVASCRIPT» SAIU (Emenda 15). Dizia «Sem JavaScript, este
    comando não muda a página inteira: cada medida abre-se na sua própria
    linha.» — o sítio a explicar a sua própria mecânica ao leitor. Sem script os
    comandos continuam a ser ligações que funcionam, e cada peça continua a
    abrir-se sozinha: o que a frase descrevia continua verdadeiro e deixa de ser
    dito. */}
