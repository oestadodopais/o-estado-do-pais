---
/**
 * «PARA PERCEBER» (bloco EX1, 05.10.2026, o ponto 4 do mandato), no fim de «O que se passa».
 *
 * Duas portas, pela ordem da declaração (`BLOCO_PARA_PERCEBER`, `src/data/primeira-pagina.mjs`): a explicação mais
 * recente, pelo seu título, com o ano pelo período de uma linha; e a leitura da semana, pela primeira frase dela,
 * com as contagens e as datas marcadas, que o portão de HTML reconta (a frase inteira é a porta, e por isso as
 * contagens não são ligações). Sem explicação nenhuma declarada, a primeira porta não se rende.
 */
import FraseDaExplicacao from '../explicacoes/FraseDaExplicacao.astro';
import FraseDaSemana from '../explicacoes/FraseDaSemana.astro';
import { BLOCO_PARA_PERCEBER } from '../../data/primeira-pagina.mjs';
import { listagensDoInicio } from '../../lib/listagens-do-inicio.mjs';
import ListaDeDossies from '../dossies/ListaDeDossies.astro';
import { leituraDaSemana } from '../../lib/leitura-da-semana.mjs';
import { routePath } from '../../lib/routes.mjs';
import { t } from '../../i18n/strings.mjs';

const { lang = 'pt', entradas = listagensDoInicio(lang).perceber } = Astro.props;
const s = t(lang);
const leitura = leituraDaSemana();
const idDoTitulo = `bloco-${BLOCO_PARA_PERCEBER.id}-t`;
---

{entradas.length > 0 && <section class="pp-para-perceber" data-para-perceber aria-labelledby={idDoTitulo}>
  <h3 class="pp-para-perceber-titulo" id={idDoTitulo}>{s.primeira.paraPerceber}</h3>
  <ul class="pp-para-perceber-portas">
    {entradas.map(entrada => entrada.tipo === 'dossie' ? <li><ListaDeDossies lang={lang} entradas={[entrada.dossie]} /></li> : entrada.tipo === 'explicacao'
      ? (
        <li data-para-perceber-porta="explicacao">
          <a href={routePath('explicacao', lang, { slug: entrada.peca.slug })} data-explicacao-porta={entrada.peca.slug} data-explicacao-declarado><FraseDaExplicacao partes={entrada.peca.titulo} lang={lang} selos={false} /></a>
        </li>
      )
      : (
        <li data-para-perceber-porta="semana" data-semana-frase data-semana-janela={`${leitura.janela.inicio}/${leitura.janela.fim}`} data-semana-declarado>
          <a href={routePath('leituraDaSemana', lang)} data-semana-porta><FraseDaSemana lang={lang} leitura={leitura} /></a>
        </li>
      ))}
  </ul>
</section>}
