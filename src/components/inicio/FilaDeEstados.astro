---
/**
 * A FILA DE ESTADOS — um quadrado por medida do âmbito, agrupados pelo estado.
 *
 * Emenda 1: a cor é estado, e só estado. O quadrado âmbar (com contorno de
 * tinta, porque âmbar sobre papel mede 2,09:1) diz «fora do limiar»; o cobalto
 * cheio diz «dentro do limiar»; o contorno de tinta, vazio, diz «sem limiar».
 * **E cada grupo escreve a sua palavra ao lado**: o estado nunca é dito só pela
 * cor (constituição visual §3), e um leitor sem cor lê a mesma coisa.
 *
 * NÃO HÁ QUINTO ESTADO, E NÃO HÁ QUADRADO PARA «POR LER» (decisão b da direção,
 * 20.08.2026). Um concelho sem página não renderiza fila nenhuma: diz as
 * palavras da cobertura, e mais nada. O quadrado tracejado está tomado pela
 * regra 5 do Método — «falta um campo» — e uma segunda leitura do mesmo desenho
 * seria uma segunda língua.
 *
 * Um estado `null` (a comparação não se pôde fazer) também não desenha nada: a
 * ausência de comparação não é um estado.
 *
 * NENHUM ALGARISMO. A fila conta por quadrados, não por números: quantos são
 * vê-se, e a contagem que a página escreve é a da manchete, que vem da prova.
 */
const { s, estados = [], rotulo = null } = Astro.props;

const ORDEM = ['fora', 'dentro', 'sem'];
const PALAVRA = {
  fora: s.estado.foraDoLimiar,
  dentro: s.estado.dentroDoLimiar,
  sem: s.estado.semLimiar,
};

const grupos = ORDEM.map((estado) => ({
  estado,
  palavra: PALAVRA[estado],
  quantos: estados.filter((e) => e === estado).length,
})).filter((g) => g.quantos > 0);
---

{
  grupos.length > 0 && (
    <div class="fila" role="group" aria-label={rotulo ?? s.inicio.cabeca.estadoRotulo}>
      {grupos.map((g) => (
        <span class="fila-grupo">
          <span class="fila-quadrados" aria-hidden="true">
            {Array.from({ length: g.quantos }).map(() => (
              <span class={`sq sq-${g.estado}`} />
            ))}
          </span>
          <span class={`fila-palavra est-${g.estado}`}>{g.palavra}</span>
        </span>
      ))}
    </div>
  )
}
