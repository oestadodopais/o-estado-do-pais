---
/** N1c: a unidade é da linha; a explicação da base é a que a sua nota cita. */
import Claim from './Claim.astro';
import NomeDaMedida from './NomeDaMedida.astro';
import { getClaim } from '../lib/ledger.mjs';
import { unidadeDaLinha } from '../i18n/unidades.mjs';
const { id, lang = 'pt' } = Astro.props;
const linha = getClaim(id);
const unidade = unidadeDaLinha(linha.unit, lang);
/* A explicação depende desta cadeia inglesa exata, transcrita na nota Eurostat.
   Se a nota mudar, a célula N1c recusa o desaparecimento silencioso da explicação;
   uma nota diferente exige voltar a conferir o que ela permite dizer. */
const explica = linha.note?.includes('when the minimum wage is paid for more than 12 months per year, data have been adjusted to take these payments into account');
---
<p class="entrada-valor-irmao" data-valor-irmao={id}>
  <NomeDaMedida linha={linha} lang={lang} escada="cartao" class="" />{lang === 'pt' ? ', em base de doze meses: ' : ', on a twelve-month basis: '}
  <Claim id={id} lang={lang} chip sufixo={`\u00a0${unidade.texto}`} />
  {explica && <span data-base-doze-meses>{lang === 'pt' ? ' O Eurostat ajusta o valor para contar com esses pagamentos quando o salário mínimo é pago por mais de doze meses por ano.' : ' Eurostat adjusts the value to take those payments into account when the minimum wage is paid for more than twelve months a year.'}</span>}
</p>
<style>
  .entrada-valor-irmao { margin: 0; padding: 0 0 1.5rem; font-size: 1rem; }
</style>
