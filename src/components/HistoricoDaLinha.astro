---
/**
 * As correções e atualizações de UMA linha do livro-razão.
 *
 * O registo do Método mostra as entradas de todas as linhas, agrupadas por
 * natureza (RegistoCorrecoes.astro). Aqui é o contrário: uma linha só, em
 * ordem, com a natureza de cada entrada dita à letra — porque quem chega a esta
 * página chegou por um número, e o que quer saber é a história daquele número.
 *
 * Nada é escrito à mão: cada pedaço leva as marcas data-correcao-* e é
 * conferido pelo portão contra o campo `corrections` da própria afirmação, na
 * língua da edição (§1.17, §2.2). Reescrever a história de uma correção falha
 * a construção.
 */
import { motivoDaEntrada } from '../lib/ledger.mjs';
import { dataDaCasa } from '../lib/datas.mjs';
import { KIND_LABELS } from '../data/correcoes.mjs';
import { t } from '../i18n/strings.mjs';
import { routePath } from '../lib/routes.mjs';
import { linguaDaEdicao, linguaDaFonte, linguaDoTituloDoDocumento } from '../i18n/lingua-dos-titulos.mjs';

const { claim, lang = 'pt' } = Astro.props;
const s = t(lang);

/* Da mais recente à primeira, como no registo do Método. O índice `n` é o da
   posição no livro-razão e não muda com a ordenação: é ele que o portão usa. */
const entradas = (claim.corrections ?? []).map((corr, n) => ({ ...corr, n }))
  .sort((a, b) => String(b.date).localeCompare(String(a.date)));
const grupos = [];
for (const entrada of entradas) {
  const igual = grupos.find(g => g[0].date === entrada.date && g[0].kind === entrada.kind &&
    g[0].reason === entrada.reason && g[0].reason_en === entrada.reason_en);
  if (igual) igual.push(entrada); else grupos.push([entrada]);
}
const linguaDoValor = (e, valor) => e.field === 'source' ? linguaDaFonte(valor, lang)
  : e.field === 'document.title' ? linguaDoTituloDoDocumento(valor, lang)
  : e.field === 'document.edition' ? linguaDaEdicao(valor, lang)
  : ['document.locator', 'excerpt'].includes(e.field) ? linguaDoTituloDoDocumento(claim.document?.title, lang) : undefined;
const valor = (e, k) => e.kind === 'proveniencia' && e.field === 'access_date' ? dataDaCasa(e[k]) : e[k];

const rotulo = (kind) => KIND_LABELS[kind]?.[lang] ?? kind;
---

{
  entradas.length === 0 ? (
    <p class="log-vazio-v">{s.livro.linha.historicoVazio}</p>
  ) : (
    <div class="historico">
      {grupos.map((grupo) => {
        const e = grupo[0];
        const indices = grupo.map(x => x.n).join(' ');
        return <div id={`alteracao-${e.n}`} class:list={['historico-entrada', e.kind === 'correcao' && 'historico-entrada-correcao']}>
          <div class="historico-cabeca">
            <span class="log-data" data-correcao-claim={claim.id} data-correcao-n={String(e.n)} data-correcao-grupo={indices} data-correcao-campo="date">{dataDaCasa(e.date)}</span>
            <span class:list={['etiqueta-kind', e.kind === 'correcao' && 'etiqueta-correcao']} data-correcao-claim={claim.id} data-correcao-n={String(e.n)} data-correcao-grupo={indices} data-correcao-campo="kind">{rotulo(e.kind)}</span>
            {grupo.map((item, i) => <span class="registo-salto" id={i ? `alteracao-${item.n}` : undefined}>
              {item.kind === 'proveniencia' && <><span class="historico-campo" data-correcao-claim={claim.id} data-correcao-n={String(item.n)} data-correcao-campo="field">{s.livro.linha.camposHistorico[item.field]}</span>{': '}</>}
              <span class="log-valor log-valor-antigo" lang={linguaDoValor(item, item.old_value)} data-correcao-claim={claim.id} data-correcao-n={String(item.n)} data-correcao-campo="old_value">{item.kind === 'proveniencia' && ['source','document.title','excerpt'].includes(item.field) ? <q>{valor(item,'old_value')}</q> : valor(item,'old_value')}</span>
              <span aria-hidden="true"> → </span>
              <span class="log-valor" lang={linguaDoValor(item, item.new_value)} data-correcao-claim={claim.id} data-correcao-n={String(item.n)} data-correcao-campo="new_value">{item.kind === 'proveniencia' && ['source','document.title','excerpt'].includes(item.field) ? <q>{valor(item,'new_value')}</q> : valor(item,'new_value')}</span>
            </span>)}
          </div>
          <p class="log-motivo" data-correcao-claim={claim.id} data-correcao-n={String(e.n)} data-correcao-grupo={indices} data-correcao-campo="reason">{motivoDaEntrada(e, lang)}</p>
        </div>;
      })}

    </div>
  )
}

<p class="placeholder-nota">
  {s.livro.linha.historicoNota} <a href={routePath('correcoes', lang)}>{s.livro.linha.historicoNotaPorta} →</a>
</p>
