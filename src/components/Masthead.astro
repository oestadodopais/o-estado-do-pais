---
/** B1, peça 3: cinco destinos numa linha. A língua e as restantes portas
 * ficam no rodapé e no Sobre. O nome é o título da primeira página. */
import { SITE_NAME } from '../../site.config.mjs';
import { routePath, normalizePath } from '../lib/routes.mjs';
import Caminho from './Caminho.astro';
import { t } from '../i18n/strings.mjs';
import { ROTAS_NAV, ETIQUETA_NAV } from '../lib/navegacao.mjs';
const { lang = 'pt', path, compact = false } = Astro.props;
const s = t(lang);
const aqui = normalizePath(path ?? Astro.url.pathname);
const home = routePath('home', lang);
const naHome = normalizePath(home) === aqui;
const NomeTag = naHome ? 'h1' : 'p';
---
<header>
  <nav class="menu-cinco" id="nav-principal" aria-label={s.nav.rotuloPrincipal}>
    {ROTAS_NAV.map(chave => {
      const href = routePath(chave, lang);
      return <a href={href} aria-current={normalizePath(href) === aqui ? 'page' : undefined}>
        {chave === 'home' ? 'Portugal' : s.nav[ETIQUETA_NAV[chave]]}
      </a>;
    })}
  </nav>
  <div class:list={['masthead', compact && 'masthead-compact', naHome && 'masthead-pais']}>
    <NomeTag class="wordmark">{compact ? <a href={home}>{SITE_NAME}</a> : SITE_NAME}</NomeTag>
    <Caminho lang={lang} path={aqui} />
  </div>
</header>
