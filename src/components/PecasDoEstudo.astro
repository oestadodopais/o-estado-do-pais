---
import {apresentarAusencias} from '../lib/ausencias-voz1.mjs';
import Provenance from './Provenance.astro';
const { pecas, lang } = Astro.props;
---
{pecas.map(p => p.selo !== undefined
  ? <Provenance id={p.selo} lang={lang} definicao={false} />
  : <Fragment set:html={apresentarAusencias(p.html, lang)} />)}
