---
/**
 * O invólucro de todas as páginas.
 *
 * Trata do <head> inteiro: canónico no domínio acentuado (em punycode),
 * pares hreflang PT<->EN a partir da tabela de rotas, e o JSON-LD da
 * organização em todas as páginas.
 */
import { jsonLd } from '../lib/jsonld.mjs';
import {
  SITE_NAME,
  SITE_SHORT_NAME,
  SITE_URL,
  PAPEL_CLARO,
  canonicalUrl,
} from '../../site.config.mjs';
import { alternatesFor, normalizePath } from '../lib/routes.mjs';
import { DIMENSOES, cartaoDaPagina, urlDoCartao } from '../lib/cartoes.mjs';
import { t } from '../i18n/strings.mjs';
import Masthead from '../components/Masthead.astro';
import SiteFooter from '../components/SiteFooter.astro';
/* `PortaDeCorreccoes` saiu daqui a 04.09.2026 (bloco F1.7): quem a rende no
   rodapé é o `SiteFooter`, para que ela caia DENTRO do `contentinfo` e não no
   vão entre o `</main>` e o `<footer>`, que não é marco nenhum. */

// A ordem importa: primeiro os tokens, depois a folha que os usa.
import '../styles/tokens.css';
import '../styles/site.css';

const {
  lang = 'pt',
  title,
  description,
  path: pathProp,
  jsonld = null,
  mastheadCompact = true,
  /**
   * A mobília do cabeçalho é o sinal de tempo, e está em TODAS as páginas.
   *
   * Antes estava só na primeira, e o que todas as páginas traziam era a data
   * de edição, no rodapé. Essa saiu (§1.39) e não podia ser substituída lá: o
   * rodapé passou a ser navegação e mais nada. O sinal de tempo sobe para o
   * cabeçalho, que é onde uma publicação diz de quando é, e é uma linha só.
   */
  furniture = true,
  noindex = false,
  /**
   * A porta das correções vive no aparelho de cada tipo de página — na coluna
   * lateral de uma linha, no colofão da primeira página, na coluna do
   * município. Onde esse sítio existe, a página põe-na lá e passa
   * `portaNoRodape={false}`; onde não existe, entra aqui, antes do rodapé.
   *
   * Uma por página, sempre: é o que o portão de HTML conta.
   */
  portaNoRodape = true,
  /**
   * OS PARES DE LÍNGUA, QUANDO A ROTA NÃO EXISTE NAS DUAS.
   *
   * Quase todas as rotas deste sítio existem nas duas edições, e por isso os
   * pares saem da tabela de rotas. A rota `texto` é a primeira que não existe
   * sempre nas duas: só há página de leitura onde há registo de conteúdo, e
   * dos oito registos, seis são portugueses e dois ingleses. Declarar um par
   * hreflang para uma página que não foi construída seria uma porta que não
   * abre, e o portão apanha-o.
   *
   * Quem sabe se a irmã existe é a vista; por isso a vista passa a lista de
   * alternativas, na forma que `alternatesFor()` devolve, e o caminho que o
   * comando de língua deve abrir. Sem estas duas props nada muda.
   */
  alternativas = null,
  caminhoDaOutraLingua = null,
} = Astro.props;

const s = t(lang);
const path = normalizePath(pathProp ?? Astro.url.pathname);
const canonical = canonicalUrl(path);
const alternates = alternativas ?? alternatesFor(path);

const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE_NAME,
  url: SITE_URL,
};

/**
 * ---------------------------------------------------------------------------
 * O CARTÃO DE PARTILHA DESTA PÁGINA (etapa 5)
 * ---------------------------------------------------------------------------
 * NADA disto é escrito à mão, e é a condição da direção: o endereço do cartão
 * sai de `cartaoDaPagina()`, que decide, do CAMINHO desta página e da sua
 * edição, qual é o cartão dela; e as medidas saem de `DIMENSOES`, que é a mesma
 * lista que o passo de construção usa para os desenhar. Uma etiqueta `og:image`
 * com um endereço datilografado seria um endereço que ninguém confere.
 *
 * O portão de HTML relê estas quatro linhas em todas as páginas construídas e
 * exige que nomeiem o cartão da rota certa e da edição certa, que o ficheiro
 * exista em `dist/` e que o resumo dele bata certo com o registo do cartão.
 *
 * Uma rota sem cartão próprio (a fase 1 dá cartão próprio à primeira página e
 * às páginas de linha) leva o cartão da primeira página da sua edição, e o
 * registo desse cartão diz que rotas é que ele cobre. Uma página de linha de um
 * ESTUDO DE DADOS leva o cartão do seu estudo, um por edição, e a razão está
 * medida em DECISIONS §1.68.
 */
const cartao = cartaoDaPagina(path, lang);
const [DIM_OG, DIM_TWITTER] = DIMENSOES;

/**
 * ---------------------------------------------------------------------------
 * O MANIFESTO DESTA EDIÇÃO (28.08.2026, `design/marca/BRIEF-app.md`)
 * ---------------------------------------------------------------------------
 * Cada edição liga o seu, porque o que muda entre eles é o sítio por onde a
 * aplicação abre: a portuguesa em `/`, a inglesa em `/en/`. Um manifesto só,
 * partilhado, punha o leitor inglês na primeira página portuguesa de cada vez
 * que abrisse o ícone que ele próprio instalou.
 *
 * Os ícones são os mesmos nos dois: o sinal é um «e» e não uma palavra.
 */
const manifesto = lang === 'pt' ? '/manifest.webmanifest' : '/en/manifest.webmanifest';
const cartaoOg = urlDoCartao({ ...cartao, ...DIM_OG });
const cartaoTwitter = urlDoCartao({ ...cartao, ...DIM_TWITTER });

---

<!doctype html>
<html lang={s.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />

    {
      /* Páginas sem conteúdo não se oferecem para indexação. O canónico fica:
         o endereço continua a ser o mesmo, só não é convidado ao índice. */
      noindex && <meta name="robots" content="noindex, follow" />
    }
    {
      /* OS DOIS TIPOS DA PRIMEIRA PINTURA (etapa 1b do redesenho v3).
         Só dois: a prosa (Spectral Regular) e o aparelho (Bitter variável).
         Os restantes cinco ficheiros chegam quando a folha os pede, com
         `font-display: swap` a segurar a leitura entretanto. Pré-carregar
         tudo seria disputar a largura de banda da primeira pintura consigo
         própria. `crossorigin` é obrigatório mesmo na mesma origem: sem ele o
         navegador pede o ficheiro duas vezes, porque a pré-carga e o pedido do
         `@font-face` não seriam o mesmo pedido.

         O endereço é, carácter a carácter, o que `tokens.css` escreve, com os
         parênteses retos do nome de montante codificados. */
    }
    <link
      rel="preload"
      href="/tipos/spectral/Spectral-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/tipos/bitter/Bitter%5Bwght%5D.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    {
      /* ------------------------------------------------------------------
         A GUARDA CONTRA O PISCA DO TEMA (Emenda 12, 21.08.2026; §1.52)
         ------------------------------------------------------------------
         Claro por defeito para todos. Quem escolheu escuro tem a escolha
         guardada no aparelho, e esta linha é o que a aplica ANTES da primeira
         pintura: um ficheiro adiado corre depois de a página pintar, e o leitor
         que pediu escuro veria a página clara primeiro e o escuro a seguir.

         É bloqueante e é minúscula de propósito. E é a única coisa que pode
         escrever `data-theme`: compara a chave com UMA cadeia e, quando não bate
         certo, não faz nada — um valor estranho não produz atributo nenhum. O
         `try` existe porque `localStorage` ATIRA, e não devolve nada, quando o
         aparelho o recusa; sem ele, um separador privado partia o `<head>`.

         `set:html` porque o que aqui vai é o corpo do script e não um filho de
         texto qualquer, e `is:inline` porque uma etiqueta que o empacotador
         mova deixa de estar antes da pintura, que é a única coisa que esta
         linha faz.
         ------------------------------------------------------------------ */
    }
    <script
      is:inline
      set:html={`(function(){try{if(localStorage.getItem('tema')==='dark'){document.documentElement.setAttribute('data-theme','dark')}}catch(e){}})()`}
    />

    {
      /* ------------------------------------------------------------------
         O SÍTIO NO ECRÃ PRINCIPAL DO TELEMÓVEL (28.08.2026)
         ------------------------------------------------------------------
         Cinco ligações e duas etiquetas, e nada mais: sem service worker, sem
         cache própria e sem pedido de instalação. O Chrome só mostra o pedido a
         quem tem um `fetch` handler, e não o queremos — quem quiser a aplicação
         usa «adicionar ao ecrã principal», que é o gesto que já existe nos dois
         sistemas. O que estas linhas fazem é dar-lhe um ícone e um nome.

         A ORDEM DOS DOIS `rel="icon"` NÃO É INDIFERENTE, e é a razão de o ICO
         vir primeiro. Um navegador que entenda SVG usa o SVG, porque é o mais
         específico dos dois; um que não entenda cai no ICO, que é a razão de o
         ICO existir. O `sizes="32x32"` no ICO é o que diz ao navegador o que
         está lá dentro sem ele ter de abrir o ficheiro.

         `apple-mobile-web-app-capable` NÃO ENTRA. Está obsoleta desde que o
         WebKit passou a ler o manifesto (iOS 15.4), e o `display: standalone`
         do manifesto faz o mesmo trabalho por escrito.

         O `apple-touch-icon` TEM PRECEDÊNCIA sobre os ícones do manifesto no
         iOS, e é por isso que existe ao lado deles: é um ficheiro opaco de
         180 px, e a opacidade é medida no exportador e outra vez em
         `tests/inicio/app.mjs`, porque o iOS compõe este ficheiro sobre preto.
         ------------------------------------------------------------------ */
    }
    <link rel="manifest" href={manifesto} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {
      /* ------------------------------------------------------------------
         A COR DA MOBÍLIA DO NAVEGADOR É A DO PAPEL DESTA PÁGINA, E É UMA SÓ
         ------------------------------------------------------------------
         O `BRIEF-app.md` §3 pede duas etiquetas `theme-color` com `media`, uma
         por esquema do sistema. **Não é o que este sítio pode dizer com
         verdade**, e a razão está medida e decidida noutro sítio: desde a
         Emenda 12 (21.08.2026, `DECISIONS.md` §1.52) o escuro DEIXOU de vir da
         preferência do sistema e passou a ser um pedido do leitor, guardado no
         aparelho dele. O sítio é claro para toda a gente até alguém carregar no
         botão.

         Uma etiqueta com `media="(prefers-color-scheme: dark)"` diria ao
         navegador para pintar a barra de escuro a um leitor de sistema escuro
         que NUNCA pediu o escuro — e a página dele é de papel claro. Seria uma
         barra escura por cima de uma página clara, ou seja a etiqueta a mentir
         sobre o papel que está por baixo dela.

         Os dois papéis dos tokens estão os dois aqui, e é `public/js/tema.js`
         que troca de um para o outro, porque é ele que sabe o que o leitor
         escolheu. Uma cor no `<head>` e a outra à mão do mecanismo que manda:
         é a mesma divisão de trabalho da guarda contra o pisca.
         ------------------------------------------------------------------ */
    }
    <meta name="theme-color" content={PAPEL_CLARO} />
    <meta name="apple-mobile-web-app-title" content={SITE_SHORT_NAME} />

    <link rel="canonical" href={canonical} />
    {
      alternates?.map((a) => (
        <link rel="alternate" hreflang={a.hreflang} href={canonicalUrl(a.path)} />
      ))
    }

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'pt' ? 'pt_PT' : 'en_GB'} />
    <meta property="og:image" content={cartaoOg} />
    <meta property="og:image:width" content={String(DIM_OG.largura)} />
    <meta property="og:image:height" content={String(DIM_OG.altura)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={cartaoTwitter} />

    <script type="application/ld+json" set:html={jsonLd(organizationJsonLd)} />
    {jsonld && <script type="application/ld+json" set:html={jsonLd(jsonld)} />}
  </head>

  <body>
    <a class="skip" href="#conteudo">{s.nav.saltar}</a>

    <div class="wrap">
      <slot name="masthead">
        <Masthead
          lang={lang}
          path={path}
          compact={mastheadCompact}
          furniture={furniture}
          outraLingua={caminhoDaOutraLingua}
        />
      </slot>

      <main id="conteudo">
        <slot />
      </main>

      {
        /* A PORTA DAS CORREÇÕES PASSA A IR DENTRO DO RODAPÉ (bloco F1.7,
           04.09.2026). Estava aqui, entre o `</main>` e o `<footer>`, isto é,
           dentro de marco nenhum: quem navega uma página por marcos passava por
           cima dela. Medido antes: 739 das 7 237 páginas construídas. A razão
           por extenso está em `SiteFooter.astro`; o que muda aqui é só quem a
           rende. */
      }
      <SiteFooter
        lang={lang}
        path={path}
        outraLingua={caminhoDaOutraLingua}
        porta={portaNoRodape}
      />
    </div>

    {
      /* O CONTROLO DO TEMA, adiado e partilhado por todas as páginas. A guarda
         do `<head>` trata da primeira pintura; este trata do clique e do que se
         guarda. Vem depois do documento porque nada do que ele faz é preciso
         antes de o leitor ver a página. */
    }
    <script src="/js/tema.js" defer is:inline></script>
  </body>
</html>
