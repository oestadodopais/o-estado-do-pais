---
/** B1: uma página por estudo, corpo do registo e edição fixada no fim. */
import Base from '../layouts/Base.astro';
import TituloDeTrabalho from '../components/TituloDeTrabalho.astro';
import PecasDoEstudo from '../components/PecasDoEstudo.astro';
import EdicaoPublicada from '../components/EdicaoPublicada.astro';
import { workById } from '../data/studies.mjs';
import { registoDaEdicao, manifestoDosRegistos } from '../lib/registos.mjs';
import { pecasDoCorpo, linhasDoDocumento, titulosDoDocumento } from '../lib/registo-html.mjs';
import { linhaDoSitioDoEstudo } from '../lib/cruzamento.mjs';
import { getClaim, verificacoesDaLinha, provenienciaIncompleta } from '../lib/ledger.mjs';
import { nomeDaMedida } from '../lib/nomes.mjs';
import { linguaDoRotuloDaFonte, linguaDaFonte } from '../i18n/lingua-dos-titulos.mjs';
import { dataDaCasa } from '../lib/datas.mjs';
import Provenance from '../components/Provenance.astro';
import DefinicaoDoMarcador from '../components/DefinicaoDoMarcador.astro';
import { routePath } from '../lib/routes.mjs';
import { canonicalUrl, SITE_NAME, SITE_URL } from '../../site.config.mjs';
import { FONTE_DIGITAL_GERADA_POR_IA } from '../data/politica-ia.mjs';
import { leituraDe } from '../data/leituras.mjs';
import { t } from '../i18n/strings.mjs';
import { ROTULOS_B1, TITULOS_DA_LEITURA } from '../data/rotulos-b1.mjs';
import '../styles/texto.css';
import '../styles/estudos-b1.css';
const { lang = 'pt', slug } = Astro.props;
const s = t(lang);
const rotulos = ROTULOS_B1[lang];
const work = workById(slug);
if (!work) throw new Error(`Estudo desconhecido: ${slug}`);
const principal = work.editions.find(e => e.lang === lang) ?? work.editions[0];
const registo = registoDaEdicao(slug, lang);
const chave = `${slug}/${lang}`;
const entrada = manifestoDosRegistos().registos[chave];
const linhaDoSitio = entrada ? linhaDoSitioDoEstudo(entrada.rh_study) : () => null;
const path = routePath('estudo', lang, { slug });
const titulos = registo ? titulosDoDocumento(registo) : [];
const seccoes = titulos.filter(t => t.nivel === 2).length;
const linhas = (registo ? linhasDoDocumento(registo, chave, linhaDoSitio) : [])
  .filter(linha => linha.siteId)
  .map(linha => {
    const recibo = getClaim(linha.siteId);
    const verificacao = verificacoesDaLinha(recibo)[0];
    return { ...linha, recibo, verificacao, nome: nomeDaMedida(recibo, lang) };
  })
  .filter(({ recibo, verificacao, nome }) => nome && nome.campo !== 'document.title' && recibo.source && verificacao);
const pecas = registo ? pecasDoCorpo({
  registo, chave, linhaDoSitio,
  rotuloDaPorta: s.estudos.textoPortaDaLinha,
  rotuloDaPosicao: (n, total) => s.estudos.textoPosicaoSeccaoModelo.replace('{n}', String(n)).replace('{total}', String(total)),
  rotuloDoFimDeSeccao: s.estudos.textoSubir,
}) : [];
// Separar apenas os contentores. Cada carácter e cada marca continuam na ordem do registo.
function separar(partes, marca, depois = false) {
  const antes = [], resto = [];
  let passou = false;
  for (const p of partes) {
    const i = p.html?.indexOf(marca) ?? -1;
    if (!passou && i >= 0) {
      const corte = i + (depois ? marca.length : 0);
      if (corte) antes.push({ html: p.html.slice(0, corte) });
      if (corte < p.html.length) resto.push({ html: p.html.slice(corte) });
      passou = true;
    } else (passou ? resto : antes).push(p);
  }
  return [antes, resto];
}
const [titulo, conteudo] = separar(pecas, '</h1>', true);
const titulosDaLeitura = TITULOS_DA_LEITURA[lang];
const principais = titulos.filter(t => t.nivel === 2);
const primeiroConteudo = registo?.blocks.find(b => b.i > 0);
const temAbertura = primeiroConteudo?.kind === 'heading' && Number(primeiroConteudo.level) === 2 && primeiroConteudo.text === titulosDaLeitura[0];
const naLeitura = temAbertura ? principais.filter(t => titulosDaLeitura.includes(t.texto)) : [];
if (temAbertura && (naLeitura.length !== titulosDaLeitura.length ||
    titulosDaLeitura.some((texto, i) => principais[i]?.texto !== texto)))
  throw new Error(`B1 leitura ${chave}: faltam os três títulos na ordem aprovada.`);
const depoisDaLeitura = temAbertura ? principais.find(t => !titulosDaLeitura.includes(t.texto)) : null;
if (temAbertura && !depoisDaLeitura)
  throw new Error(`B1 leitura ${chave}: falta o texto depois da leitura.`);
const [leitura, texto] = depoisDaLeitura
  ? separar(conteudo, `<span id="posicao-bloco-${depoisDaLeitura.i}"`)
  : [[], conteudo];
const arvoreDoIndice = [];
for (const t of titulos) {
  if (t.nivel === 2 || !arvoreDoIndice.length) arvoreDoIndice.push({ ...t, filhos: [] });
  else arvoreDoIndice[arvoreDoIndice.length - 1].filhos.push(t);
}
const jsonld = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: registo?.blocks[0]?.text ?? principal.title,
  inLanguage: lang === 'pt' ? 'pt-PT' : 'en',
  creativeWorkStatus: leituraDe(work.id) ? 'Published' : 'Draft',
  digitalSourceType: FONTE_DIGITAL_GERADA_POR_IA,
  url: canonicalUrl(path),
  isPartOf: { '@type': 'WebSite', name: SITE_NAME, url: SITE_URL },
  publisher: { '@type': 'Organization', name: SITE_NAME, url: SITE_URL },
};
---
<Base lang={lang} path={path} title={`${jsonld.headline} · ${SITE_NAME}`}
  description={work.description[lang]} jsonld={jsonld} noindex={!leituraDe(work.id)}>
  {registo ? (
    <div class="estudo-b1 texto-corpo" style={`--seccoes: ${seccoes}`} data-seccoes={seccoes}>
      <div id="documento" data-registo-edicao={chave}>
        <div class="estudo-b1-titulo"><PecasDoEstudo pecas={titulo} lang={lang} /></div>
    {titulos.length > 0 && (
      <nav class="texto-indice" id="texto-indice" aria-labelledby="texto-indice-k">
        <details class="texto-indice-dobra">
          <summary class="texto-indice-porta">
            <h2 class="texto-indice-k" id="texto-indice-k">{s.leitura.sumarioK}</h2>
          </summary>
          <ul class="texto-indice-lista">
            {arvoreDoIndice.map((titulo) => (
              <li>
                <a href={`#bloco-${titulo.i}`} data-registo-indice={`${chave}#${titulo.i}`}>
                  {titulo.texto}
                </a>
                {titulo.filhos.length > 0 && (
                  <ul class="texto-indice-sublista">
                    {titulo.filhos.map((filho) => (
                      <li>
                        <a href={`#bloco-${filho.i}`} data-registo-indice={`${chave}#${filho.i}`}>
                          {filho.texto}
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            ))}
          </ul>
        </details>
      </nav>
    )}


        {leitura.length > 0 && <article class="texto-artigo estudo-leitura"><PecasDoEstudo pecas={leitura} lang={lang} /></article>}
        <article class="texto-artigo estudo-texto"><PecasDoEstudo pecas={texto} lang={lang} /></article>
      </div>
      {linhas.length > 0 && <details class="texto-dobra" id="linhas-do-documento-dobra">
        <summary class="texto-dobra-porta">
          <span class="texto-dobra-seta" aria-hidden="true"></span>
          <span>{rotulos.fontes} →</span>
        </summary>
        <section id="linhas-do-documento" class="texto-linhas" aria-labelledby="linhas-do-documento-k">
          <h2 id="linhas-do-documento-k" class="texto-linhas-titulo">{rotulos.fontes}</h2>
          <ul class="texto-linhas-lista">
            {linhas.map(({ row, recibo, verificacao, nome }) => (
              <li class="texto-linha" id={`linha-${row}`}>
                <dl class="texto-linha-campos">
                  <dt>{rotulos.valor}</dt>
                  <dd><span class="claim"><span data-registo-linha={`${chave}@${row}.impresso`}>{String(recibo.value).replace(/(?<=\d)[ \u2009\u202F](?=\d)/g, '\u00A0')}</span><Provenance id={recibo.id} lang={lang} definicao={false} /></span>{provenienciaIncompleta(recibo) && <DefinicaoDoMarcador lang={lang} />}</dd>
                  <dt>{rotulos.medida}</dt>
                  <dd lang={nome.campo === 'name' ? linguaDoRotuloDaFonte(nome.texto, lang) : undefined} data-registo-linha={`${chave}@${row}.medida`}>{nome.texto}</dd>
                  <dt>{rotulos.fonte}</dt>
                  <dd lang={linguaDaFonte(recibo.source, lang)} data-registo-linha={`${chave}@${row}.fonte`}><cite>{recibo.source}</cite></dd>
                  <dt>{rotulos.verificacao}</dt>
                  <dd><time datetime={verificacao.date} data-registo-linha={`${chave}@${row}.verificacao`}>{dataDaCasa(verificacao.date)}</time></dd>
                </dl>
              </li>
            ))}
          </ul>
        </section>
      </details>}
      <EdicaoPublicada work={work} lang={lang} />
    </div>
  ) : (
    <div class="estudo-b1">
      <TituloDeTrabalho as="h1" class="estudo-titulo" edicao={principal} lang={lang} />
      <p class="estudo-descricao" data-verbatim={work.verbatimDaAbertura?.[lang]}>{work.description[lang]}</p>
      <EdicaoPublicada work={work} lang={lang} />
    </div>
  )}
</Base>
