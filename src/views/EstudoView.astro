---
/**
 * A página de um estudo.
 *
 * É a página do OBSERVATÓRIO sobre o trabalho — não o trabalho. O trabalho, se
 * já cá estiver, vive em /estudos/<slug>/documento, alojado tal como foi
 * publicado (ver src/lib/documentos.mjs).
 *
 * Esta página diz o que se sabe e nada mais: título, descrições nas duas
 * línguas, tema, edições com as suas datas, o estado da migração, o documento
 * quando existe, e o que há para descarregar — hoje, nada, e di-lo por palavras.
 *
 * O QUE NÃO ESTÁ AQUI, E PORQUÊ: não há resumo, não há versão curta, não há um
 * único número do estudo. Um resumo escrito sem ler o estudo seria conteúdo
 * inventado, que é exactamente aquilo que este sítio existe para não fazer. E
 * os números do estudo só entram quando cada um tiver a sua linha no
 * livro-razão — não antes, e nunca copiados do documento a olho.
 *
 * Enquanto a página do observatório não estiver escrita, a página fica fora do
 * índice (noindex) e o JSON-LD vai marcado como rascunho: o que se diz ao
 * leitor e o que se diz às máquinas é a mesma coisa. Ver DECISIONS §1.8.
 *
 * QUANDO A LEITURA ESTIVER ESCRITA (src/data/leituras.mjs), esta mesma página
 * ganha as três camadas do IDENTIDADE §4 — a medida, a frase, o fundo — e sai
 * do escudo: deixa de levar noindex, entra no sitemap e o JSON-LD deixa de
 * dizer rascunho. Não são três decisões: é uma, lida da mesma lista pelo
 * gabarito, pelo sitemap e pelo portão de HTML. Ver DECISIONS §1.35.
 *
 * A FRASE DA LEITURA É PROSA DA CASA e tem de assentar numa frase impressa no
 * próprio trabalho. A frase de origem de cada uma está registada, com ficheiro
 * e linha, em src/data/leituras.mjs e em DECISIONS §1.35.
 */
import Base from '../layouts/Base.astro';
import { dataDaCasa } from '../lib/datas.mjs';
import { dataDaEdicaoNoRepositorio } from '../lib/datas-do-repositorio.mjs';
import Claim from '../components/Claim.astro';
import Provenance from '../components/Provenance.astro';
import Marcador from '../components/Marcador.astro';
import Frase from '../components/Frase.astro';
import TituloDeTrabalho from '../components/TituloDeTrabalho.astro';
import { workById, POR_VERIFICAR, subjectLabel } from '../data/studies.mjs';
import { leituraDe } from '../data/leituras.mjs';
import { FONTE_DIGITAL_GERADA_POR_IA } from '../data/politica-ia.mjs';
import { municipioPorSlug } from '../data/municipios.mjs';
import { documentosDoEstudo } from '../lib/documentos.mjs';
import { temRegisto } from '../lib/registos.mjs';
import { routePath } from '../lib/routes.mjs';
import { canonicalUrl, SITE_NAME, SITE_URL } from '../../site.config.mjs';
import { t } from '../i18n/strings.mjs';

const { lang = 'pt', slug } = Astro.props;
const s = t(lang);
const work = workById(slug);
if (!work) throw new Error(`estudo desconhecido: "${slug}"`);

const path = routePath('estudo', lang, { slug });
const principal = work.editions.find((e) => e.lang === lang) ?? work.editions[0];

/* O documento existe ou não existe. Não há meio-termo, e a página não finge. */
const documentos = documentosDoEstudo(slug);
const documentoDaqui = documentos.find((d) => d.lang === lang) ?? null;
const migrado = documentos.length > 0;

/**
 * A PORTA DA PÁGINA DE LEITURA, e a ausência dita pela porta que falta.
 *
 * Uma edição com registo de conteúdo tem o documento composto no sítio, em
 * `/estudos/<slug>/texto`; uma sem registo não tem, e a diferença diz-se por
 * ausência e não por uma frase (decisão 9 do diretor de 24.08.2026, e a Emenda
 * 15: «a ausência diz-se em duas palavras, não num parágrafo»). Nenhuma linha
 * desta página explica porque é que umas têm e outras não.
 */
const textoDaqui = temRegisto(slug, lang) ? routePath('texto', lang, { slug }) : null;

/** A ficha de uma edição: a sua página, o seu documento, o seu texto, as datas. */
const edicoes = work.editions.map((e) => ({
  ...e,
  /* A data de publicação é a do repositório: ver `src/lib/datas-do-repositorio.mjs`
     e a razão em `EstudosView.astro`. `date`, do arquivo, deixa de chegar à
     superfície. */
  publicada: dataDaEdicaoNoRepositorio(slug, e.lang),
  paginaDaEdicao: routePath('estudo', e.lang, { slug }),
  documento: documentos.find((d) => d.lang === e.lang) ?? null,
  texto: temRegisto(slug, e.lang) ? routePath('texto', e.lang, { slug }) : null,
}));

const tema = subjectLabel(work.subject, lang);

/* A leitura do observatório sobre este trabalho, se já foi escrita. É a sua
   existência — e nada mais — que decide o estado desta página. */
const leitura = leituraDe(work.id);

/* O tema de um trabalho é o objecto dele. Quando esse objecto é um concelho
   com página própria, a leitura leva de volta a ela: as duas falam dos mesmos
   números, e o leitor não deve ter de adivinhar isso. */
const municipio = work.subject ? municipioPorSlug(work.subject) : null;
const municipioPath = municipio ? routePath('municipio', lang, { slug: municipio.slug }) : null;

/* Três estados, e a página diz sempre em qual está: por migrar, documento
   alojado sem leitura, e leitura publicada. Nenhum finge ser outro.

   O ESTADO É SÓ O ESTADO (subetapa 4e, a regra da direção de 21.08.2026). Com a
   leitura publicada as duas frases que descreviam a própria página já tinham
   saído; agora saem também as dos outros dois estados. A lede repetia em prosa
   o que o rótulo diz em quatro palavras, e a explicação contava a fase seguinte
   do projecto e o cuidado da casa. O rótulo fica, e é a ausência dita em duas
   palavras. */
const estado = leitura ? null : migrado ? s.estudos.migradoEstado : s.estudos.stubEstado;

/* Uma descrição que ainda não existe mostra-se com o marcador único do sítio,
   na sua classe — e não com uma segunda formulação em texto simples, que era o
   que `[descrição em preparação]` fazia (IDENTIDADE §6; BRIEF-confianca §3.5). */
const descricaoPt = work.description.pt;
const descricaoEn = work.description.en;

/**
 * O RÓTULO DA DESCRIÇÃO SAIU (bloco B, item B1; achado C9).
 *
 * Dizia o que a descrição É — «reformulação do título», «frase de abertura do
 * documento», «tradução da casa da frase de abertura» —, e isso é o sítio a
 * descrever a sua própria descrição, que é a classe de frase que a Emenda 18(e)
 * tira da página do leitor: «nada existe para mostrar diligência». O que a
 * afirmação sustentava continua sustentado onde é conferível: uma descrição
 * transcrita leva `data-verbatim`, e o portão compara-a carácter a carácter com
 * `src/data/verbatim.mjs`. O campo `descricaoDoDocumento` do registo dos
 * trabalhos fica, porque é ele que decide se há transcrição para conferir.
 */
const descricaoAqui = work.description[lang];

/* Fica "Draft" enquanto a PÁGINA não tiver conteúdo — mesmo com o documento já
   alojado. O que está por escrever é esta página, e é dela que o JSON-LD fala;
   quando a leitura existir, deixa de ser um rascunho e o JSON-LD diz o mesmo
   que a página e o que o sitemap. */
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: principal.title,
  inLanguage: work.editions.map((e) => (e.lang === 'pt' ? 'pt-PT' : 'en')),
  creativeWorkStatus: leitura ? 'Published' : 'Draft',
  /* A mesma divulgação do rótulo, para máquinas: o termo do vocabulário do
     schema.org que diz a geração por IA, lido na fonte e não inventado (a
     razão inteira está em `src/data/politica-ia.mjs`). */
  digitalSourceType: FONTE_DIGITAL_GERADA_POR_IA,
  url: canonicalUrl(path),
  isPartOf: { '@type': 'WebSite', name: SITE_NAME, url: SITE_URL },
  publisher: { '@type': 'Organization', name: SITE_NAME, url: SITE_URL },
};
---

<Base
  lang={lang}
  path={path}
  title={`${principal.title} · ${SITE_NAME}`}
  description={work.description[lang]}
  jsonld={jsonld}
  noindex={!leitura}
>
  {/* ======================================= o estado da página
      A CAIXA ÀS RISCAS SAIU E AS PALAVRAS FICARAM (`DECISIONS.md` §4, item M).
      O estado editorial de uma página do arquivo dizia-se duas vezes: aqui, no
      antetítulo, e outra vez num tracejado com fundo às riscas por baixo da
      descrição. As riscas são o vocabulário do espécime, e o espécime é para
      uma ausência de DADOS, não para o estado de um texto; e uma coisa dita
      duas vezes na mesma página é dita mal. Fica UMA vez, no antetítulo, que é
      onde o leitor a lê antes do título.

      E COM A LEITURA PUBLICADA NÃO HÁ ESTADO NENHUM. «Leitura publicada» era a
      casa a dizer de si que tinha acabado o trabalho, por cima de uma página
      onde o trabalho está à vista. Os outros dois ficam porque são ausências
      declaradas, que é o que a Emenda 15 manda dizer. */}
  <div style="padding-top:clamp(20px,3vw,34px)">
    {estado && <span class="eyebrow">{estado}</span>}
    <TituloDeTrabalho as="h1" style="margin-top:12px" titulo={principal.title} lang={lang} />
    <p class="lede" style="margin-top:16px">
      {
        descricaoAqui === POR_VERIFICAR ? (
          <Marcador lang={lang} />
        ) : work.verbatimDaAbertura?.[lang] ? (
          <span data-verbatim={work.verbatimDaAbertura[lang]}>{descricaoAqui}</span>
        ) : (
          descricaoAqui
        )
      }
    </p>
  </div>

  {
    /* ========================================================= A LEITURA
       As três camadas do IDENTIDADE §4, abertas aqui e não noutra página:
       Relance (a medida), Leitura breve (a frase), Fundo (método, ressalvas,
       proveniência). Cada valor entra por <Claim/> e leva o seu selo — e os
       selos desta página não são todos iguais: as somas sobre um registo
       público inteiro atravessaram sem frase para transcrever, e o seu selo
       aparece a tracejado. É a mesma distinção do IDENTIDADE §5.2, e a nota
       ao lado di-la por palavras. */
    leitura && (
      <div class="leitura">
        <div class="leitura-topo">
          <p class="layer-tag">{s.estudos.leituraRelanceK}</p>
          <div class="leitura-medidas">
            {leitura.medidas.map((med) => (
              <div class="leitura-medida">
                <Claim id={med.claim} lang={lang} class="leitura-medida-num" as="div" />
                <p class="leitura-medida-nome"><Frase partes={med.nome[lang]} lang={lang} /></p>
                <Provenance id={med.claim} lang={lang} />
              </div>
            ))}
          </div>
          {/* A NOTA DAS MEDIDAS É UMA LISTA DE PARÁGRAFOS, E LEVA SELOS (I75,
              27.08.2026). Era um parágrafo só, sem selos, e por isso um valor do
              livro-razão não podia viver aqui: um número sem o seu selo fecha o
              portão, e com razão. Passa a lista para que a prosa da casa e a
              frase que cita um valor sejam blocos diferentes: a primeira continua
              a ser contada pela régua do inventário e varrida pelo tripwire da
              voz, e a segunda é uma origem declarada, como qualquer frase que
              cita o livro-razão. */}
          {leitura.medidasNota &&
            leitura.medidasNota[lang].map((paragrafo) => (
              <p class="placeholder-nota">
                <Frase partes={paragrafo} lang={lang} selos={true} />
              </p>
            ))}
        </div>

        <div class="leitura-breve">
          {/* O RÓTULO NOMEIA A CAMADA E MAIS NADA (decisão do diretor,
              26.08.2026). Dizia «prosa da casa, assente numa frase do trabalho»,
              que é a página a explicar como o texto foi feito: a Emenda 15 tira
              da página do leitor a frase sobre o método, e a Emenda 18 acrescenta
              que nada existe para mostrar diligência. Que a frase é da casa
              continua conferível onde é prova: cada número dela leva selo, e uma
              descrição transcrita leva `data-verbatim`. */}
          <p class="layer-tag">{s.estudos.leituraBreveK}</p>
          <p class="leitura-frase"><Frase partes={leitura.frase[lang]} lang={lang} selos={true} /></p>
        </div>

      </div>
    )
  }

  <div class="estudo-blocos">
    <!-- ======================================= o documento original -->
    <div class="log-vazio">
      <div class="log-vazio-k">{s.estudos.documentoK}</div>
      {
        migrado ? (
          <>
            {/* A LEITURA NO SÍTIO VEM PRIMEIRO (bloco B, item B2; Codex 10).
                Os dois destinos estavam pela ordem em que foram construídos, e
                o leitor de outra família não soube a diferença entre eles antes
                de abrir os dois: escolheu «Ler o documento» e caiu na edição de
                registo, que abre com o vocabulário da produção. A porta
                principal passa a ser a leitura composta no sítio; a edição
                arquivada vem a seguir, com o rótulo a dizer o que é. */}
            <p class="estudo-accoes">
              {textoDaqui && (
                <a class="ligacao-dados estudo-accao-principal" href={textoDaqui}>
                  {s.estudos.textoLink} →
                </a>
              )}
              {documentoDaqui && (
                <a class="ligacao-dados" href={documentoDaqui.rota}>
                  {s.estudos.documentoLink} →
                </a>
              )}
              {documentos
                .filter((d) => d.lang !== lang)
                .map((d) => (
                  <a class="ligacao-dados" href={d.rota} hreflang={d.lang === 'pt' ? 'pt-PT' : 'en'}>
                    {s.estudos.documentoLink} · <span data-nonledger="identificador-tecnico">{d.lang.toUpperCase()}</span> →
                  </a>
                ))}
            </p>
          </>
        ) : (
          <p class="log-vazio-v">{s.estudos.documentoVazio}</p>
        )
      }
    </div>

    <!-- ======================================= publicado fora daqui -->
    {
      work.artifactUrl && (
        <div class="log-vazio">
          <div class="log-vazio-k">{s.estudos.stubForaK}</div>
          <p class="log-vazio-v">{s.estudos.stubForaV}</p>
          <p>
            <a class="ligacao-externa" href={work.artifactUrl} rel="noopener noreferrer external">
              {s.estudos.stubForaLink} ↗
            </a>
          </p>
        </div>
      )
    }

    <!-- ======================================= o concelho de que trata -->
    {
      municipio && municipioPath && (
        <div class="log-vazio">
          <div class="log-vazio-k">{s.estudos.municipioK}</div>
          <p class="log-vazio-v">{municipio.nome[lang] ?? municipio.nome.pt}</p>
          <p>
            <a class="ligacao-dados" href={municipioPath}>{s.estudos.municipioLink} →</a>
          </p>
        </div>
      )
    }

    <!-- ======================================= as edições -->
    <div class="log-vazio">
      <div class="log-vazio-k">{s.estudos.stubEdicoes}</div>
      {
        edicoes.map((e) => (
          <div class="edicao">
            <div class="edicao-cabeca">
              <span class="badge">{e.lang.toUpperCase()}</span>
              <TituloDeTrabalho class="edicao-titulo" titulo={e.title} lang={lang} />
            </div>
            <div class="edicao-meta">
              {/* Um marcador de incerteza usa sempre a mesma classe: é a única
                  linguagem de incerteza do sítio (IDENTIDADE §6). Aqui era
                  texto simples e passava despercebido. */}
              <span class="edicao-data">
                {/* A preposição fora da marca, a data com a sua origem: ver a
                    razão em `src/lib/datas-do-repositorio.mjs`. */}
                <span data-voz>{s.estudos.dataLabel}</span>{' '}
                {e.publicada ? (
                  <span data-nonledger="data-do-repositorio">{dataDaCasa(e.publicada)}</span>
                ) : (
                  <Marcador lang={lang} />
                )}
              </span>
              <span data-nonledger="data-de-atualizacao">
                {s.estudos.atualizadoLabel}:{' '}
                {e.updated ? dataDaCasa(e.updated) : <Marcador lang={lang} />}
              </span>
              {e.lang !== lang && (
                <a href={e.paginaDaEdicao} hreflang={e.lang === 'pt' ? 'pt-PT' : 'en'}>
                  {s.estudos.edicaoIrma} →
                </a>
              )}
              {/* A MESMA ORDEM DA CABEÇA (bloco B, item B2): a leitura no sítio
                  primeiro, a edição de registo a seguir. */}
              {e.texto && (
                <a href={e.texto} hreflang={e.lang === 'pt' ? 'pt-PT' : 'en'}>
                  {s.estudos.textoLink} →
                </a>
              )}
              {e.documento && (
                <a href={e.documento.rota} hreflang={e.lang === 'pt' ? 'pt-PT' : 'en'}>
                  {s.estudos.documentoLink} →
                </a>
              )}
            </div>
          </div>
        ))
      }
    </div>

    <!-- ======================================= tema e descrições -->
    <div class="log-vazio">
      <div class="log-vazio-k">{s.estudos.temaK}</div>
      <p class="log-vazio-v">{tema ?? s.estudos.temaNenhum}</p>

      <div class="log-vazio-k" style="margin-top:6px">{s.estudos.descricoesK}</div>
      <p class="estudo-descricao" lang="pt-PT">
        <span class="estudo-descricao-lingua">PT</span>{' '}
        {descricaoPt === POR_VERIFICAR ? (
          <Marcador lang={lang} />
        ) : work.verbatimDaAbertura?.pt ? (
          <span data-verbatim={work.verbatimDaAbertura.pt}>{descricaoPt}</span>
        ) : (
          descricaoPt
        )}
      </p>
      <p class="estudo-descricao" lang="en">
        <span class="estudo-descricao-lingua">EN</span>{' '}
        {descricaoEn === POR_VERIFICAR ? (
          <Marcador lang={lang} />
        ) : work.verbatimDaAbertura?.en ? (
          <span data-verbatim={work.verbatimDaAbertura.en}>{descricaoEn}</span>
        ) : (
          descricaoEn
        )}
      </p>
    </div>

    <!-- ======================================= descargas -->
    <div class="log-vazio">
      <div class="log-vazio-k">{s.estudos.descarregarK}</div>
      <p class="log-vazio-v">{s.estudos.descarregarVazio}</p>
    </div>

    <p class="rodape-nav">
      <a href={routePath('estudos', lang)}>{s.estudos.stubVoltar}</a>
    </p>
  </div>
</Base>
