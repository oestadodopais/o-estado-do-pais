---
import PortaDoEstudoEO1 from '../components/PortaDoEstudoEO1.astro';
import Base from '../layouts/Base.astro';
import FraseDaExplicacao from '../components/explicacoes/FraseDaExplicacao.astro';
import Provenance from '../components/Provenance.astro';
import { DISCUSSAO } from '../data/discussao.mjs';
import { itensResolvidos, portaDoItem } from '../lib/discussao.mjs';
import { routePath } from '../lib/routes.mjs';
import { SITE_NAME } from '../../site.config.mjs';
import '../styles/explicacoes.css';
import '../styles/discussao.css';
interface Props { lang?: 'pt' | 'en'; }
const { lang = 'pt' } = Astro.props;
const itens = itensResolvidos(lang);
---
<Base lang={lang} path={routePath('discussao',lang)} title={`${DISCUSSAO.titulo[lang]} · ${SITE_NAME}`} description={DISCUSSAO.ambito[lang]}>
  <div class="discussao">
    <h1 class="explicacao-titulo">{DISCUSSAO.titulo[lang]}</h1>
    <p class="explicacao-p discussao-ambito">{DISCUSSAO.ambito[lang]}</p>
    <ul class="discussao-sumario">{itens.map(e => <li><a href={portaDoItem(e.slug,lang)} data-discussao-porta={e.slug}><FraseDaExplicacao partes={e.titulo} lang={lang} selos={false} /></a></li>)}</ul>
    {itens.map(e => <article class="discussao-item" id={e.slug} data-discussao={e.slug}>
      <div class="discussao-cabecalho" data-discussao-cabecalho>
        <h2 class="discussao-titulo" id={`${e.slug}-titulo`} data-discussao-titulo><FraseDaExplicacao partes={e.titulo} lang={lang} selos={false} /></h2>
        <span class="discussao-selos-do-titulo" data-discussao-selos-do-titulo>{e.titulo.filter(p => typeof p !== 'string' && p.claim).map(p => <Provenance id={p.claim} lang={lang} />)}</span>
      </div>
      {e.abertura.map(p => <p class="explicacao-p discussao-abertura" data-discussao-paragrafo={p.caminho}><FraseDaExplicacao partes={p.pedacos} lang={lang} recibos={true} />{(e.recibos[p.caminho] ?? []).map(id => <Provenance id={id} lang={lang} />)}</p>)}
      {e.seccoes.map(sec => <section class="discussao-seccao" data-discussao-parte={sec.id} aria-labelledby={`${e.slug}-titulo ${e.slug}-${sec.id}`}>
        <h3 class="discussao-rotulo" id={`${e.slug}-${sec.id}`}>{sec.titulo}</h3>
        {sec.blocos.map(b => b.tipo === 'paragrafo' && <p class="explicacao-p" data-discussao-paragrafo={b.caminho}><FraseDaExplicacao partes={b.pedacos} lang={lang} recibos={true} />{(e.recibos[b.caminho] ?? []).map(id => <Provenance id={id} lang={lang} />)}</p>)}
        {e.slug === 'orcamento-2027-generalidade' && sec.id === 'fontes' && <p class="regra-portas discussao-porta"><a data-discussao-saude data-voz href={portaDoItem('saude-no-orcamento',lang)}>{lang === 'pt' ? 'O orçamento da Saúde →' : 'The Health budget →'}</a></p>}
        {e.slug === 'saude-no-orcamento' && sec.id === 'fontes' && <p class="regra-portas discussao-porta"><a data-discussao-explicacao data-voz href={lang === 'pt' ? '/explicacoes/dinheiro-do-estado-2026/' : '/en/explainers/dinheiro-do-estado-2026/'}>{lang === 'pt' ? 'O que é a despesa efetiva consolidada →' : 'What consolidated effective expenditure is →'}</a></p>}
      </section>)}
      {['saude-no-orcamento', 'parcerias-rodoviarias'].includes(e.slug) && <PortaDoEstudoEO1 lang={lang} />}
    </article>)}
  </div>
</Base>

<style>
  /* OG1-B (28.10.2026): a abertura de cada item leva a mesma regra das secções, senão o espaço antes do sufixo («889 milhões de euros») colapsa e o valor cola-se à unidade. */
  .discussao-seccao :global(.claim-sufixo), .discussao-abertura :global(.claim-sufixo) { white-space: pre; }
</style>
