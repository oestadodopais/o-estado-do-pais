---
/**
 * A PRIMEIRA PÁGINA v3. Uma só fonte para as duas edições: recebe `lang` e nada mais.
 *
 * ---------------------------------------------------------------------------
 * O QUE MUDOU, E A REGRA QUE GOVERNA TUDO O QUE SE SEGUE
 * ---------------------------------------------------------------------------
 * A página passou a ter estado: um âmbito (País, uma região, um concelho) e uma
 * densidade (Relance, Leitura breve), codificados no endereço, porque é o
 * endereço que se partilha (Emenda 7). E a regra que isso obriga é a resposta 3
 * da direcção à crítica cruzada:
 *
 *   **O CÓDIGO DE EXECUÇÃO ESCOLHE CADEIAS JÁ VALIDADAS E NUNCA COMPÕE UM
 *   NÚMERO.** Tudo o que a página pode mostrar em qualquer estado saiu deste
 *   ficheiro, foi construído pelo servidor e passou pelo portão de HTML. O
 *   script troca `hidden`, `open`, `aria-pressed` e `aria-current`, e escreve o
 *   `textContent` de dois `<span data-slot>` — o nome e o distrito do concelho
 *   escolhido, copiados do nó daquele concelho na ilha da CAOP que o mapa
 *   desenhou. Não há `innerHTML`, não há cadeia montada, não há aritmética que
 *   produza um algarismo à vista.
 *
 * O que isto custa é peso: nove blocos de cabeça, os 308 resultados da pesquisa
 * e os 308 pontos do mapa saem todos do servidor. O que isto compra é que o
 * portão vê tudo o que o leitor pode ver — que é a única maneira de a promessa
 * do sítio continuar de pé quando a página ganha estado.
 *
 * SEM JAVASCRIPT a página é o âmbito País em Relance, completa e correcta, e os
 * comandos são ligações para sítios que existem: `/` para o país,
 * `/#convergencia` para a leitura regional, `/municipios` para os 308.
 */
import Base from '../layouts/Base.astro';
import Masthead from '../components/Masthead.astro';
import Frase from '../components/Frase.astro';
import InstrumentoConvergencia from '../components/InstrumentoConvergencia.astro';
import Comando from '../components/inicio/Comando.astro';
import Peca from '../components/inicio/Peca.astro';
import Portas from '../components/inicio/Portas.astro';
import EstadoVazio from '../components/inicio/EstadoVazio.astro';
import Cabeca from '../components/inicio/Cabeca.astro';
import Pesquisa from '../components/inicio/Pesquisa.astro';
import MapaRespira from '../components/inicio/MapaRespira.astro';
import BandaDaRegiao from '../components/inicio/BandaDaRegiao.astro';
import { FIGURAS, comparacaoComOLimiar } from '../data/figuras.mjs';
import { REGIOES, ESCALA } from '../data/regioes.mjs';
import { getClaim, parsePtNumber } from '../lib/ledger.mjs';
import { estadoDaMedida, estadoDaRegua } from '../lib/estado.mjs';
import { concelhos, chaveDaRegiao, chaveDoConcelho } from '../lib/inicio.mjs';
import { estadoDaVerificacao, prova } from '../lib/prova.mjs';
import { routePath } from '../lib/routes.mjs';
import { t } from '../i18n/strings.mjs';
import '../styles/inicio.css';

const { lang = 'pt' } = Astro.props;
const s = t(lang);
const path = routePath('home', lang);
const p = prova(lang);
const verificacao = estadoDaVerificacao();

const home = routePath('home', lang);
const hrefs = {
  pais: home,
  regiao: `${home}#convergencia`,
  municipio: routePath('municipios', lang),
  relance: home,
  leitura: `${home}?densidade=leitura`,
};

/* ------------------------------------------------------------------ o painel */
/* A comparação com o limiar continua a ser calculada aqui, uma vez, como na v2:
   é prosa da casa gerada de dois números que já existem, e não um número novo. */
const medidas = FIGURAS.map((f) => {
  const linha = getClaim(f.claim);
  return {
    ...f,
    linha,
    estado: estadoDaMedida(linha, f.limiar),
    comparacao: f.limiar ? comparacaoComOLimiar(linha, f.limiar) : null,
  };
});

/* -------------------------------------------------------------- os concelhos */
const cs = concelhos();
const evora = cs.find((c) => c.pagina) ?? null;
const primeiroSemPagina = cs.find((c) => !c.pagina) ?? null;

/* ------------------------------------------------------- as seis leituras da régua */
const regioesDaBanda = REGIOES.map((r) => ({
  slug: r.slug,
  nome: r.nome[lang],
  valor: r.valor,
  linha: getClaim(r.valor),
  frase: r.frase[lang],
}));

/* ------------------------------------------------------------ Évora, na cabeça */
/* O estado das oito medidas do concelho: o índice de dívida contra o tecto legal
   (um limiar formal publicado, e por isso colore), e a posição face a uma média
   (que não colore, Emenda 1). O resto não tem referência publicada. */
const estadosDeEvora = evora
  ? evora.pagina.relance.map((m) => {
      if (!m.claim) return null;
      if (m.claim === 'evora-indice-de-divida-2024') {
        const r = estadoDaRegua(getClaim(m.claim), {
          valor: getClaim('indice-de-divida-limite-legal').value,
          lado: 'superior',
          colore: true,
        });
        return r.colore ? r.estado : 'sem';
      }
      return 'sem';
    })
  : [];

/* O tecto legal do índice de dívida é uma linha do livro-razão, e é contra ela
   que a peça de Évora colore: a lei publica o limite, e um limite publicado é um
   limiar formal (Emenda 1). Tudo o resto do concelho fica a tinta. */
const TECTO_DA_DIVIDA = 'indice-de-divida-limite-legal';
const pecasDeEvora = evora
  ? evora.pagina.relance
      .filter((m) => m.claim)
      .map((m) => {
        const linha = getClaim(m.claim);
        if (m.claim !== 'evora-indice-de-divida-2024') {
          return { ...m, linha, estado: 'sem', colore: false, regua: null };
        }
        const tecto = getClaim(TECTO_DA_DIVIDA);
        const r = estadoDaRegua(linha, {
          valor: tecto.value,
          lado: 'superior',
          colore: true,
        });
        return {
          ...m,
          linha,
          estado: r.estado ?? 'sem',
          colore: r.colore,
          regua: {
            valor: parsePtNumber(linha.value),
            referencia: parsePtNumber(tecto.value),
            rotulo: 'tecto',
          },
        };
      })
  : [];

const blocos = [
  { chave: 'pais', tipo: 'pais', estados: medidas.map((m) => m.estado) },
  ...regioesDaBanda.map((r) => ({
    chave: chaveDaRegiao(r.slug),
    tipo: 'regiao',
    nome: r.nome,
    frase: r.frase,
    estados: ['sem'],
  })),
  ...(evora
    ? [
        {
          chave: chaveDoConcelho(evora.slug),
          tipo: 'evora',
          nome: evora.pagina.nome[lang] ?? evora.pagina.nome.pt,
          distrito: evora.pagina.distrito[lang] ?? evora.pagina.distrito.pt,
          estados: estadosDeEvora,
        },
      ]
    : []),
  {
    chave: 'vazio',
    tipo: 'vazio',
    nome: primeiroSemPagina?.nome ?? '',
    distrito: primeiroSemPagina?.distrito ?? '',
    /* ISSUES I18: o prefixo «distrito de» rende-se, ou não, conforme o campo
       da Carta seja um distrito ou uma ilha. O servidor decide-o para o
       concelho com que a página é construída; o script troca o `hidden` do
       prefixo quando o leitor escolhe outro. */
    ilha: primeiroSemPagina?.ilha ?? false,
    estados: [],
  },
];
---

<Base
  lang={lang}
  path={path}
  title={s.home.metaTitle}
  description={s.home.metaDescription}
>
  <Masthead slot="masthead" lang={lang} path={path} compact={false} furniture={true} />

  <div class="inicio" data-inicio data-ambito="pais" data-densidade="relance">
    <Comando s={s} hrefs={hrefs} />

    <div class="cmd-sub" data-sub="regiao" hidden>
      <div class="cmd-chips">
        {
          regioesDaBanda.map((r) => (
            <a
              class="chipb"
              href={`${home}?ambito=${chaveDaRegiao(r.slug)}`}
              data-regiao={r.slug}
            >
              {r.nome}
            </a>
          ))
        }
      </div>
      <p class="cmd-meta">{s.ambito.regioesMeta}</p>
    </div>

    <div class="cmd-sub" data-sub="municipio" hidden>
      <Pesquisa s={s} lang={lang} p={p} concelhos={cs} />
    </div>

    <div class="cabeca-grelha" data-grelha>
      <Cabeca s={s} lang={lang} p={p} blocos={blocos} ambito="pais" />
      <div class="cabeca-inst" data-coluna-instrumento>
        <MapaRespira s={s} lang={lang} p={p} concelhos={cs} evora={evora} />

        {/* ----------------------------------------------------------------
            O ÂMBITO COMO DESTINOS, NO TELEMÓVEL (Emenda 3, subetapa 2e)
            ----------------------------------------------------------------
            Num ecrã estreito o âmbito deixa de ser um interruptor de três
            posições e passa a ser duas linhas inteiras, ao lado do selo do
            país. **O selo inteiro é o alvo, e nenhum ponto é alvo**: 308
            pontos num mapa de 84px são textura, e um deles sob o polegar é
            uma porta que abre o concelho errado.

            São os mesmos `data-modo` da linha de comando, e por isso o mesmo
            ouvinte os serve; sem script, levam ao índice dos 308 e à régua da
            convergência, que existem os dois.
            ---------------------------------------------------------------- */}
        <div class="movel-destinos">
          <a class="movel-selo" href={routePath('municipios', lang)} data-modo="municipio">
            <span class="vh">{s.inicio.movel.seloDaEscolha}</span>
          </a>
          <div class="movel-linhas">
            <a class="movel-destino" href={routePath('municipios', lang)} data-modo="municipio">
              {s.inicio.movel.abrirConcelho} <span aria-hidden="true">→</span>
            </a>
            <a class="movel-destino" href={`${home}#convergencia`} data-modo="regiao">
              {s.inicio.movel.verRegiao} <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </div>
    </div>

    <div data-banda-caixa hidden>
      <BandaDaRegiao s={s} lang={lang} regioes={regioesDaBanda} escolhida={regioesDaBanda[0].slug} />
    </div>

    {/* A região viva do anúncio: uma só, e sempre com palavras que já estão na
        página. É aqui que a mudança de âmbito e de densidade se diz a quem não a
        vê acontecer. */}
    <p class="vh" role="status" aria-live="polite" data-anuncio></p>
  </div>

  <!-- ============================ O painel -->
  {/* Os quatro painéis estão todos no HTML, e o script acende um. É a mesma
      regra da cabeça: o portão vê tudo o que o leitor pode ver. */}
  <section id="painel">
    <div class="painel" data-painel="pais">
      {
        medidas.map((f) => (
          <Peca
            s={s}
            lang={lang}
            id={f.claim}
            nome={f.nome[lang]}
            medida={f.medida[lang]}
            frase={f.frase[lang]}
            limiar={f.limiar}
            comparacao={f.comparacao}
            estado={f.estado ?? 'sem'}
            regua={
              f.limiar
                ? {
                    valor: parsePtNumber(f.linha.value),
                    referencia: parsePtNumber(`${f.limiar.sinal ?? ''}${f.limiar.nl}`),
                    rotulo: 'limiar',
                  }
                : null
            }
          />
        ))
      }
    </div>

    {
      regioesDaBanda.map((r) => (
        <div class="painel painel-um" data-painel={chaveDaRegiao(r.slug)} hidden>
          <Peca
            s={s}
            lang={lang}
            id={r.valor}
            nome={r.nome}
            medida={[
              { nl: s.home.instr1.glanceUnidade, motivo: 'escala-de-instrumento' },
              ' · ',
              { ref: '2024' },
            ]}
            frase={r.frase}
            estado="sem"
            regua={{
              valor: parsePtNumber(r.linha.value),
              referencia: ESCALA.datum,
              rotulo: 'datum',
            }}
          />
        </div>
      ))
    }

    {
      evora && (
        <div class="painel" data-painel={chaveDoConcelho(evora.slug)} hidden>
          {pecasDeEvora.map((m) => (
            <Peca
              s={s}
              lang={lang}
              id={m.claim}
              nome={m.nome[lang]}
              medida={m.medida[lang]}
              frase={m.nota[lang]}
              estado={m.estado}
              colore={m.colore}
              regua={m.regua}
              ambito={`${evora.pagina.nome[lang] ?? evora.pagina.nome.pt}${s.inicio.cabeca.municipioSufixo}`}
              selosNaMedida={true}
            />
          ))}
        </div>
      )
    }

    <div data-painel="vazio" hidden>
      <EstadoVazio s={s} lang={lang} nome={primeiroSemPagina?.nome ?? ''} />
    </div>

    {/* A âncora `#numeros` é a porta do sinal de tempo do cabeçalho e da chave
        `painel_reconferido_em` da prova: é aqui que essa data se vê.

        E leva `data-so-pais` desde a 2g: a data é a reconferência do PAINEL
        EUROPEU, e rendia-se por baixo das oito medidas de Évora e por baixo do
        estado vazio de Beja, onde é uma frase sobre outra coisa. A âncora
        continua a existir no documento em qualquer âmbito, e por isso as duas
        portas que a prometem continuam a resolver; o que muda é que só se lê
        onde o painel que ela data está à vista. */}
    <p
      class="sec-sub verificacao"
      id="numeros"
      data-so-pais
      data-vencida={verificacao.vencida ? 'sim' : null}
    >
      {verificacao.vencida ? s.sinal.vencido : s.sinal.reconferido}{' '}
      <span data-nonledger="data-de-atualizacao">{verificacao.verificadoEm}</span>.
    </p>
  </section>

  <!-- ============================ Instrumento n.º 1 · só no âmbito País -->
  {/* --------------------------------------------------------------------
      A RÉGUA DA CONVERGÊNCIA É UMA PORTA NO TELEMÓVEL (ponto 10a da direcção)
      --------------------------------------------------------------------
      Abaixo de 640 o instrumento fecha-se atrás de uma linha, e a linha é um
      `<details>` nativo: teclado, estado anunciado pelo navegador, e nada
      disto precisa de script. O `<summary>` leva PALAVRAS e mais nada — o
      título do instrumento e o comando —, porque um valor ali dentro seria um
      número sem porta e um selo ali dentro seria uma porta dentro de outra
      porta (Emenda 2). O valor e o selo ficam onde sempre estiveram, dentro do
      instrumento.

      O corpo é IRMÃO do `<details>` e não filho dele, e a razão é medida: um
      `<details>` fechado esconde o que tem dentro pelo `::details-content`, e
      não há regra de folha universalmente suportada que o volte a mostrar na
      secretária. Com o corpo ao lado, a folha faz uma coisa só, com selectores
      que existem em todo o lado: `[open] ~` mostra, e acima de 640 a porta
      desaparece e o corpo está sempre à vista. É a mesma mecânica que o pé da
      peça já usa nesta folha. O que se perde é a associação de árvore entre o
      comando e o que ele abre; o que se ganha é que a secretária não depende
      de um pseudo-elemento que ainda não está em todos os motores.
      -------------------------------------------------------------------- */}
  <section id="convergencia" data-so-pais>
    <details class="conv-porta" data-conv-porta>
      <summary class="conv-porta-sum">
        <span class="conv-porta-seta" aria-hidden="true"></span>
        <span class="conv-porta-nome">{s.home.instr1.h2}</span>
        <span class="conv-porta-a">{s.densidade.abrir}</span>
        <span class="conv-porta-f">{s.densidade.fechar}</span>
      </summary>
    </details>
    <div class="conv-corpo">
      <div class="sec-head">
        <span class="eyebrow">
          {s.home.instr1.eyebrow} <span data-nonledger="numeracao">{lang === 'pt' ? 'n.º 1' : 'no. 1'}</span>
        </span>
        <h2>{s.home.instr1.h2}</h2>
        <p class="sec-sub"><Frase partes={s.home.instr1.subPartes} lang={lang} /></p>
      </div>
      <InstrumentoConvergencia lang={lang} />
    </div>
  </section>

  <!-- ============================ As portas · só no âmbito País -->
  <div data-so-pais>
    <Portas
      s={s}
      lang={lang}
      p={p}
      rotas={{
        municipios: routePath('municipios', lang),
        estudos: routePath('estudos', lang),
        agenda: routePath('agenda', lang),
      }}
    />
  </div>
</Base>

<script src="/js/inicio.js" defer is:inline></script>
