---
/**
 * A primeira página. Uma só fonte para as duas edições: recebe `lang` e nada mais.
 */
import Base from '../layouts/Base.astro';
import Masthead from '../components/Masthead.astro';
import Claim from '../components/Claim.astro';
import Provenance from '../components/Provenance.astro';
import Frase from '../components/Frase.astro';
import InstrumentoConvergencia from '../components/InstrumentoConvergencia.astro';
import InstrumentoMapa from '../components/InstrumentoMapa.astro';
import { FIGURAS, comparacaoComOLimiar } from '../data/figuras.mjs';
import { getClaim } from '../lib/ledger.mjs';
import { estadoDaVerificacao } from '../lib/prova.mjs';
import { routePath } from '../lib/routes.mjs';
import { t } from '../i18n/strings.mjs';

const { lang = 'pt' } = Astro.props;
const s = t(lang);
const path = routePath('home', lang);

/**
 * Quando o painel foi reconferido contra a fonte, e se isso já passou do prazo.
 *
 * A conta vive em src/lib/prova.mjs e é a mesma que o cabeçalho de todas as
 * páginas usa. Se a verificação atrasar, a página di-lo por palavras em vez de
 * deixar uma data parecer fresca.
 */
const verificacao = estadoDaVerificacao();

/**
 * O painel, cartão a cartão (v2, IDENTIDADE.md §11).
 *
 * A comparação com o limiar calcula-se aqui, uma vez, e não dentro do gabarito:
 * é prosa da casa gerada de dois números que já existem (o valor publicado da
 * linha e o limiar publicado pelo quadro), e não um número novo. Quando um dos
 * dois lados não é um número simples, `comparacaoComOLimiar` devolve `null` e a
 * célula fica sem a palavra. Nunca com uma palavra inventada.
 */
const cartoes = FIGURAS.map((f) => ({
  ...f,
  comparacao: f.limiar ? comparacaoComOLimiar(getClaim(f.claim), f.limiar) : null,
}));
---

<Base
  lang={lang}
  path={path}
  title={s.home.metaTitle}
  description={s.home.metaDescription}
>
  <Masthead slot="masthead" lang={lang} path={path} compact={false} furniture={true} />

  <!-- ============================ O país em números verificados -->
  <section id="numeros" style="padding-top:clamp(18px,2.4vw,28px)">
    <div class="sec-head">
      <span class="eyebrow">{s.home.numeros.eyebrow}</span>
      <h2>{s.home.numeros.h2}</h2>
      <p class="sec-sub">{s.home.numeros.sub}</p>
    </div>

    <div class="figuras">
      {
        cartoes.map((f) => (
          <article class="figura">
            <Claim id={f.claim} class="figura-num" as="div" escala={true} />
            <h3 class="figura-nome">{f.nome[lang]}</h3>
            <p class="figura-medida"><Frase partes={f.medida[lang]} lang={lang} /></p>
            {f.limiar && (
              /* Uma linha mono, sem barra e sem distância. O limiar continua
                 debaixo do motivo `limiar-do-quadro`, que é o que declara que
                 aqueles algarismos não são uma linha do livro-razão; a palavra
                 ao lado não tem algarismo nenhum. */
              <p class="figura-limiar">
                <span class="figura-limiar-k">{s.home.numeros.limiar}</span>{' '}
                <span class="figura-limiar-v">
                  {f.limiar.sinal ?? ''}
                  <span data-nonledger="limiar-do-quadro">{f.limiar.nl}</span>%
                </span>
                {f.comparacao && (
                  <span class="figura-limiar-palavra"> · {s.home.numeros[f.comparacao]}</span>
                )}
              </p>
            )}
            <p class="figura-frase"><Frase partes={f.frase[lang]} lang={lang} /></p>
            <Provenance id={f.claim} lang={lang} />
          </article>
        ))
      }
    </div>

    <p class="sec-sub verificacao" data-vencida={verificacao.vencida ? 'sim' : null}>
      {verificacao.vencida ? s.sinal.vencido : s.sinal.reconferido}{' '}
      <span data-nonledger="data-de-atualizacao">{verificacao.verificadoEm}</span>.
    </p>
  </section>

  <!-- ============================ Instrumento n.º 1 -->
  <section id="convergencia">
    <div class="sec-head">
      <span class="eyebrow">
        {s.home.instr1.eyebrow} <span data-nonledger="numeracao">{lang === 'pt' ? 'n.º 1' : 'no. 1'}</span>
      </span>
      <h2>{s.home.instr1.h2}</h2>
      <p class="sec-sub"><Frase partes={s.home.instr1.subPartes} lang={lang} /></p>
    </div>
    <InstrumentoConvergencia lang={lang} />
  </section>

  <!-- ============================ Instrumento n.º 2 -->
  <section id="mapa">
    <div class="sec-head">
      <span class="eyebrow">
        {s.home.instr2.eyebrow} <span data-nonledger="numeracao">{lang === 'pt' ? 'n.º 2' : 'no. 2'}</span>
      </span>
      <h2>
        {s.home.instr2.h2} · <Claim id="municipios-portugal-caop-2025" lang={lang} chip={true} />
      </h2>
      <p class="sec-sub">{s.home.instr2.sub}</p>
    </div>
    <InstrumentoMapa lang={lang} />
  </section>

  <!-- O colofão «Esta página» saiu a 18.08.2026 (DECISIONS §1.44). Dizia ao
       leitor que a página não faz pedidos de rede, que tipos usa e qual é a
       regra do amarelo: comentário de implementação numa página pública, e o
       BRIEF-confianca §6.3 pede o contrário, mostrar em vez de declarar. A
       porta das correções volta ao rodapé pelo invólucro, e por isso esta
       página deixou de passar `portaNoRodape={false}`. -->
</Base>
