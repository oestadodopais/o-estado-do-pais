---
/**
 * A PRIMEIRA PÁGINA v3. Uma só fonte para as duas edições: recebe `lang` e nada mais.
 *
 * ---------------------------------------------------------------------------
 * O QUE MUDOU, E A REGRA QUE GOVERNA TUDO O QUE SE SEGUE
 * ---------------------------------------------------------------------------
 * A página passou a ter estado: um âmbito (País, uma região, um concelho) e uma
 * densidade (Relance, Leitura breve), codificados no endereço, porque é o
 * endereço que se partilha (Emenda 7). E a regra que isso obriga é a resposta 3
 * da direcção à crítica cruzada:
 *
 *   **O CÓDIGO DE EXECUÇÃO ESCOLHE CADEIAS JÁ VALIDADAS E NUNCA COMPÕE UM
 *   NÚMERO.** Tudo o que a página pode mostrar em qualquer estado saiu deste
 *   ficheiro, foi construído pelo servidor e passou pelo portão de HTML. O
 *   script troca `hidden`, `open`, `aria-pressed` e `aria-current`, e escreve o
 *   `textContent` de dois `<span data-slot>` — o nome e o distrito do concelho
 *   escolhido, copiados do nó daquele concelho na ilha da CAOP que o mapa
 *   desenhou. Não há `innerHTML`, não há cadeia montada, não há aritmética que
 *   produza um algarismo à vista.
 *
 * O que isto custa é peso: nove blocos de cabeça, os 308 resultados da pesquisa
 * e os 308 pontos do mapa saem todos do servidor. O que isto compra é que o
 * portão vê tudo o que o leitor pode ver — que é a única maneira de a promessa
 * do sítio continuar de pé quando a página ganha estado.
 *
 * SEM JAVASCRIPT a página é o âmbito País em Relance, completa e correcta, e os
 * comandos são ligações para sítios que existem: `/` para o país e
 * `/municipios` para os 308.
 */
import Base from '../layouts/Base.astro';
import Masthead from '../components/Masthead.astro';
import Comando from '../components/inicio/Comando.astro';
import Peca from '../components/inicio/Peca.astro';
import Portas from '../components/inicio/Portas.astro';
import Cabeca from '../components/inicio/Cabeca.astro';
import Pesquisa from '../components/inicio/Pesquisa.astro';
import MapaRespira from '../components/inicio/MapaRespira.astro';
import ListaSocial from '../components/inicio/ListaSocial.astro';
import { FIGURAS_PDM, FIGURAS_SOCIAL, comparacaoComOLimiar, ladosDoLimiar } from '../data/figuras.mjs';
import { ESCALA } from '../data/regioes.mjs';
import { getClaim, parsePtNumber } from '../lib/ledger.mjs';
import { estadoDaMedida } from '../lib/estado.mjs';
import {
  concelhos,
  chaveDaRegiao,
  chaveDoConcelho,
  ledeDoPainel,
  pecasDoConcelho,
  REGIOES_DE_AMBITO,
} from '../lib/inicio.mjs';
import { estadoDaVerificacao, prova } from '../lib/prova.mjs';
import { routePath } from '../lib/routes.mjs';
import { t } from '../i18n/strings.mjs';
import '../styles/inicio.css';

const { lang = 'pt' } = Astro.props;
const s = t(lang);
const path = routePath('home', lang);
const p = prova(lang);
const verificacao = estadoDaVerificacao();

const home = routePath('home', lang);
/* Os destinos sem script. `regiao` saiu com a terceira posição do comando (item
   A2): o seu destino era `#convergencia`, que é a âncora da secção que saiu da
   página, e um comando cujo destino não existe é pior do que nenhum. */
const hrefs = {
  pais: home,
  municipio: routePath('municipios', lang),
  relance: home,
  leitura: `${home}?densidade=leitura`,
};

/* ------------------------------------------------------------------ o painel */
/* A comparação com o limiar continua a ser calculada aqui, uma vez, como na v2:
   é prosa da casa gerada de dois números que já existem, e não um número novo. */
const medidas = FIGURAS_PDM.map((f) => {
  const linha = getClaim(f.claim);
  /* A REFERÊNCIA DA RÉGUA SÃO OS LADOS DECLARADOS, um ou dois. Uma banda dá dois
     números e a régua desenha dois traços; um teto ou um chão dá um. A leitura
     da declaração é a de `ladosDoLimiar()`, e não há aqui uma segunda. */
  const lados = f.limiar ? ladosDoLimiar(f.limiar) : null;
  const refs = lados
    ? [lados.inferior, lados.superior].filter((l) => l !== null).map((l) => parsePtNumber(l))
    : [];
  return {
    ...f,
    linha,
    estado: estadoDaMedida(linha, f.limiar),
    comparacao: f.limiar ? comparacaoComOLimiar(linha, f.limiar) : null,
    referencias: refs,
  };
});

/* ------------------------------------------------------------------- a lede
 *
 * A lede do País deixa de ser uma frase escrita e passa a ser construída dos
 * nomes das medidas cujo estado é «fora» (etapa 2m, brief §2). Constrói-se aqui,
 * uma vez, com as mesmas `medidas` que o painel rende: se a lista mudar, mudam
 * as duas ao mesmo tempo, porque são a mesma lista.
 *
 * `null` quando nenhuma medida está fora do limiar, e a cabeça não rende lede
 * nenhuma nesse dia: uma frase que abre «Fora do limiar:» e não nomeia nada não
 * é uma frase. Qual é a forma desse estado é decisão da direção, e está escrita
 * na nota e em ISSUES em vez de inventada aqui.
 */
const lede = ledeDoPainel(medidas, s.inicio.cabeca.ledePais, lang);

/* O Painel Social Europeu: a lista da Emenda 16, com a linha de cada medida. */
const sociais = FIGURAS_SOCIAL.map((f) => ({ ...f, linha: getClaim(f.claim) }));

/* -------------------------------------------------------------- os concelhos */
const cs = concelhos();
const evora = cs.find((c) => c.pagina) ?? null;
const primeiroSemPagina = cs.find((c) => !c.pagina) ?? null;

/* ------------------------------------------------------- as seis leituras da régua
 *
 * A RÉGUA TEM SEIS LEITURAS; O ÂMBITO TEM CINCO REGIÕES (etapa 2i, achado 5).
 * Portugal está na régua — é a marca contra a qual as regiões se leem, e sai da
 * mesma lista publicada — mas não é uma região e não tem estado: não tem ficha
 * na cabeça, não tem painel, não tem pastilha, e `?ambito=regiao:portugal` cai
 * no defeito como qualquer valor desconhecido. Quem separa as duas listas é o
 * campo `referencia` de `regioes.mjs`, lido em `src/lib/inicio.mjs`.
 */
const leitura = (r) => ({
  slug: r.slug,
  nome: r.nome[lang],
  valor: r.valor,
  linha: getClaim(r.valor),
  frase: r.frase[lang],
});
/* A lista das SEIS leituras saiu com a banda (item A3): quem a desenhava era
   `BandaDaRegiao`, e a régua já não se rende aqui. Fica a lista do ÂMBITO, que
   é a das cinco regiões com bloco de cabeça e painel próprios — o que um
   endereço `?ambito=regiao:<slug>` continua a resolver. */
const regioesDeAmbito = REGIOES_DE_AMBITO.map(leitura);

/* AS PEÇAS DE ÉVORA SAEM DE UMA CONTA SÓ (ISSUES I44, fechado na etapa 2m).
   A conta estava escrita aqui e outra vez em `MunicipioView.astro`, e as duas
   podiam divergir. Passa a viver em `src/lib/inicio.mjs`, que é a canalização
   desta página, e as duas vistas chamam-na. O que ela decide — a nota de uma
   medida derivada, a cor do índice de dívida contra o tecto legal — está lá
   escrito, e a comparação deixou de ser com uma cadeia de Évora escrita à mão
   para passar a ser com a medida que o concelho declara. */
const pecasDeEvora = evora ? pecasDoConcelho(evora.pagina) : [];

/* OS BLOCOS DA CABEÇA JÁ NÃO LEVAM ESTADOS (Emenda 13, 21.08.2026).
   Cada bloco trazia a lista dos estados das medidas do seu âmbito, e era ela que
   a fila de quadrados desenhava. A fila saiu da cabeça: o estado de uma medida
   diz-se na peça dessa medida, ao lado do valor a que se refere. Com a fila, o
   campo; sem a fila, nada o lê, e um campo que ninguém lê é um cálculo a fingir
   que ainda serve. */
const blocos = [
  { chave: 'pais', tipo: 'pais' },
  ...regioesDeAmbito.map((r) => ({
    chave: chaveDaRegiao(r.slug),
    tipo: 'regiao',
    nome: r.nome,
    frase: r.frase,
  })),
  ...(evora
    ? [
        {
          chave: chaveDoConcelho(evora.slug),
          tipo: 'evora',
          nome: evora.pagina.nome[lang] ?? evora.pagina.nome.pt,
          distrito: evora.pagina.distrito[lang] ?? evora.pagina.distrito.pt,
        },
      ]
    : []),
  {
    chave: 'vazio',
    tipo: 'vazio',
    nome: primeiroSemPagina?.nome ?? '',
    distrito: primeiroSemPagina?.distrito ?? '',
    /* ISSUES I18: o prefixo «distrito de» rende-se, ou não, conforme o campo
       da Carta seja um distrito ou uma ilha. O servidor decide-o para o
       concelho com que a página é construída; o script troca o `hidden` do
       prefixo quando o leitor escolhe outro. */
    ilha: primeiroSemPagina?.ilha ?? false,
  },
];

/* ---------------------------------------------- as oito medidas, sem linha
 *
 * A DISPOSIÇÃO-PADRÃO MUNICIPAL PARA UM CONCELHO SEM PÁGINA (Emenda 14).
 * As mesmas oito medidas da página de concelho, pela mesma ordem, cada uma como
 * uma peça vazia: o nome, a unidade declarada e as palavras «sem linha ainda».
 * Sem valor, sem selo, sem marcador, e sem um único algarismo.
 *
 * A lista é a de `municipios.mjs`, e é a mesma que Évora rende — não uma segunda
 * lista escrita à mão, que divergiria da primeira no dia em que uma medida
 * entrasse ou saísse. O que a página diz de um concelho sem página é, medida a
 * medida, o que ela dirá dele quando houver linhas.
 */
const medidasSemLinha = evora
  ? evora.pagina.relance.map((m) => ({
      nome: m.nome[lang] ?? m.nome.pt,
      unidade: m.unidade[lang] ?? m.unidade.pt,
    }))
  : [];
---

<Base
  lang={lang}
  path={path}
  title={s.home.metaTitle}
  description={s.home.metaDescription}
>
  <Masthead slot="masthead" lang={lang} path={path} compact={false} furniture={true} />

  <div class="inicio" data-inicio data-ambito="pais" data-densidade="relance">
    <Comando s={s} hrefs={hrefs} />

    {/* ----------------------------------------------------------------------
        A PESQUISA DEIXA DE SER UM PAINEL QUE ABRE (bloco A, itens A1, A2 e A4)
        ----------------------------------------------------------------------
        Era `<div class="cmd-sub" data-sub="municipio" hidden>`, e quem lhe tirava
        o `hidden` era o script, quando o âmbito passava a «município». Abaixo de
        640 isso deixou de servir: com o mapa fora do telemóvel (item A4), a
        pesquisa é o caminho para o concelho e tem de estar à VISTA, em qualquer
        estado, logo por baixo da lede.

        Quem decide agora é a FOLHA, pelo `data-modo` que a raiz já carrega — a
        mesma técnica de `data-postura` no mapa (etapa 2m): acima de 640 a
        pesquisa só se vê no modo «município»; abaixo de 640 vê-se sempre. O
        atributo `hidden` sai daqui porque um `[hidden]` não se deixa reabrir por
        uma regra de largura, e uma segunda cópia do 640 dentro do script
        divergiria da primeira no dia em que a folha mudasse.

        A FILA DAS REGIÕES SAIU COM O COMANDO «REGIÃO» (item A2). Era o painel
        que esse comando abria; sem comando, era um painel sem porta. O estado
        `?ambito=regiao:<slug>` continua a resolver e a render a leitura da
        região, que é o que a Emenda 7 promete a um endereço partilhado.
        ---------------------------------------------------------------------- */}
    <div class="pesquisa-bloco" data-pesquisa-bloco>
      <Pesquisa s={s} lang={lang} p={p} concelhos={cs} />
    </div>

    <div class="cabeca-grelha" data-grelha>
      <Cabeca s={s} lang={lang} p={p} blocos={blocos} ambito="pais" lede={lede} />
      <div class="cabeca-inst" data-coluna-instrumento>
        <MapaRespira s={s} lang={lang} p={p} concelhos={cs} evora={evora} />

        {/* ----------------------------------------------------------------
            OS DOIS DESTINOS DO TELEMÓVEL SAÍRAM (bloco A, itens A2 e A4)
            ----------------------------------------------------------------
            «Abrir um concelho →» e «Ver uma região →», ao lado do selo do mapa,
            eram a cara móvel do comando de âmbito, com outros nomes e outra
            forma (achado C5), e o primeiro rolava a página para lá do que
            abria (achado B1). Os dois foram substituídos pelo comando único das
            duas larguras. O selo do país saiu com eles: abaixo de 640 o mapa
            deixa de se render, e uma porta invisível por cima de um espaço em
            branco é uma porta que ninguém vê e que qualquer polegar abre.

            A Emenda 3 continua de pé por baixo desta correção: no telemóvel os
            308 pontos nunca são alvos, e a pesquisa é o caminho principal. O que
            muda é que a pesquisa deixou de estar atrás de um comando.
            ---------------------------------------------------------------- */}
      </div>
    </div>

    {/* A REGUA DA REGIÃO SAIU DA PRIMEIRA PÁGINA (bloco A, itens A2 e A3).
        A banda desenhava as seis leituras da convergência no âmbito «região»,
        e era o que o comando «Ver uma região →» abria: os rótulos sobrepunham-se
        a 390 exatamente no estado em que o comando prometia levar (achado B4).
        O componente fica no repositório, com a sua folha e as suas linhas, para
        a página das regiões que se segue; o que sai é a sua rendição em `/`. */}

    {/* A região viva do anúncio: uma só, e sempre com palavras que já estão na
        página. É aqui que a mudança de âmbito e de densidade se diz a quem não a
        vê acontecer. */}
    <p class="vh" role="status" aria-live="polite" data-anuncio></p>
  </div>

  <!-- ============================ O painel -->
  {/* Os quatro painéis estão todos no HTML, e o script acende um. É a mesma
      regra da cabeça: o portão vê tudo o que o leitor pode ver. */}
  <section id="painel">
    <div class="painel" data-painel="pais">
      {
        medidas.map((f) => (
          <Peca
            s={s}
            lang={lang}
            id={f.claim}
            nome={f.nome[lang]}
            medida={f.medida[lang]}
            frase={f.frase?.[lang] ?? null}
            limiar={f.limiar}
            comparacao={f.comparacao}
            estado={f.estado ?? 'sem'}
            regua={
              f.referencias.length
                ? {
                    valor: parsePtNumber(f.linha.value),
                    referencia: f.referencias.length > 1 ? f.referencias : f.referencias[0],
                    rotulo: 'limiar',
                  }
                : null
            }
          />
        ))
      }
    </div>

    {/* A FRASE DA REGIÃO NÃO SE REPETE AQUI (etapa 2i, achado 6, R4). A frase de
        cada região era a manchete deste âmbito E o texto da sua peça, uma por
        cima da outra no mesmo ecrã, com o mesmo valor e o mesmo selo duas vezes.
        A manchete é o sítio onde ela se lê; a peça leva o valor, a sua régua e o
        seu selo. O registo passa de três ocorrências por região a duas. */}
    {
      regioesDeAmbito.map((r) => (
        <div class="painel painel-um" data-painel={chaveDaRegiao(r.slug)} hidden>
          <Peca
            s={s}
            lang={lang}
            id={r.valor}
            nome={r.nome}
            medida={[
              { nl: s.home.instr1.glanceUnidade, motivo: 'escala-de-instrumento' },
              ' · ',
              { ref: '2024' },
            ]}
            estado="sem"
            regua={{
              valor: parsePtNumber(r.linha.value),
              referencia: ESCALA.datum,
              rotulo: 'datum',
            }}
          />
        </div>
      ))
    }

    {
      evora && (
        <div class="painel" data-painel={chaveDoConcelho(evora.slug)} hidden>
          {pecasDeEvora.map((m) => (
            <Peca
              s={s}
              lang={lang}
              id={m.claim}
              nome={m.nome[lang]}
              medida={m.medida[lang]}
              frase={m.derivada ? null : m.nota[lang]}
              estado={m.estado}
              colore={m.colore}
              regua={m.regua}
              ambito={`${evora.pagina.nome[lang] ?? evora.pagina.nome.pt}${s.inicio.cabeca.municipioSufixo}`}
              selosNaMedida={true}
            />
          ))}
        </div>
      )
    }

    {/* ------------------------------------------------------------------
        UM CONCELHO SEM PÁGINA RENDE A DISPOSIÇÃO-PADRÃO (Emenda 14)
        ------------------------------------------------------------------
        Era uma caixa de estado vazio. Passa a ser a frase que explica o estado,
        de largura inteira, e por baixo dela as oito medidas do concelho como
        peças vazias — a mesma grelha, as mesmas células, os mesmos fios. É o que
        a `IDENTIDADE.md` §7 pede a uma página por escrever: declarar o que lhe
        falta em vez de fingir corpo. O que falta são oito medidas, e vêem-se as
        oito.
        ------------------------------------------------------------------ */}
    {/* A FRASE QUE EXPLICAVA O ESTADO VAZIO SAIU (Emenda 15). Dizia «Nenhuma
        medida foi lida para <nome>. As fontes que publicam para todos os
        concelhos do país permitem que as mesmas medidas existam aqui, com a
        mesma prova, no dia em que forem lidas.» — um parágrafo sobre as
        intenções do sítio, por cima de oito peças que já dizem, cada uma em duas
        palavras, o que falta. «A ausência diz-se em duas palavras ("sem linha"),
        não num parágrafo.» `EstadoVazio.astro` era o único sítio que a rendia, e
        sai do repositório com ela. */}
    <div class="painel" data-painel="vazio" hidden>
      {medidasSemLinha.map((m) => <Peca s={s} vazio={true} nome={m.nome} unidade={m.unidade} />)}
    </div>

    {/* ------------------------------------------------------------------
        O PAINEL SOCIAL EUROPEU (Emenda 16), e a porta para o resto
        ------------------------------------------------------------------
        Por baixo do painel do Procedimento, e só no âmbito País: os dois
        painéis são de Portugal, e uma região ou um concelho não têm nem um nem
        outro. `data-so-pais` é a mesma marca que o instrumento e as portas já
        usam, e o script trata dela.
        ------------------------------------------------------------------ */}
    <div data-so-pais>
      <ListaSocial s={s} lang={lang} medidas={sociais} porta={routePath('livro', lang)} />
    </div>

    {/* ------------------------------------------------------------------
        A LINHA DA RECONFERÊNCIA SAIU DA PRIMEIRA PÁGINA (Emenda 15)
        ------------------------------------------------------------------
        «Painel europeu reconferido a <data>», por baixo do painel, é uma frase
        sobre a verificação do próprio sítio — a classe que a emenda nomeia — e
        era a SEGUNDA cópia dela na mesma página: a mobília do cabeçalho leva-a
        em todas as páginas, com a mesma cadeia e a mesma conta.

        Com ela sai a âncora `#numeros`, e a porta da chave
        `painel_reconferido_em` passa a ser `#painel`, que é a secção que aquela
        data cobre. A mudança é em `src/lib/prova.mjs` e na mobília, e as duas
        superfícies que a rendem — o cabeçalho de 307 páginas e a legenda de
        portas do instrumento do mecanismo — seguem-na sem uma linha a mais.
        ------------------------------------------------------------------ */}
  </section>

  {/* ----------------------------------------------------------------------
      O INSTRUMENTO N.º 1 SAI DA PRIMEIRA PÁGINA (bloco A, item A3)
      ----------------------------------------------------------------------
      A régua da convergência respondia a «como está cada região face à média
      europeia», e é a única leitura regional que o sítio tem. A auditoria de
      25.08 mediu-a: seis leituras, todas «provisório», fechada numa dobra no
      estado de entrada e ilegível a 390 no único estado em que o comando a
      mostrava (achado B4). A decisão do diretor é a forma A da §3.3: sai da
      primeira página até haver a página das regiões.

      NADA SE APAGA. `src/components/InstrumentoConvergencia.astro`, a sua folha,
      as linhas do livro-razão que ele desenha, as chaves da prova que ele
      rendia e a marca `data-nonledger="escala-de-instrumento"` ficam onde estão,
      para a página que se segue. O que sai é a rendição em `/`: a secção
      `#convergencia`, a sua porta de telemóvel e o corpo que ela abria.

      AS CHAVES DA PROVA CONTINUAM CONFERIDAS, e isto foi lido no portão e não
      assumido: `scripts/gate-html.mjs` percorre `Object.entries(PROVA)` e exige
      que ele saiba CONTAR cada chave, não que alguma página a renda («a chave
      existe na prova e o portão não a sabe contar»). Uma chave que nenhuma
      página rende continua reconferida contra a sua segunda conta; o que o
      portão confere na página é o contrário — um `data-prova` renderizado que
      não bata certo com a conta dele.
      ---------------------------------------------------------------------- */}

  <!-- ============================ As portas · só no âmbito País -->
  <div data-so-pais>
    <Portas
      s={s}
      lang={lang}
      p={p}
      rotas={{
        municipios: routePath('municipios', lang),
        estudos: routePath('estudos', lang),
        agenda: routePath('agenda', lang),
      }}
    />
  </div>

  {/* ----------------------------------------------------------------------
      O SCRIPT DENTRO DO DOCUMENTO (etapa 2i, achado 18)
      ----------------------------------------------------------------------
      Estava depois de `</Base>`, e um `is:inline` não se move: a página
      construída acabava em `</body></html><script …>`, com a etiqueta fora do
      documento. Nenhum motor deixa de a executar, mas um documento que fecha e
      continua não é HTML válido, e a promessa desta página é que o que se serve
      é o que se diz.

      O lugar é o mesmo que `convergencia.js` já usava: dentro da ranhura de
      `Base.astro`, no fim do que a vista escreve. `defer` mantém a ordem e a
      execução depois da análise do documento.
      ---------------------------------------------------------------------- */}
  <script src="/js/inicio.js" defer is:inline></script>
</Base>
