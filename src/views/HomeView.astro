---
/**
 * A PRIMEIRA PÁGINA v3. Uma só fonte para as duas edições: recebe `lang` e nada mais.
 *
 * ---------------------------------------------------------------------------
 * O QUE MUDOU, E A REGRA QUE GOVERNA TUDO O QUE SE SEGUE
 * ---------------------------------------------------------------------------
 * A página passou a ter estado: um âmbito (País, uma região, um concelho) e uma
 * densidade (Relance, Leitura breve), codificados no endereço, porque é o
 * endereço que se partilha (Emenda 7). E a regra que isso obriga é a resposta 3
 * da direcção à crítica cruzada:
 *
 *   **O CÓDIGO DE EXECUÇÃO ESCOLHE CADEIAS JÁ VALIDADAS E NUNCA COMPÕE UM
 *   NÚMERO.** Tudo o que a página pode mostrar em qualquer estado saiu deste
 *   ficheiro, foi construído pelo servidor e passou pelo portão de HTML. O
 *   script troca `hidden`, `open`, `aria-pressed` e `aria-current`, e escreve o
 *   `textContent` de dois `<span data-slot>` — o nome e o distrito do concelho
 *   escolhido, copiados do nó daquele concelho na ilha da CAOP que o mapa
 *   desenhou. Não há `innerHTML`, não há cadeia montada, não há aritmética que
 *   produza um algarismo à vista.
 *
 * O que isto custa é peso: nove blocos de cabeça, os 308 resultados da pesquisa
 * e os 308 pontos do mapa saem todos do servidor. O que isto compra é que o
 * portão vê tudo o que o leitor pode ver — que é a única maneira de a promessa
 * do sítio continuar de pé quando a página ganha estado.
 *
 * SEM JAVASCRIPT a página é o âmbito País em Relance, completa e correcta, e os
 * comandos são ligações para sítios que existem: `/` para o país,
 * `/#convergencia` para a leitura regional, `/municipios` para os 308.
 */
import Base from '../layouts/Base.astro';
import Masthead from '../components/Masthead.astro';
import Claim from '../components/Claim.astro';
import Provenance from '../components/Provenance.astro';
import Frase from '../components/Frase.astro';
import InstrumentoConvergencia from '../components/InstrumentoConvergencia.astro';
import Comando from '../components/inicio/Comando.astro';
import Cabeca from '../components/inicio/Cabeca.astro';
import Pesquisa from '../components/inicio/Pesquisa.astro';
import MapaRespira from '../components/inicio/MapaRespira.astro';
import BandaDaRegiao from '../components/inicio/BandaDaRegiao.astro';
import { FIGURAS, comparacaoComOLimiar } from '../data/figuras.mjs';
import { REGIOES } from '../data/regioes.mjs';
import { getClaim } from '../lib/ledger.mjs';
import { estadoDaMedida, estadoDaRegua } from '../lib/estado.mjs';
import { concelhos, chaveDaRegiao, chaveDoConcelho } from '../lib/inicio.mjs';
import { estadoDaVerificacao, prova } from '../lib/prova.mjs';
import { routePath } from '../lib/routes.mjs';
import { t } from '../i18n/strings.mjs';
import '../styles/inicio.css';

const { lang = 'pt' } = Astro.props;
const s = t(lang);
const path = routePath('home', lang);
const p = prova(lang);
const verificacao = estadoDaVerificacao();

const home = routePath('home', lang);
const hrefs = {
  pais: home,
  regiao: `${home}#convergencia`,
  municipio: routePath('municipios', lang),
  relance: home,
  leitura: `${home}?densidade=leitura`,
};

/* ------------------------------------------------------------------ o painel */
/* A comparação com o limiar continua a ser calculada aqui, uma vez, como na v2:
   é prosa da casa gerada de dois números que já existem, e não um número novo. */
const medidas = FIGURAS.map((f) => {
  const linha = getClaim(f.claim);
  return {
    ...f,
    linha,
    estado: estadoDaMedida(linha, f.limiar),
    comparacao: f.limiar ? comparacaoComOLimiar(linha, f.limiar) : null,
  };
});

/* -------------------------------------------------------------- os concelhos */
const cs = concelhos();
const evora = cs.find((c) => c.pagina) ?? null;
const primeiroSemPagina = cs.find((c) => !c.pagina) ?? null;

/* ------------------------------------------------------- as seis leituras da régua */
const regioesDaBanda = REGIOES.map((r) => ({
  slug: r.slug,
  nome: r.nome[lang],
  valor: r.valor,
  linha: getClaim(r.valor),
  frase: r.frase[lang],
}));

/* ------------------------------------------------------------ Évora, na cabeça */
/* O estado das oito medidas do concelho: o índice de dívida contra o tecto legal
   (um limiar formal publicado, e por isso colore), e a posição face a uma média
   (que não colore, Emenda 1). O resto não tem referência publicada. */
const estadosDeEvora = evora
  ? evora.pagina.relance.map((m) => {
      if (!m.claim) return null;
      if (m.claim === 'evora-indice-de-divida-2024') {
        const r = estadoDaRegua(getClaim(m.claim), {
          valor: getClaim('indice-de-divida-limite-legal').value,
          lado: 'superior',
          colore: true,
        });
        return r.colore ? r.estado : 'sem';
      }
      return 'sem';
    })
  : [];

const blocos = [
  { chave: 'pais', tipo: 'pais', estados: medidas.map((m) => m.estado) },
  ...regioesDaBanda.map((r) => ({
    chave: chaveDaRegiao(r.slug),
    tipo: 'regiao',
    nome: r.nome,
    frase: r.frase,
    estados: ['sem'],
  })),
  ...(evora
    ? [
        {
          chave: chaveDoConcelho(evora.slug),
          tipo: 'evora',
          nome: evora.pagina.nome[lang] ?? evora.pagina.nome.pt,
          distrito: evora.pagina.distrito[lang] ?? evora.pagina.distrito.pt,
          estados: estadosDeEvora,
        },
      ]
    : []),
  {
    chave: 'vazio',
    tipo: 'vazio',
    nome: primeiroSemPagina?.nome ?? '',
    distrito: primeiroSemPagina?.distrito ?? '',
    estados: [],
  },
];
---

<Base
  lang={lang}
  path={path}
  title={s.home.metaTitle}
  description={s.home.metaDescription}
>
  <Masthead slot="masthead" lang={lang} path={path} compact={false} furniture={true} />

  <div class="inicio" data-inicio data-ambito="pais" data-densidade="relance">
    <Comando s={s} hrefs={hrefs} />

    <div class="cmd-sub" data-sub="regiao" hidden>
      <div class="cmd-chips">
        {
          regioesDaBanda.map((r) => (
            <a
              class="chipb"
              href={`${home}?ambito=${chaveDaRegiao(r.slug)}`}
              data-regiao={r.slug}
            >
              {r.nome}
            </a>
          ))
        }
      </div>
      <p class="cmd-meta">{s.ambito.regioesMeta}</p>
    </div>

    <div class="cmd-sub" data-sub="municipio" hidden>
      <Pesquisa s={s} lang={lang} p={p} concelhos={cs} />
    </div>

    <div class="cabeca-grelha" data-grelha>
      <Cabeca s={s} lang={lang} p={p} blocos={blocos} ambito="pais" />
      <div class="cabeca-inst" data-coluna-instrumento>
        <MapaRespira s={s} lang={lang} p={p} concelhos={cs} evora={evora} />
      </div>
    </div>

    <div data-banda-caixa hidden>
      <BandaDaRegiao s={s} lang={lang} regioes={regioesDaBanda} escolhida={regioesDaBanda[0].slug} />
    </div>

    {/* A região viva do anúncio: uma só, e sempre com palavras que já estão na
        página. É aqui que a mudança de âmbito e de densidade se diz a quem não a
        vê acontecer. */}
    <p class="vh" role="status" aria-live="polite" data-anuncio></p>
  </div>

  <!-- ============================ O painel -->
  <section id="painel">
    <div class="figuras">
      {
        medidas.map((f) => (
          <article class="figura">
            <Claim id={f.claim} class="figura-num" as="div" escala={true} />
            <h3 class="figura-nome">{f.nome[lang]}</h3>
            <p class="figura-medida"><Frase partes={f.medida[lang]} lang={lang} /></p>
            {f.limiar && (
              <p class="figura-limiar">
                <span class="figura-limiar-k">{s.home.numeros.limiar}</span>{' '}
                <span class="figura-limiar-v">
                  {f.limiar.sinal ?? ''}
                  <span data-nonledger="limiar-do-quadro">{f.limiar.nl}</span>%
                </span>
                {f.comparacao && (
                  <span class="figura-limiar-palavra"> · {s.home.numeros[f.comparacao]}</span>
                )}
              </p>
            )}
            <p class="figura-frase"><Frase partes={f.frase[lang]} lang={lang} /></p>
            <Provenance id={f.claim} lang={lang} />
          </article>
        ))
      }
    </div>

    {/* A âncora `#numeros` é a porta do sinal de tempo do cabeçalho e da chave
        `painel_reconferido_em` da prova: é aqui que essa data se vê. */}
    <p class="sec-sub verificacao" id="numeros" data-vencida={verificacao.vencida ? 'sim' : null}>
      {verificacao.vencida ? s.sinal.vencido : s.sinal.reconferido}{' '}
      <span data-nonledger="data-de-atualizacao">{verificacao.verificadoEm}</span>.
    </p>
  </section>

  <!-- ============================ Instrumento n.º 1 -->
  <section id="convergencia">
    <div class="sec-head">
      <span class="eyebrow">
        {s.home.instr1.eyebrow} <span data-nonledger="numeracao">{lang === 'pt' ? 'n.º 1' : 'no. 1'}</span>
      </span>
      <h2>{s.home.instr1.h2}</h2>
      <p class="sec-sub"><Frase partes={s.home.instr1.subPartes} lang={lang} /></p>
    </div>
    <InstrumentoConvergencia lang={lang} />
  </section>
</Base>

<script src="/js/inicio.js" defer is:inline></script>
