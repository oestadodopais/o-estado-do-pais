---
/** B1, peça 3: a leitura, o mapa, os temas, os estudos e as mudanças. */
import Base from '../layouts/Base.astro';
import Masthead from '../components/Masthead.astro';
import LeituraDoPais from '../components/inicio/LeituraDoPais.astro';
import MapaRespira from '../components/inicio/MapaRespira.astro';
import LegendaDoMapa from '../components/inicio/LegendaDoMapa.astro';
import TemasDoPais from '../components/TemasDoPais.astro';
import Frase from '../components/Frase.astro';
import TituloDeTrabalho from '../components/TituloDeTrabalho.astro';
import Provenance from '../components/Provenance.astro';
import { concelhos } from '../lib/inicio.mjs';
import { estudosRecentes, mudancasDoPais } from '../lib/pais.mjs';
import { dataDaCasa } from '../lib/datas.mjs';
import { unidadeDaLinha } from '../i18n/unidades.mjs';
import { routePath } from '../lib/routes.mjs';
import { t } from '../i18n/strings.mjs';
import { ROTULOS_B1 } from '../data/rotulos-b1.mjs';
import '../styles/inicio.css';
import '../styles/estudos-b1.css';
import '../styles/lugar.css';
import '../styles/pais.css';
const { lang = 'pt' } = Astro.props;
const s = t(lang);
const r = ROTULOS_B1[lang];
const path = routePath('home', lang);
const recentes = estudosRecentes(lang).slice(0, 3);
const mudou = mudancasDoPais(lang);
---
<Base lang={lang} path={path} title={s.home.metaTitle} description={s.home.metaDescription}>
  <Masthead slot="masthead" lang={lang} path={path} />
  <div class="pais-cabeca">
    <LeituraDoPais lang={lang} />
    <div class="pais-mapa">
      <MapaRespira s={s} lang={lang} concelhos={concelhos()} portaLugares />
      <LegendaDoMapa />
    </div>
    <section class="pais-temas" aria-labelledby="temas-k">
      <div class="sec-head"><h2 class="eyebrow" id="temas-k">{r.temas}</h2></div>
      <TemasDoPais lang={lang} resumo />
    </section>
  </div>
  <section class="pais-sec" id="trabalhos" aria-labelledby="estudos-k">
    <div class="sec-head"><h2 class="eyebrow" id="estudos-k">{r.estudosDoLugar}</h2></div>
    {recentes.map(e => <article class="estudo-item pais-estudo" data-estudo={e.work.slug} data-estudo-edicao={`${e.work.slug}/${e.edicao.lang}`}>
      <h3 class="estudo-item-titulo"><a href={e.rota}><TituloDeTrabalho titulo={e.edicao.title} lang={lang} /></a>
        {e.edicao.lang !== lang && <span class="estudo-lingua"> {r.outraLingua}</span>}
      </h3>
      <p class="estudo-meta"><span>{e.lugar}</span><span>{e.tema}</span><span>{r.publicado}{' '}<time datetime={e.data} data-nonledger="data-do-repositorio">{dataDaCasa(e.data)}</time></span></p>
      <p class="estudo-resumo lugar-estudo-leitura" data-verbatim={e.temLeitura ? undefined : e.work.verbatimDaAbertura?.[lang]}><Frase partes={e.resumo} lang={lang} selos /></p>
    </article>)}
  </section>
  <section class="pais-sec" aria-labelledby="mudou-k">
    <div class="sec-head"><h2 class="eyebrow" id="mudou-k">{r.mudou}</h2></div>
    <ol class="pais-mudou">
      {mudou.map(e => <li data-mudanca={e.tipo} data-mudanca-id={e.tipo === 'projeto' ? e.id : undefined} data-correcao-entrada={e.tipo === 'correcao' ? e.claim : undefined}>
        {e.tipo === 'projeto' ? <><time datetime={e.data} data-mudanca-campo="data">{dataDaCasa(e.data)}</time><p data-mudanca-campo="texto">{e.texto[lang]}</p></> : e.tipo === 'publicacao' ? <><time datetime={e.data} data-publicacao-estudo={`${e.estudo.work.slug}/${e.estudo.edicao.lang}`}>{dataDaCasa(e.data)}</time><p><span>{r.publicado}</span>{' · '}<TituloDeTrabalho titulo={e.estudo.edicao.title} lang={lang} /></p></> : <>
          <time datetime={e.data} data-correcao-claim={e.claim} data-correcao-n={String(e.nDoNovo)} data-correcao-campo="date">{dataDaCasa(e.data)}</time>
          <p>{e.nome?.fonte && <span class="lugar-mudou-nome" data-nome={e.nome.fonte} data-de-linha={e.claim}>{e.nome.texto}</span>}
            <span class="lugar-mudou-par"><s data-correcao-claim={e.claim} data-correcao-n={String(e.nDoAntigo)} data-correcao-campo="old_value">{e.antes}</s>{' → '}<span data-correcao-claim={e.claim} data-correcao-n={String(e.nDoNovo)} data-correcao-campo="new_value">{e.depois}</span>{' '}{e.unidade && unidadeDaLinha(e.unidade, lang).texto}<Provenance id={e.claim} lang={lang} /></span>
          </p>
        </>}
      </li>)}
    </ol>
  </section>
  <script src="/js/mapa-unidades.js" defer is:inline></script>
</Base>
