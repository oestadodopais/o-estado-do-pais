---
/**
 * A PRIMEIRA PÁGINA DE UM LEITOR COMUM (bloco PP1, 28.09.2026; a decisão do diretor de
 * 28.09.2026, `DECISIONS.md` §1.133: o leitor comum primeiro).
 *
 * A ordem é a do brief (§2, ponto 3): o rótulo de inteligência artificial, como hoje (vem do
 * `Base`); «O que se passa», com a data dos números mais recentes e os cinco blocos pela ordem
 * declarada; «Por onde começar», com as portas dos assuntos e a dos lugares; «Estudos recentes», como
 * hoje; o veredicto dos valores de referência da Comissão Europeia, com um título seu e a porta da
 * página da União; e as portas «Todos os temas», «Números e fontes» e «O que mudou».
 *
 * O MAPA E A PESQUISA DOS LUGARES SAÍRAM DAQUI (bloco L2a, 01.10.2026; `DECISIONS.md` §1.149). O
 * diretor leu no telemóvel que o mapa ficava muito em baixo, depois dos cinco blocos e das portas, e
 * os dois eram uma segunda cópia do que «Lugares» tem (uma coisa, um lugar, §1.143). A porta
 * «Lugares» do índice leva agora um mapa pequeno como sinal (`SinalDosLugares.astro`), e o mapa
 * inteiro, a pesquisa e a menção da fonte vivem em «Lugares», logo a seguir à pesquisa.
 *
 * SAÍRAM DAQUI, e cada coisa tem outro lugar: a leitura do país (`LeituraDoPais.astro`, que prendia
 * nove valores e fechava a construção quando um mudava; o que ela dizia está nos blocos da habitação,
 * do trabalho e do Estado, com condições em vez de valores presos), o resumo dos temas (a página dos
 * temas e as entradas levam os cartões) e a lista das mudanças (o registo, em `/correcoes`, que a
 * porta «O que mudou» abre).
 *
 * A DATA DE «O QUE SE PASSA» é o período de referência mais recente, pelo fim do período, das linhas
 * que os blocos mostrados usam, escrito como o sítio escreve os períodos. A data de publicação não
 * serve: a maior parte das linhas do Eurostat não a tem.
 */
import Base from '../layouts/Base.astro';
import IndiceDosAssuntos from '../components/IndiceDosAssuntos.astro';
import { portaDoCartao } from '../lib/assuntos.mjs';
import Masthead from '../components/Masthead.astro';
import BlocoDaPrimeiraPagina from '../components/inicio/BlocoDaPrimeiraPagina.astro';
import ParaPerceber from '../components/inicio/ParaPerceber.astro';
import EstudoDaLista from '../components/inicio/EstudoDaLista.astro';
import CampoDaLinha from '../components/CampoDaLinha.astro';
import DataDaLinha from '../components/DataDaLinha.astro';
import ValorDaProva from '../components/ValorDaProva.astro';
import { ledeDoPainel } from '../lib/inicio.mjs';
import { FIGURAS_PDM } from '../data/figuras.mjs';
import { getClaim } from '../lib/ledger.mjs';
import { estadoDaMedida } from '../lib/estado.mjs';
import { prova } from '../lib/prova.mjs';
import { estudosRecentes } from '../lib/pais.mjs';
import { idsDosBlocos, blocosDaPagina, periodoDosNumerosMaisRecentes } from '../lib/primeira-pagina.mjs';
import { routePath } from '../lib/routes.mjs';
import { t } from '../i18n/strings.mjs';
import { ROTULOS_B1 } from '../data/rotulos-b1.mjs';
import '../styles/inicio.css';
import '../styles/estudos-b1.css';
import '../styles/lugar.css';
import '../styles/pais.css';
import '../styles/primeira-pagina.css';
const { lang = 'pt' } = Astro.props;
const s = t(lang);
const r = ROTULOS_B1[lang];
const path = routePath('home', lang);
const recentes = estudosRecentes(lang).slice(0, 3);
const p = prova(lang);
const medidasDoPainel = FIGURAS_PDM.map(f => {
  const linha = getClaim(f.claim);
  return { ...f, linha, estado: estadoDaMedida(linha, f.limiar) };
});
const lede = ledeDoPainel(medidasDoPainel, s.inicio.cabeca.ledePais, lang);
const v = s.home.veredicto;
const periodos = new Set(medidasDoPainel.map(m => m.linha.reference_date));
if (!lede?.ano || periodos.size !== 1 || !periodos.has(lede.ano)) throw new Error('B2 veredicto: as linhas não partilham um período.');
/* Os blocos resolvem-se aqui só para a data de «O que se passa»; cada um rende-se no seu
   componente, que pergunta ao mesmo resolvedor. */
const ids = idsDosBlocos();
const recente = periodoDosNumerosMaisRecentes(blocosDaPagina(ids, lang));
---
<Base lang={lang} path={path} title={s.home.metaTitle} description={s.home.metaDescription}>
  <Masthead slot="masthead" lang={lang} path={path} />

  <section class="pp-o-que-se-passa" data-o-que-se-passa aria-labelledby="o-que-se-passa-k">
    <h2 class="pp-o-que-se-passa-k" id="o-que-se-passa-k">{s.primeira.oQueSePassa}</h2>
    {recente && (
      <p class="pp-data" data-numeros-mais-recentes>{s.primeira.numerosMaisRecentes}<DataDaLinha id={recente.linha} campo="reference_date" valor={recente.periodo} lang={lang} /></p>
    )}
    <div class="pp-blocos">
      {ids.map((id) => <BlocoDaPrimeiraPagina id={id} lang={lang} nivel="h3" />)}
    </div>
    {/* «PARA PERCEBER» (bloco EX1, 05.10.2026): fecha «O que se passa», com a porta da explicação mais recente e a da
        leitura da semana. Fica fora da lista dos cinco blocos, que tem a gramática e a célula deles. */}
    <ParaPerceber lang={lang} />
  </section>

  <section class="pp-entradas" data-entradas aria-labelledby="entradas-k">
    <h2 class="pp-sec-k" id="entradas-k">{s.primeira.porOndeComecar}</h2>
    <IndiceDosAssuntos lang={lang} />
  </section>

  <section class="pais-sec" id="trabalhos" aria-labelledby="estudos-k">
    <div class="sec-head"><h2 class="eyebrow" id="estudos-k">{r.estudosRecentes}</h2></div>
    {recentes.map((e) => <EstudoDaLista e={e} lang={lang} mostrarEmCurso />)}
  </section>

  {/* O VEREDICTO DOS VALORES DE REFERÊNCIA DA COMISSÃO EUROPEIA: o parágrafo calculado de antes
      (B2), com um título seu e a porta da página da União. A V1 do `check:pais` reconta-o. */}
  <section class="pais-sec pp-veredicto" data-veredicto-seccao aria-labelledby="veredicto-k">
    <div class="sec-head"><h2 class="eyebrow" id="veredicto-k">{s.primeira.veredicto}</h2></div>
    <p class="pais-leitura pais-veredicto" data-veredicto-pais>
      {v.ano}<CampoDaLinha id={medidasDoPainel[0].claim} campo="reference_date" valor={lede.ano} lang={lang} />{v.abre}<ValorDaProva chave="painel_fora_do_limiar" item={p.painel_fora_do_limiar} lang={lang} />{v.de}<ValorDaProva chave="painel_com_limiar" item={p.painel_com_limiar} lang={lang} />{v.referencias}<ValorDaProva chave="painel_dentro_do_limiar" item={p.painel_dentro_do_limiar} lang={lang} />{lede && <>{v.lista}<span data-veredicto-medidas>{lede.referencias.map((m, i) => <>{i ? i === lede.referencias.length - 1 ? s.inicio.cabeca.ledePais.ultimo : s.inicio.cabeca.ledePais.separador : ''}<a data-veredicto-medida={m.claim} href={portaDoCartao(m.claim, lang)}>{m.nome}</a></>)}</span></>}{v.fecha}
    </p>
    <p class="regra-portas"><a href={routePath('uniaoEuropeia', lang)}>{s.nav.uniaoEuropeia} →</a></p>
  </section>

  <div class="pp-portas" data-portas-da-primeira>
    <p class="regra-portas"><a href={routePath('temas', lang)}>{s.primeira.todosOsTemas} →</a></p>
    <p class="regra-portas"><a href={routePath('livro', lang)}>{s.nav.livro} →</a></p>
    <p class="regra-portas"><a href={routePath('correcoes', lang)}>{r.mudou} →</a></p>
  </div>
</Base>
