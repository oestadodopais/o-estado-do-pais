---
/**
 * O RECIBO DE UMA SÉRIE NO TEMPO (bloco RP3, 04.10.2026, o ponto 6 do mandato).
 *
 * Uma página por série com `eixo: periodo` e por edição, na rota das séries
 * (`/livro-razao/series/<id>`, a do UE1, que tem dois segmentos para não se contar
 * entre as afirmações): o nome do projeto e o da fonte, a periodicidade, o
 * primeiro e o último período e a unidade, a tabela de TODOS os pontos (o
 * período, o valor e a marca da fonte onde ela a põe), o que quer dizer cada
 * marca, os períodos que a fonte não publica, a conta de uma série derivada, a
 * prova (a página da série na fonte, o literal da série, as datas e os pedidos,
 * cada um com o endereço, a hora, o cliente, o nome com que o projeto se
 * apresenta, o resumo e os bytes), as correções, e as linhas do livro-razão que
 * são pontos desta série. Disposição B da `IDENTIDADE.md` §3, como o recibo de
 * uma série de países e o de uma linha.
 *
 * NENHUM ALGARISMO SEM ORIGEM. Cada valor vai por `PontoDaSerie`
 * (`data-ponto="<id>#<período>"`), cada campo por `CampoDaSerie`
 * (`data-serie-campo`), cada período e cada data por `DataDaSerie` (o motivo
 * `data-da-linha` com `data-linha-de-serie` e o campo, recomposto pela F1 do
 * `check:formas`). O portão de HTML confere os três, e a S6 do `check:series`
 * reconta a tabela contra a série nas duas edições.
 *
 * NADA DE CARTÃO DE PARTILHA POR SÉRIE: a série entra no estudo de dados dos
 * domínios, como as linhas dos concelhos (a decisão 4 do brief RP3).
 *
 * DUAS COISAS DO BLOCO RP4-m (05.10.2026). Uma série cuja unidade é um índice com
 * base («índice (base AAAA = 100)») diz, em palavras da casa, o que o último ponto
 * quer dizer em relação à base, com o período e o valor pelos seus componentes e a
 * palavra do lado escolhida pela comparação com cem (o ponto 5 do mandato, o achado 7
 * das leituras do RP4). E uma série derivada declarada em `FIGURAS_INDEXADAS` desenha
 * as séries da lista no mesmo eixo, indexadas a cem no período de base da regra do RP4,
 * com a legenda fora do desenho (o ponto 4): a forma e a recomposição da F21 não mudam,
 * e a regra da página da F21 admite o modo indexado só no recibo de uma série declarada.
 */
import SerieDoPais from '../components/formas/SerieDoPais.astro';
import { tabelaPorAnos, BASE_DO_INDICE } from '../lib/formas/serie-do-pais.mjs';
import Base from '../layouts/Base.astro';
import NomeDaSerie from '../components/serie/NomeDaSerie.astro';
import NomeDaMedida from '../components/NomeDaMedida.astro';
import PontoDaSerie from '../components/serie/PontoDaSerie.astro';
import CampoDaSerie from '../components/serie/CampoDaSerie.astro';
import DataDaSerie from '../components/serie/DataDaSerie.astro';
import DataDaLinha from '../components/DataDaLinha.astro';
import Frase from '../components/Frase.astro';
import { oQueEDaSerie } from '../lib/o-que-e-o-numero.mjs';
import { comparacaoDoUltimoPonto } from '../lib/formas/ultimo-ponto-da-serie.mjs';
import { allClaims, parsePtNumber } from '../lib/ledger.mjs';
import { getSerie, pontosDaSerie } from '../lib/series.mjs';
import { NOMES_DAS_SERIES, PALAVRAS_DAS_MARCAS_DO_INE, PALAVRAS_DA_PERIODICIDADE, FIGURAS_INDEXADAS } from '../data/series-no-tempo.mjs';
import { PALAVRAS_DA_FAIXA } from '../data/faixa-da-uniao.mjs';
import { nomeDoCartao } from '../lib/nomes.mjs';
import { getClaim } from '../lib/ledger.mjs';
import { routePath, LANGS } from '../lib/routes.mjs';
import { unidadeDaLinha } from '../i18n/unidades.mjs';
import { studyLabel } from '../data/studies.mjs';
import { SITE_NAME } from '../../site.config.mjs';
import { t } from '../i18n/strings.mjs';
import '../styles/linha.css';
import '../styles/serie.css';
import '../styles/serie-no-tempo.css';

const { lang = 'pt', id } = Astro.props;
const s = t(lang);
const st = s.livro.serieNoTempo;
const serie = getSerie(id);
if (serie.eixo !== 'periodo') throw new Error(`série «${id}»: o recibo de uma série no tempo é só para eixo: periodo.`);
const pontos = pontosDaSerie(serie);
const anos = tabelaPorAnos(serie);
const colunas = serie.periodicidade === 'mensal' ? st.meses : serie.periodicidade === 'trimestral' ? st.trimestres : serie.periodicidade === 'semestral' ? st.semestres : [s.livro.serie.valorK];
const derivada = Array.isArray(serie.derived_from) && serie.derived_from.length > 0;
const documento = /** @type {Record<string, string> | null} */ (serie.document ?? null);
const bandeiras = /** @type {Record<string, string>} */ (serie.bandeiras ?? {});
const pedidos = /** @type {Record<string, any>[]} */ (Array.isArray(serie.pedidos) ? serie.pedidos : []);
const lacunas = /** @type {{ periodo: string, razao: string | null }[]} */ (Array.isArray(serie.lacunas) ? serie.lacunas : []);
const correcoes = /** @type {Record<string, string>[]} */ (Array.isArray(serie.corrections) ? serie.corrections : []);
const origens = /** @type {string[]} */ (derivada ? serie.derived_from : []);
/* A LÍNGUA DO QUE A FONTE ESCREVE: o INE escreve em português, o Eurostat em
   inglês. Um texto da fonte noutra língua que não a da página leva a marca. */
const linguaDaFonte = serie.source === 'INE' ? 'pt' : serie.source === 'Eurostat' ? 'en' : null;
const marcaDaLingua = linguaDaFonte && linguaDaFonte !== lang ? linguaDaFonte : null;
/* AS MARCAS DA TABELA, pela ordem em que aparecem nela, cada uma com as palavras
   do projeto (as da faixa da União para o Eurostat, as do cartão para o INE) e a
   definição que a resposta traz: o que falta fecha a construção aqui. */
const marcasNaTabela = [...new Set(pontos.map((p) => (p.bandeira ? String(p.bandeira) : '')).filter(Boolean))];
const palavrasDasMarcas = /** @type {Record<string, string>} */ (serie.source === 'INE' ? PALAVRAS_DAS_MARCAS_DO_INE[lang] : PALAVRAS_DA_FAIXA[lang].ressalvas);
for (const marca of marcasNaTabela) {
  if (!bandeiras[marca]) throw new Error(`série «${id}»: a marca «${marca}» está na tabela e a série não traz a definição dela.`);
  if (!palavrasDasMarcas[marca]) throw new Error(`série «${id}»: a marca «${marca}» não tem palavras declaradas (${lang}).`);
}
const unidade = unidadeDaLinha(serie.unit, lang);
const periodicidade = PALAVRAS_DA_PERIODICIDADE[lang][String(serie.periodicidade)];
if (!periodicidade) throw new Error(`série «${id}»: a periodicidade «${String(serie.periodicidade)}» não tem palavra declarada (${lang}).`);
/* O NOME DO PROJETO, EM TEXTO, para o título da aba e a descrição: o do cartão, ou
   o declarado. O corpo rende-o com a marca, por `NomeDaSerie`. */
const declarado = NOMES_DAS_SERIES[id];
if (!declarado) throw new Error(`série «${id}»: o nome do projeto não está declarado.`);
const nomeEmTexto = 'linha' in declarado ? nomeDoCartao(getClaim(declarado.linha), lang)?.texto : declarado.nome[lang];
if (!nomeEmTexto) throw new Error(`série «${id}»: o nome do projeto não se resolve.`);
/* AS LINHAS DO LIVRO-RAZÃO QUE SÃO PONTOS DESTA SÉRIE (o campo `serie`, que a
   regra S14 confere), pela ordem do período. */
const linhasPresas = allClaims()
  .filter((c) => /** @type {Record<string, unknown>} */ (/** @type {unknown} */ (c)).serie === id)
  .sort((a, b) => String(a.reference_date).localeCompare(String(b.reference_date)));
const outraLingua = LANGS.find((l) => l !== lang) ?? 'pt';
const path = routePath('serie', lang, { slug: id });
const titulo = `${nomeEmTexto} · ${st.metaSufixo} · ${s.livro.eyebrow} · ${SITE_NAME}`;
/* A DESCRIÇÃO NÃO LEVA ALGARISMOS: o `<head>` não tem onde os provar. */
const descricao = `${s.livro.serie.eyebrow} · ${nomeEmTexto} · ${derivada ? SITE_NAME : String(serie.source)}`;
const campoDaConta = lang === 'en' ? 'derivation_en' : 'derivation';
/* A FIGURA INDEXADA (RP4-m, o ponto 4): a lista declarada, a última é esta série e as outras são origens dela. */
const indexada = /** @type {string[] | null} */ ((/** @type {Record<string, string[]>} */ (FIGURAS_INDEXADAS))[id] ?? null);
if (indexada && (!derivada || indexada[indexada.length - 1] !== id || !indexada.slice(0, -1).every((o) => origens.includes(o)))) {
  throw new Error(`série «${id}»: a figura indexada declarada não acaba nesta série derivada ou cita uma série que não é origem dela.`);
}
const baseDaFigura = indexada ? BASE_DO_INDICE[/** @type {'mensal'|'trimestral'|'semestral'|'anual'} */ (String(serie.periodicidade))] : null;
const iBase = indexada ? pontos.findIndex((p) => String(p.periodo) === baseDaFigura) : -1;
if (indexada && iBase < 0) throw new Error(`série «${id}»: a figura indexada pede o ponto de base ${baseDaFigura}, que a série não tem.`);
/* O QUE UM ÍNDICE QUER DIZER (RP4-m, o ponto 5): pela forma da unidade, e não por uma lista. */
const eIndice = /^índice \(base \d{4} = 100\)$/.test(String(serie.unit));
const ultimo = pontos[pontos.length - 1];
const valorDoUltimo = eIndice ? parsePtNumber(String(ultimo.valor)) : null;
if (eIndice && valorDoUltimo === null) throw new Error(`série «${id}»: o último ponto do índice não é um número.`);
const ladoDoIndice = valorDoUltimo === null ? null : valorDoUltimo > 100 ? st.indiceAcima : valorDoUltimo < 100 ? st.indiceAbaixo : st.indiceIgual;
/* R4 (05.10.2026, o ponto 3 do brief): o que é a série (a frase da sua linha, ou a escrita e provada para ela) e o que
   o último ponto quer dizer em relação ao mesmo período de há um ano, ou ao ponto anterior quando a série não o tem.
   Os períodos e os valores vão pelas suas marcas, a palavra do lado é a que `comparacaoDoUltimoPonto()` escolhe, e a
   unidade vai pela marca do campo, menos num índice, cuja frase do RP4-m já diz o que a base quer dizer. */
const oQueEDaSerieAqui = oQueEDaSerie(id, lang);
const ultimoComparado = comparacaoDoUltimoPonto(serie);
const cadencia = /** @type {'mensal'|'trimestral'|'semestral'|'anual'} */ (String(serie.periodicidade));
const unidadeNaFrase = !eIndice;
---

<Base lang={lang} path={path} title={titulo} description={descricao}>
  <div class="linha-cabeca serie-cabeca">
    <span class="eyebrow">{s.livro.serie.eyebrow}</span>
    <h1 class="serie-titulo">
      <NomeDaSerie id={id} lang={lang} class="serie-titulo-nome" />
    </h1>
    {
      !derivada && (
        <p class="serie-nome-na-fonte">
          <span class="linha-campo-k">{st.fonteK}</span>{' '}
          <CampoDaSerie serie={id} campo="name" valor={String(serie.name)} lingua={marcaDaLingua} />
        </p>
      )
    }
    <div class="linha-o-que-e" data-o-que-e-da-serie={id} data-o-que-e-origem={oQueEDaSerieAqui.origem} data-o-que-e-linha={oQueEDaSerieAqui.linha ?? undefined}>
      <p class="linha-o-que-e-k" data-voz>{st.oQueEK}</p>
      <p class="linha-o-que-e-frase"><Frase partes={oQueEDaSerieAqui.pedacos} lang={lang} selos={true} /></p>
    </div>
    <p class="serie-periodo">
      <span class="linha-campo-k">{st.periodosK}</span>{' '}
      <DataDaSerie serie={id} campo="primeiro_periodo" valor={String(serie.primeiro_periodo)} lang={lang} />
      {` ${st.ate} `}
      <DataDaSerie serie={id} campo="ultimo_periodo" valor={String(serie.ultimo_periodo)} lang={lang} />
      {' · '}
      <span class="linha-campo-k">{st.periodicidadeK}</span>{' '}
      <CampoDaSerie serie={id} campo="periodicidade" valor={periodicidade} />
      {' · '}
      <CampoDaSerie serie={id} campo="unit" valor={unidade.texto} lingua={unidade.lingua} />
    </p>
    <p class="linha-id">
      <span class="linha-id-k">{s.livro.linha.identificadorK}</span>{' '}
      <CampoDaSerie serie={id} campo="id" valor={id} as="code" />
    </p>
  </div>

  <div class="linha">
    <div class="linha-corpo">
      {
        !derivada && documento && (
          <p class="linha-atribuicao">
            <span>{s.livro.linha.publicadoPor}</span>{' '}
            <CampoDaSerie serie={id} campo="source" valor={String(serie.source)} />
            {', '}<span>{s.livro.linha.publicadoEm}</span>{' «'}
            <CampoDaSerie serie={id} campo="document.title" valor={documento.title} lingua={marcaDaLingua} />
            {'» ('}<CampoDaSerie serie={id} campo="document.edition" valor={documento.edition} />{').'}
          </p>
        )
      }

      {
        ultimoComparado && (
          <p class="serie-indice-frase serie-ultimo-frase" data-serie-ultimo={id} data-serie-ultimo-com={ultimoComparado.com} data-serie-ultimo-lado={ultimoComparado.lado}>
            {st.ultimoEm[cadencia]}<DataDaSerie serie={id} campo={`pontos.${ultimoComparado.ultimo.indice}.periodo`} valor={ultimoComparado.ultimo.periodo} lang={lang} />{st.ultimoFoi}<PontoDaSerie serie={id} chave={ultimoComparado.ultimo.periodo} />{unidadeNaFrase && <>{' '}<CampoDaSerie serie={id} campo="unit" valor={unidade.texto} lingua={unidade.lingua} /></>}{ultimoComparado.ultimo.bandeira && <>{' ('}<span data-serie-ultimo-marca={`${id}#${ultimoComparado.ultimo.periodo}`}>{palavrasDasMarcas[ultimoComparado.ultimo.bandeira]}</span>{')'}</>}{st.ultimoLado[ultimoComparado.lado]}{st.ultimoReferencia[ultimoComparado.com === 'ha-um-ano' ? cadencia : 'anterior']}{st.ultimoArtigo[cadencia]}<DataDaSerie serie={id} campo={`pontos.${ultimoComparado.outro.indice}.periodo`} valor={ultimoComparado.outro.periodo} lang={lang} />{st.ultimoQuando}<PontoDaSerie serie={id} chave={ultimoComparado.outro.periodo} />{unidadeNaFrase && <>{' '}<CampoDaSerie serie={id} campo="unit" valor={unidade.texto} lingua={unidade.lingua} /></>}{ultimoComparado.outro.bandeira && <>{' ('}<span data-serie-ultimo-marca={`${id}#${ultimoComparado.outro.periodo}`}>{palavrasDasMarcas[ultimoComparado.outro.bandeira]}</span>{')'}</>}{st.ultimoFim}
          </p>
        )
      }

      {
        eIndice && (
          <p class="serie-indice-frase" data-serie-indice={id}>
            {st.indiceAntes}<DataDaSerie serie={id} campo={`pontos.${pontos.length - 1}.periodo`} valor={String(ultimo.periodo)} lang={lang} />{st.indiceValia}<PontoDaSerie serie={id} chave={String(ultimo.periodo)} />{ladoDoIndice}
          </p>
        )
      }

      {
        derivada && (
          <section class="linha-bloco serie-conta" aria-labelledby="conta">
            <h2 class="linha-bloco-titulo" id="conta">{st.derivadaK}</h2>
            <p>{origens.length > 1 ? st.derivadaFraseVarias : st.derivadaFrase}</p>
            <p>
              <CampoDaSerie serie={id} campo={campoDaConta} valor={String(lang === 'en' ? serie.derivation_en : serie.derivation)} />
            </p>
            <p>
              <span class="linha-campo-k">{origens.length > 1 ? st.origensK : st.origemK}</span>{' '}
              {origens.map((o, i) => (
                <>
                  {i > 0 && ', '}
                  <a href={routePath('serie', lang, { slug: o })} data-serie-de-origem={o}>
                    <NomeDaSerie id={o} lang={lang} />
                  </a>
                </>
              ))}
            </p>
            <p>
              <span class="linha-campo-k">{st.expressaoK}</span>{' '}
              <CampoDaSerie serie={id} campo="check" valor={String(serie.check)} as="code" />
            </p>
          </section>
        )
      }

      <section class="linha-bloco serie-pontos" aria-labelledby="pontos">
        <h2 class="linha-bloco-titulo" id="pontos">{st.pontosK}</h2>
        <div class:list={['serie-grafico', indexada && 'serie-grafico-indexado']}><SerieDoPais ids={indexada ?? [id]} modo={indexada ? 'indice' : 'unidade'} lang={lang} /></div>
        {
          indexada && (
            <div class="serie-indexada-legenda" data-serie-indexada={id}>
              <ul class="serie-indexada-lista">
                {indexada.map((o, i) => (
                  <li data-serie-indexada-linha={o}>
                    <span class:list={['serie-indexada-traco', i === indexada.length - 1 && 'serie-indexada-traco-tracejado']} aria-hidden="true" />
                    <NomeDaSerie id={o} lang={lang} />
                  </li>
                ))}
              </ul>
              <p class="serie-indexada-frase">{st.indexadaAntes}<DataDaSerie serie={id} campo={`pontos.${iBase}.periodo`} valor={String(baseDaFigura)} lang={lang} />{st.indexadaDepois}</p>
            </div>
          )
        }
        <div class="serie-pontos-corpo">
          <div class="serie-tabela-janela" tabindex="0" role="region" aria-labelledby="pontos">
          <table class="serie-tabela serie-tabela-tempo" data-serie-tabela={id}>
            <thead>
              <tr><th scope="col">{st.anoK}</th>{colunas.map((c) => <th scope="col">{c}</th>)}</tr>
            </thead>
            <tbody>
              {anos.map(({ ano, celulas }) => <tr data-serie-ano={ano}>
                <th scope="row" data-nonledger="escala-de-instrumento">{ano}</th>
                {celulas.map(({ periodo, ponto, lacuna }) => <td class="serie-num" data-serie-celula={periodo}>
                  {ponto && <>
                    <DataDaSerie serie={id} campo={`pontos.${ponto.indice}.periodo`} valor={periodo} lang={lang} class="vh" />{' '}
                    <PontoDaSerie serie={id} chave={periodo} />
                    {ponto.bandeira && <span class="serie-marca" data-ponto-bandeira={`${id}#${periodo}`}>{ponto.bandeira}</span>}
                  </>}
                  {lacuna && <span data-serie-lacuna-tabela={`${id}#${periodo}`}>
                    <DataDaSerie serie={id} campo={`lacunas.${lacuna.indice}.periodo`} valor={periodo} lang={lang} class="vh" />{' '}
                    <span>{st.semValor}</span>
                  </span>}
                </td>)}
              </tr>)}
            </tbody>
          </table>
          </div>
          {
            marcasNaTabela.length > 0 && (
              <div class="serie-marcas" data-serie-marcas={id}>
                <h3 class="serie-marcas-titulo">{s.livro.serie.marcasK}</h3>
                <dl class="serie-marcas-lista">
                  {marcasNaTabela.map((marca) => (
                    <div class="serie-marca-entrada">
                      <dt>
                        <span data-serie-marca={`${id}#${marca}`}>{marca}</span>
                      </dt>
                      <dd>
                        <span class="serie-marca-palavras" data-serie-marca-palavras={`${id}#${marca}`}>{palavrasDasMarcas[marca]}</span>
                        {'; '}{serie.source === 'INE' ? st.naRespostaDoIne : s.livro.serie.naResposta}{' «'}
                        <CampoDaSerie serie={id} campo={`bandeiras.${marca}`} valor={bandeiras[marca]} lingua={marcaDaLingua} class="serie-marca-rotulo" />
                        {'»'}
                      </dd>
                    </div>
                  ))}
                </dl>
                <p class="serie-marcas-nota">{serie.source === 'INE' ? st.marcasFraseDoIne : s.livro.serie.marcasFrase}</p>
              </div>
            )
          }
        </div>
      </section>

      {
        lacunas.length > 0 && (
          <section class="linha-bloco serie-lacunas" aria-labelledby="lacunas">
            <h2 class="linha-bloco-titulo" id="lacunas">{st.lacunasK}</h2>
            <p>{st.lacunasFrase}</p>
            <ul class="serie-lacunas-lista">
              {lacunas.map((l, i) => (
                <li data-serie-lacuna={`${id}#${l.periodo}`}>
                  <DataDaSerie serie={id} campo={`lacunas.${i}.periodo`} valor={l.periodo} lang={lang} />
                  {' · '}
                  {l.razao === null ? <span>{st.lacunaSemRazao}</span> : <CampoDaSerie serie={id} campo={`lacunas.${i}.razao`} valor={l.razao} lingua={marcaDaLingua} />}
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        !derivada && documento && (
          <section class="linha-bloco serie-prova" aria-labelledby="prova-k" id="prova">
            <h2 class="linha-bloco-titulo" id="prova-k">{s.livro.linha.provaK}</h2>
            <p>
              <span class="linha-campo-k">{s.livro.serie.paginaDaFonteK}</span>{' '}
              <a href={documento.url}><CampoDaSerie serie={id} campo="document.url" valor={documento.url} /></a>
            </p>
            <p>
              <span class="linha-campo-k">{s.livro.serie.pedidoK}</span>{' '}
              <a href={String(serie.source_url)} class="serie-pedido"><CampoDaSerie serie={id} campo="source_url" valor={String(serie.source_url)} /></a>
            </p>
            <p>
              <span class="linha-campo-k">{s.livro.serie.literalK}</span>{' '}
              <CampoDaSerie serie={id} campo="excerpt" valor={String(serie.excerpt)} lingua={marcaDaLingua} as="q" />
            </p>
            <p>
              <span class="linha-campo-k">{s.livro.serie.lidoK}</span>{' '}
              <DataDaSerie serie={id} campo="access_date" valor={String(serie.access_date)} lang={lang} />
            </p>
            <p>
              <span class="linha-campo-k">{s.livro.serie.publicadoK}</span>{' '}
              <DataDaSerie serie={id} campo="published_at" valor={String(serie.published_at)} lang={lang} />
            </p>
            <details class="serie-pedidos">
              <summary>{st.pedidosK}</summary>
              <p>{st.pedidosFrase}</p>
              <ol class="serie-pedidos-lista">
                {pedidos.map((q, i) => (
                  <li data-serie-pedido={`${id}#${i}`}>
                    {/* O ENDEREÇO DE CADA PEDIDO ESCREVE-SE E NÃO SE LIGA: o do último ponto é o do
                        «O pedido», logo acima, com a ligação, e duas portas para o mesmo destino no
                        mesmo ecrã são o que a L1 do `check:lugar` conta. */}
                    <CampoDaSerie serie={id} campo={`pedidos.${i}.url`} valor={String(q.url)} class="serie-pedido" />
                    <dl class="serie-pedido-ficha">
                      <dt>{st.horaK}</dt>
                      <dd><DataDaSerie serie={id} campo={`pedidos.${i}.lido_em`} valor={String(q.lido_em)} lang={lang} /></dd>
                      <dt>{st.clienteK}</dt>
                      <dd><CampoDaSerie serie={id} campo={`pedidos.${i}.cliente`} valor={String(q.cliente)} as="code" /></dd>
                      <dt>{st.nomeK}</dt>
                      <dd><CampoDaSerie serie={id} campo={`pedidos.${i}.user_agent`} valor={String(q.user_agent)} as="code" /></dd>
                      <dt>{st.resumoK}</dt>
                      <dd><CampoDaSerie serie={id} campo={`pedidos.${i}.sha256`} valor={String(q.sha256)} as="code" /></dd>
                      <dt>{st.bytesK}</dt>
                      <dd><CampoDaSerie serie={id} campo={`pedidos.${i}.bytes`} valor={String(q.bytes)} /></dd>
                      <dt>{st.pontosDoPedidoK}</dt>
                      <dd>
                        <DataDaSerie serie={id} campo={`pedidos.${i}.primeiro`} valor={String(q.primeiro)} lang={lang} />
                        {` ${st.ate} `}
                        <DataDaSerie serie={id} campo={`pedidos.${i}.ultimo`} valor={String(q.ultimo)} lang={lang} />
                      </dd>
                    </dl>
                  </li>
                ))}
              </ol>
            </details>
          </section>
        )
      }

      <section class="linha-bloco serie-correcoes" aria-labelledby="correcoes-da-serie">
        <h2 class="linha-bloco-titulo" id="correcoes-da-serie">{st.correcoesK}</h2>
        {
          correcoes.length === 0 ? (
            <p>{st.semCorrecoes}</p>
          ) : (
            <ul>
              {correcoes.map((c, i) => (
                <li data-serie-correcao={`${id}#${i}`}>
                  <DataDaSerie serie={id} campo={`corrections.${i}.periodo`} valor={c.periodo} lang={lang} />
                  {' · '}
                  <DataDaSerie serie={id} campo={`corrections.${i}.date`} valor={c.date} lang={lang} />
                  {' · '}
                  <CampoDaSerie serie={id} campo={`corrections.${i}.old_value`} valor={c.old_value} />
                  {' → '}
                  <CampoDaSerie serie={id} campo={`corrections.${i}.new_value`} valor={c.new_value} />
                  {' · '}
                  <CampoDaSerie serie={id} campo={`corrections.${i}.${lang === 'en' ? 'reason_en' : 'reason'}`} valor={lang === 'en' ? c.reason_en : c.reason} />
                </li>
              ))}
            </ul>
          )
        }
      </section>
    </div>

    <aside class="aparelho" aria-labelledby="aparelho">
      <h2 class="aparelho-titulo" id="aparelho">{s.livro.linha.aparelhoK}</h2>
      <dl class="aparelho-ficha">
        {
          linhasPresas.length > 0 && (
            <>
              <dt>{st.linhasK}</dt>
              {linhasPresas.map((c) => (
                <dd data-linha-da-serie={c.id}>
                  <a href={routePath('linha', lang, { slug: c.id })}>
                    <NomeDaMedida linha={c} lang={lang} escada="cartao" class="serie-linha-nome" />
                  </a>
                  {' · '}
                  <DataDaLinha id={c.id} campo="reference_date" valor={String(c.reference_date)} lang={lang} />
                </dd>
              ))}
            </>
          )
        }
        <dt>{s.livro.serie.estudoK}</dt>
        <dd><span data-nonledger="proveniencia">{studyLabel(String(serie.study), lang)}</span></dd>
        <dt>{s.livro.serie.outraEdicaoK}</dt>
        <dd><a href={routePath('serie', outraLingua, { slug: id })} hreflang={outraLingua === 'en' ? 'en' : 'pt-PT'}>{s.livro.serie.noutraEdicao}</a></dd>
      </dl>
    </aside>
  </div>
</Base>
