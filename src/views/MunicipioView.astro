---
/**
 * ===========================================================================
 * A PÁGINA DE UM LUGAR (B1, peça 2, 21.09.2026)
 * ===========================================================================
 *
 * Uma só fonte para as duas edições e para os 308: recebe `lang` e o slug, e
 * mais nada.
 *
 * O QUE A PÁGINA TEM, POR ESTA ORDEM, E NADA MAIS (a maqueta
 * `design/especime-v3/maquetas/b1/evora.html`, e o §1 da estrutura de
 * 17.09.2026):
 *
 *   1. **a linha do lugar** · «Portugal › região › distrito › concelho», cada
 *      parte com a sua página. A região e o distrito são os DESTE concelho,
 *      lidos dos três extratos da Carta que o projeto aloja. A linha não afirma
 *      que o distrito está dentro da região: seis distritos têm concelhos em
 *      duas regiões, e a razão está escrita em `src/data/carta-dos-lugares.mjs`;
 *   2. **o nome**;
 *   3. **a leitura** · o que os números deste lugar dizem em conjunto, com um ou
 *      dois deles selados. Composta em `src/lib/lugar.mjs`;
 *   4. **os números por tema** · só os temas que têm medida para este lugar,
 *      cada medida no cartão do P2. Um número que está na leitura não abre a
 *      primeira fila do seu tema;
 *   5. **os estudos sobre este lugar** · compostos de `WORKS` pelo lugar que
 *      cada estudo declara, do mais recente ao mais antigo, cada um com as duas
 *      primeiras frases da sua leitura ou, sem leitura, da descrição;
 *   6. **o que mudou** · as linhas datadas que o projeto já regista para este
 *      lugar.
 *
 * ---------------------------------------------------------------------------
 * O QUE SAIU, E PARA ONDE
 * ---------------------------------------------------------------------------
 * A maqueta é a especificação: o que ela não mostra não entra. Saíram daqui, e
 * cada um tem casa:
 *
 *   · **o instrumento dos mandatos** (a série do índice, a banda dos mandatos,
 *     os campos de cada mandato e as quatro notas) · é uma transcrição do estudo
 *     «Évora — Quinze Anos, Cinco Mandatos», e é nesse estudo que ele vive. A
 *     página do lugar leva a porta para o estudo, que é a secção 5;
 *   · **as contas do próprio município** e a ressalva do ano sem certificação ·
 *     são lidas da prestação de contas de um município, documento a documento, e
 *     cada uma tem a sua linha com o seu recibo. As ressalvas ficam nos recibos;
 *   · **a distância desenhada** e **a barra do ganho contra o país** · duas
 *     comparações desenhadas de valores que os cartões já mostram. A comparação
 *     com o limite legal passa a dizer-se por palavras, na leitura e na régua do
 *     cartão do índice;
 *   · **a faixa, a leitura breve e o mapa localizador** · a faixa e a leitura
 *     breve eram a segunda e a terceira apresentação dos mesmos oito números; o
 *     mapa da unidade é matéria da página do distrito (B3), e a página dos
 *     lugares leva o mapa inteiro;
 *   · **as três saídas do fim** · o índice dos concelhos deixou de existir (é a
 *     página dos lugares), e as outras duas eram um menu com nome de prova.
 *
 * ---------------------------------------------------------------------------
 * ORIGEM DE CADA ALGARISMO (DECISIONS §2.2)
 * ---------------------------------------------------------------------------
 *   toda a medição          <Claim/> → data-claim
 *   períodos                data-nonledger="data-de-referencia"
 *   datas de publicação     data-nonledger="data-do-repositorio"
 *   selos                   data-nonledger="proveniencia" (posto por <Provenance/>)
 * Não há mais nenhuma, e não há JavaScript nesta página.
 */
import Base from '../layouts/Base.astro';
import Frase from '../components/Frase.astro';
import Provenance from '../components/Provenance.astro';
import TituloDeTrabalho from '../components/TituloDeTrabalho.astro';
import CartaoDoLugar from '../components/lugar/CartaoDoLugar.astro';
import InstrumentoDosMandatos from '../components/lugar/InstrumentoDosMandatos.astro';
import { municipioPorSlug } from '../data/municipios.mjs';
import { ROTULOS_B1 } from '../data/rotulos-b1.mjs';
import { FONTE_DIGITAL_GERADA_POR_IA } from '../data/politica-ia.mjs';
import { pecasDoConcelho } from '../lib/inicio.mjs';
import {
  linhaDoLugar,
  leituraDoLugar,
  temasDoLugar,
  estudosDoLugar,
  mudancasDoLugar,
} from '../lib/lugar.mjs';
import { dataDaCasa } from '../lib/datas.mjs';
import { routePath } from '../lib/routes.mjs';
import { canonicalUrl, SITE_NAME, SITE_URL } from '../../site.config.mjs';
import { t } from '../i18n/strings.mjs';
import '../styles/cartao-medida.css';
import '../styles/lugar.css';

const { lang = 'pt', slug } = Astro.props;
const s = t(lang);
const r = ROTULOS_B1[lang];
const m = municipioPorSlug(slug);
if (!m) throw new Error(`município desconhecido: "${slug}"`);

const path = routePath('municipio', lang, { slug });
const nome = m.nome[lang] ?? m.nome.pt;

const linha = linhaDoLugar(slug, nome, lang);
const pecas = pecasDoConcelho(m);
const leitura = leituraDoLugar(m, pecas, lang, s);
const temas = temasDoLugar(pecas, leitura?.citadas ?? [], lang);
const estudos = estudosDoLugar(slug, lang);
const mudou = mudancasDoLugar(slug, pecas, lang);

const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: `${nome} · ${s.municipio.metaCauda}`,
  inLanguage: ['pt-PT', 'en'],
  about: { '@type': 'AdministrativeArea', name: m.nome.pt },
  /* Ver `src/data/politica-ia.mjs`: o termo do schema.org que diz a geração
     por IA. */
  digitalSourceType: FONTE_DIGITAL_GERADA_POR_IA,
  url: canonicalUrl(path),
  isPartOf: { '@type': 'WebSite', name: SITE_NAME, url: SITE_URL },
  publisher: { '@type': 'Organization', name: SITE_NAME, url: SITE_URL },
};
---

<Base
  lang={lang}
  path={path}
  title={`${nome} · ${s.municipio.metaCauda}`}
  description={`${s.municipio.metaDescricaoA}${nome}${s.municipio.metaDescricaoB}`}
  jsonld={jsonld}
>
  <div class="lugar-cabeca">
    {/* A LINHA DO LUGAR. Cada parte é uma porta para a página daquele lugar, e
        a última é esta página, marcada. Os separadores são desenho e não se
        ouvem. */}
    <p class="lugar-linha" data-lugar-linha={slug}>
      {
        linha.map((parte, i) => (
          <>
            {i > 0 && <span aria-hidden="true">›</span>}
            <a href={parte.destino} aria-current={parte.aqui ? 'page' : undefined} data-lugar>
              {parte.nome}
            </a>
          </>
        ))
      }
    </p>
    <h1 class="lugar-nome" data-lugar>{nome}</h1>
  </div>

  {
    leitura && (
      <p class="lugar-leitura">
        <Frase partes={leitura.partes} lang={lang} selos={true} />
      </p>
    )
  }

  <section class="lugar-sec" aria-labelledby="temas-k">
    <div class="sec-head">
      <h2 class="eyebrow" id="temas-k">{r.temas}</h2>
    </div>
    {
      temas.map((tema) => (
        <div class="lugar-tema" data-lugar-tema={tema.slug}>
          {/* O NOME DO TEMA É O NOME DE UMA ENTRADA DA CARTA DOS CONTEÚDOS,
              e não prosa da casa: vai com a marca que o diz, e a régua da voz
              confere, carácter a carácter, que o texto é um nome daquele
              ficheiro. Sem a marca, os dezoito nomes custavam ao inventário
              uma linha por nome e por edição. */}
          <h3 class="lugar-tema-k" data-nome="dominios">{tema.nome}</h3>
          <div class="lugar-cartoes">
            {tema.medidas.map((tile) => (
              <CartaoDoLugar tile={tile} lang={lang} s={s} />
            ))}
          </div>
        </div>
      ))
    }
  </section>

  {
    estudos.length > 0 && (
      <section class="lugar-sec" id="trabalhos" aria-labelledby="estudos-k">
        <div class="sec-head">
          <h2 class="eyebrow" id="estudos-k">
            {r.estudosDoLugar}
          </h2>
        </div>
        {estudos.map((e) => (
          <article class="lugar-estudo" data-estudo={e.work.slug} data-estudo-edicao={`${e.work.slug}/${e.edicao.lang}`}>
            <h3 class="lugar-estudo-k">
              <a href={e.rota}>
                <TituloDeTrabalho titulo={e.edicao.title} lang={lang} />
              </a>
              {e.edicao.lang !== lang && <span class="estudo-lingua"> {r.outraLingua}</span>}
            </h3>
            <p class="lugar-estudo-meta">
              <span>{e.tema}</span>
              <span>
                <span data-voz>{r.publicado}</span>{' '}
                <time datetime={e.data} data-nonledger="data-do-repositorio">
                  {dataDaCasa(e.data)}
                </time>
              </span>
            </p>
            {/* AS DUAS PRIMEIRAS FRASES DA LEITURA, COM OS SEUS SELOS. A maqueta
                desenha-as sem selo, e não pode ser: um valor que se rende sem a
                porta da sua linha fecha a construção, e é o portão de HTML que o
                diz («o valor da afirmação aparece sem selo para a sua própria
                linha»). O que a maqueta desenhou não passou por um portão; este
                passou. O ar que os dois selos precisam está na folha. */}
            <p class="lugar-estudo-leitura" data-verbatim={e.temLeitura ? undefined : e.work.verbatimDaAbertura?.[lang]}>
              <Frase partes={e.resumo} lang={lang} selos={true} />
            </p>
          </article>
        ))}
      </section>
    )
  }

  {
    mudou.length > 0 && (
      <section class="lugar-sec" aria-labelledby="mudou-k">
        <div class="sec-head">
          <h2 class="eyebrow" id="mudou-k">
            {r.mudou}
          </h2>
        </div>
        {/* CADA LINHA É UMA ENTRADA DO REGISTO, marcada como tal: a data e o
            motivo entram por `data-correcao-*`, que é a origem declarada de um
            campo do registo, e o portão compara os dois com a própria linha do
            livro-razão, carácter a carácter. A entrada leva o selo da sua linha,
            que é a porta para a história completa daquele valor. */}
        <ol class="lugar-mudou">
          {mudou.map((e) => (
            <li data-correcao-entrada={e.claim}>
              <span
                class="lugar-mudou-data"
                data-correcao-claim={e.claim}
                data-correcao-n={String(e.n)}
                data-correcao-campo="date"
              >
                {dataDaCasa(e.data)}
              </span>
              <p class="lugar-mudou-o-que">
                <span data-correcao-claim={e.claim} data-correcao-n={String(e.n)} data-correcao-campo="reason">
                  {e.motivo}
                </span>{' '}
                <Provenance id={e.claim} lang={lang} />
              </p>
            </li>
          ))}
        </ol>
      </section>
    )
  }

  {/* O INSTRUMENTO DOS MANDATOS DEVIA TER SAÍDO, E NÃO SAIU. A razão inteira
      está no componente: a célula do I77 do portão de HTML protege o nome de uma
      PESSOA cujas duas fontes oficiais divergem, e exige que ele se renda nesta
      página com o marcador. A regra de paragem da casa manda parar nessa parte e
      escrever o caso, e é o que o relatório do bloco faz. */}
  {m.tempo && <InstrumentoDosMandatos m={m} lang={lang} s={s} />}
</Base>
