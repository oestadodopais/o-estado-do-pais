---
/**
 * ===========================================================================
 * O ÍNDICE · `/indice` · `/en/index` (bloco R3, 04.10.2026)
 * ===========================================================================
 *
 * Uma página onde o leitor vê tudo o que o sítio tem, por secção, com uma porta para cada coisa:
 * o país e os seus temas, os lugares (as regiões, os distritos e as ilhas, e os 308 concelhos
 * dobrados por distrito), a União, os estudos por data com a pergunta de cada um, os números e as
 * fontes, o projeto, e «O que mudou». Nada aqui se escreve à mão: tudo vem de `indiceDoSitio()`
 * (`src/lib/indice.mjs`), que lê a tabela das rotas e os módulos que dão os caminhos às páginas.
 *
 * A FORMA (§3, ponto 4, do brief). Uma coluna em todas as larguras: o nome de cada secção por cima
 * das suas portas, listas simples (os nomes dos lugares em colunas de nomes, que continuam a ser uma
 * lista), e os concelhos em gavetas fechadas, uma por distrito ou ilha (`Gaveta.astro`, um
 * `<details>` que abre sem guião). Nenhum guião.
 *
 * UMA PORTA POR COISA. Nenhum destino se repete no corpo da página: a L1 do `check:lugar` conta as
 * páginas com um destino repetido fora do cabeçalho e do rodapé, e o índice não entra nessa conta.
 * É por isso que «O que mudou» leva só as linhas do livro-razão que mudaram, uma vez cada (a razão
 * está em `mudancasDoIndice()`), e que «Lugares» não se repete entre os temas.
 *
 * «O QUE MUDOU» TEM A FORMA DAS PÁGINAS DOS LUGARES (B1c): a data, o nome da medida, o valor antigo
 * riscado, a seta, o valor novo com a unidade e a marca da fonte, que é a porta para o recibo da
 * linha. Os dois valores entram por `data-correcao-*`, que o portão de HTML compara com o campo
 * `corrections` da própria linha, e a lista declara o seu âmbito (`data-mudou-ambito="indice"`),
 * para as células A1, A2, C1 e M3 do `check:pais` a medirem como medem as outras.
 */
import Base from '../layouts/Base.astro';
import Gaveta from '../components/inicio/Gaveta.astro';
import PortasDoIndice from '../components/indice/PortasDoIndice.astro';
import Provenance from '../components/Provenance.astro';
import CampoDaLinha from '../components/CampoDaLinha.astro';
import { indiceDoSitio } from '../lib/indice.mjs';
import { dataDaCasa } from '../lib/datas.mjs';
import { unidadeDaLinha } from '../i18n/unidades.mjs';
import { linguaDoRotuloDaFonte, linguaDoTituloDoDocumento } from '../i18n/lingua-dos-titulos.mjs';
import { routePath } from '../lib/routes.mjs';
import { t } from '../i18n/strings.mjs';
/* As listas e as gavetas são as da página dos lugares, e as linhas de «O que mudou» as da página
   de um lugar: as mesmas peças, com as mesmas folhas. */
import '../styles/inicio.css';
import '../styles/lugar.css';
import '../styles/indice.css';

const { lang = 'pt' } = Astro.props;
const s = t(lang);
const path = routePath('indice', lang);
const indice = indiceDoSitio(lang);
const seccoes = /** @type {const} */ (['pais', 'lugares', 'uniao', 'estudos', 'numeros', 'projeto']);
---

<Base lang={lang} path={path} title={s.indice.metaTitle} description={s.indice.metaDescription}>
  <h1 class="indice-titulo">{s.nav.indice}</h1>

  {seccoes.map((chave) => {
    const seccao = indice[chave];
    return (
      <section class="indice-secao" aria-labelledby={`indice-${chave}`} data-indice-seccao={chave}>
        <h2 class="indice-secao-titulo" id={`indice-${chave}`}>{seccao.titulo}</h2>
        <div class="indice-corpo">
          <PortasDoIndice portas={seccao.portas} lang={lang} />
          {chave === 'lugares' && (
            <>
              <h3 class="indice-subtitulo" data-indice-distritos>{indice.lugares.distritos.titulo}</h3>
              <PortasDoIndice portas={indice.lugares.distritos.portas} lang={lang} classe="indice-lista-de-lugares" />
              <h3 class="indice-subtitulo" data-indice-concelhos>{indice.lugares.concelhos.titulo}</h3>
              <div class="indice-concelhos">
                {indice.lugares.concelhos.grupos.map((g) => (
                  <Gaveta chave={`concelhos-${g.slug}`}>
                    <Fragment slot="nome"><span class="gaveta-nome" data-lugar data-indice-distrito={g.slug}>{g.nome}</span></Fragment>
                    <PortasDoIndice portas={g.portas} lang={lang} classe="indice-lista-de-lugares" />
                  </Gaveta>
                ))}
              </div>
            </>
          )}
        </div>
      </section>
    );
  })}

  {indice.mudou.mudancas.length > 0 && (
    <section class="indice-secao" aria-labelledby="indice-mudou" data-indice-seccao="mudou">
      <h2 class="indice-secao-titulo" id="indice-mudou">{indice.mudou.titulo}</h2>
      <div class="indice-corpo">
        <ol class="lugar-mudou" data-mudou-ambito="indice">
          {indice.mudou.mudancas.map((e) => (
            <li data-mudanca="correcao" data-correcao-entrada={e.claim}>
              <time
                class="lugar-mudou-data"
                datetime={e.data}
                data-correcao-claim={e.claim}
                data-correcao-n={String(e.n)}
                data-correcao-campo="date"
              >
                {dataDaCasa(e.data)}
              </time>
              {/* O NOME E A UNIDADE COM AS MARCAS DO REGISTO (`RegistoCorrecoes.astro`): o nome
                  declarado com `data-nome`, o nome lido de um campo da linha pelo `CampoDaLinha`
                  com a língua da fonte, e a unidade pelo `CampoDaLinha` do campo `unit`. A página de
                  um lugar só rende o primeiro e escreve a unidade sem marca; aqui nenhum nome cai e
                  a unidade tem origem. */}
              <p class="lugar-mudou-o-que">
                {e.nome?.fonte && (
                  <span class="lugar-mudou-nome" data-nome={e.nome.fonte} data-de-linha={e.claim}>
                    {e.nome.texto}
                  </span>
                )}
                {e.nome?.campo && (
                  <CampoDaLinha
                    id={e.claim}
                    campo={e.nome.campo}
                    valor={e.nome.texto}
                    lang={lang}
                    class="lugar-mudou-nome"
                    lingua={e.nome.campo === 'name'
                      ? linguaDoRotuloDaFonte(e.nome.texto, lang)
                      : linguaDoTituloDoDocumento(e.nome.texto, lang)}
                  />
                )}
                <span class="lugar-mudou-par">
                  <s data-correcao-claim={e.claim} data-correcao-n={String(e.n)} data-correcao-campo="old_value">
                    {e.antes}
                  </s>
                  {' → '}
                  <span data-correcao-claim={e.claim} data-correcao-n={String(e.n)} data-correcao-campo="new_value">
                    {e.depois}
                  </span>
                  {' '}
                  {e.unidade && (
                    <CampoDaLinha
                      id={e.claim}
                      campo="unit"
                      valor={unidadeDaLinha(e.unidade, lang).texto}
                      lang={lang}
                      lingua={unidadeDaLinha(e.unidade, lang).lingua}
                    />
                  )}
                  <Provenance id={e.claim} lang={lang} />
                </span>
              </p>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )}
</Base>
