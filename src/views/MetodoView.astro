---
/**
 * Método — dez regras, cada uma com o seu mecanismo e a sua prova de hoje.
 *
 * DISPOSIÇÃO A (IDENTIDADE §3), a mesma que esta página sempre teve: coluna de
 * rótulo com o número e o nome da regra, corpo a 68ch. O instrumento entra
 * dentro da página, a toda a largura, como os dois instrumentos entram na
 * primeira página e o mapa de mandatos entra na página do município. Não há
 * quarta disposição.
 *
 * NENHUM NÚMERO ESCRITO À MÃO. O texto das regras não pode trazer algarismos —
 * é o portão que o obriga — e todos os números vêm de `src/lib/prova.mjs`,
 * marcados `data-prova` e embrulhados na sua porta.
 *
 * O REGISTO DE CORREÇÕES NÃO ESTÁ AQUI. Mudou para `/correcoes`, que é a casa
 * única da política. A âncora `#correcoes` fica: era um endereço público, e as
 * páginas que estiveram no ar ganham reencaminhamento e não apagamento
 * (§1.29). Quem lá aterre encontra a regra 7 e a porta para o registo.
 *
 * ---------------------------------------------------------------------------
 * V2 (`design/DECISAO.md`, direção S; IDENTIDADE.md §11)
 * ---------------------------------------------------------------------------
 * A direção S manda para esta página o que ela já tinha: disposição A, o
 * mecanismo a toda a largura entre a abertura e as dez regras, e a prova de
 * cada regra numa linha monoespaçada com as suas portas. Nada disto mudou de
 * lugar, e o texto governado das dez regras (`src/data/metodo.mjs`) não foi
 * tocado: mexer-lhe obrigaria a §1.43 a nomear `metodo` com um resumo novo, e
 * não há rótulo de prova que precise de mudar.
 *
 * O que mudou é de leitura, e está na folha: o ponto médio entre duas provas e
 * o fio que faz de porta debaixo de cada número do sítio estavam em
 * `--rule-strong`, que mede 1,83:1 sobre papel. Uma porta que se não vê é uma
 * porta que não existe, e é a mesma correção que a v2 fez ao selo.
 */
import Base from '../layouts/Base.astro';
import Frase from '../components/Frase.astro';
import ValorDaProva from '../components/ValorDaProva.astro';
import InstrumentoMecanismo from '../components/InstrumentoMecanismo.astro';
import { REGRAS, ABERTURA } from '../data/metodo.mjs';
import { prova, CAMINHO_DA_PROVA } from '../lib/prova.mjs';
import { routePath } from '../lib/routes.mjs';
import { t } from '../i18n/strings.mjs';

const { lang = 'pt' } = Astro.props;
const s = t(lang);
const path = routePath('metodo', lang);
const p = prova(lang);

const destino = (l) => (l.prova ? CAMINHO_DA_PROVA : routePath(l.rota, lang));
---

<Base lang={lang} path={path} title={s.metodo.metaTitle} description={s.metodo.metaDescription}>
  <div style="padding-top:clamp(20px,3vw,34px)">
    <h1>{s.metodo.h1}</h1>
    <p class="lede" style="margin-top:14px">{ABERTURA[lang]}</p>
  </div>

  <!-- ===================================== o mecanismo, desenhado -->
  <div style="margin-top:clamp(26px,3.4vw,40px)">
    <InstrumentoMecanismo lang={lang} />
  </div>

  <!-- ===================================== as dez regras -->
  <div style="margin-top:clamp(24px,3vw,36px)">
    {
      REGRAS.map((r) => (
        <section class="metodo-secao regra" id={r.id}>
          <div class="regra-cabeca">
            <span class="regra-n" data-nonledger="numeracao">
              {r.n}
            </span>
            <h2>{r.titulo[lang]}</h2>
          </div>

          <div class="metodo-corpo">
            <p class="metodo-p">
              <Frase partes={r.regra[lang]} lang={lang} />
            </p>

            <div class="regra-linha">
              <span class="regra-k">{s.metodo.mecanismoK}</span>
              <p class="regra-v">
                <Frase partes={r.mecanismo[lang]} lang={lang} />
              </p>
            </div>

            {r.limite && (
              <div class="regra-linha">
                <span class="regra-k">{s.metodo.limiteK}</span>
                <p class="regra-v">
                  <Frase partes={r.limite[lang]} lang={lang} />
                </p>
              </div>
            )}

            <div class="regra-linha regra-linha-prova">
              <span class="regra-k">{s.metodo.provaK}</span>
              <p class="regra-v regra-prova">
                {r.prova.map((v, i) => (
                  <span class="regra-prova-item">
                    {i > 0 && <span class="regra-sep" aria-hidden="true"> · </span>}
                    {v.rotulo[lang]}:{' '}
                    <ValorDaProva chave={v.chave} item={p[v.chave]} vazio={v.vazio} lang={lang} />
                  </span>
                ))}
                {r.provaNota && <span class="regra-prova-nota">{r.provaNota[lang]}</span>}
              </p>
            </div>

            {r.ligacoes.length > 0 && (
              <p class="regra-portas">
                {r.ligacoes.map((l) => (
                  <a href={destino(l)}>{l.rotulo[lang]} →</a>
                ))}
              </p>
            )}
          </div>
        </section>
      ))
    }
  </div>
</Base>
