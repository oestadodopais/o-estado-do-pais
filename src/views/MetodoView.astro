---
/** MET1: quatro secções, recibo real e percurso legível sem JavaScript. */
import Base from '../layouts/Base.astro';
import Frase from '../components/Frase.astro';
import Claim from '../components/Claim.astro';
import CampoDaLinha from '../components/CampoDaLinha.astro';
import { METODO as m } from '../data/metodo.mjs';
import { DOCUMENTO_DA_POLITICA } from '../data/politica-ia.mjs';
import { prova } from '../lib/prova.mjs';
import { getClaim } from '../lib/ledger.mjs';
import { routePath } from '../lib/routes.mjs';
import { t } from '../i18n/strings.mjs';
import { unidadeDaLinha } from '../i18n/unidades.mjs';
import { linguaDaFonte, linguaDoTituloDoDocumento, linguaDoLocalizador } from '../i18n/lingua-dos-titulos.mjs';
import { nomeNoRecibo } from '../lib/o-que-e-o-numero.mjs';
import '../styles/metodo.css';
const { lang = 'pt' } = Astro.props;
const s = t(lang), p = prova(lang), c = getClaim(m.recibo.id);
const unidade = unidadeDaLinha(c.unit, lang);
const localizadorIngles = lang === 'en' && c.document.locator_en;
const campoLocalizador = localizadorIngles ? 'document.locator_en' : 'document.locator';
const localizador = localizadorIngles || c.document.locator;
if (!localizador) throw new Error('MET1: falta localizador na edição ' + lang);
const Documento = c.document.url ? 'a' : 'span';
const ids = ['conferir-um-numero', 'percurso', 'marcas', 'correcoes'];
const tipos = ['modelo', 'programa', 'documento', 'modelo', 'modelo', 'programa', 'leitura', 'leitura', 'programa', 'documento'];
---
<Base lang={lang} path={routePath('metodo', lang)} title={s.metodo.metaTitle} description={s.metodo.metaDescription}>
  <div class="met1-cabeca"><h1>{s.metodo.h1}</h1></div>
  <div class="met1">
    <section class="metodo-secao" id={ids[0]}>
      <div class="regra-cabeca"><h2>{m.titulos[lang][0]}</h2></div>
      <div class="metodo-corpo">
        <p class="metodo-p" data-met1="abrir"><Frase partes={m.abrir[lang]} lang={lang} provas={p} /></p>
        <div class="met1-recibo" data-met1-recibo={c.id} id="livro-razao">
          <p class="met1-medida"><span data-met1="recibo-nome">{nomeNoRecibo(c.id, lang).texto}</span>{' · '}<CampoDaLinha id={c.id} campo="reference_date" valor={c.reference_date} lang={lang} /></p>
          <p class="met1-valor"><Claim id={c.id} lang={lang} chip={true}><span slot="cauda">{' '}<CampoDaLinha id={c.id} campo="unit" valor={unidade.texto} lang={lang} lingua={unidade.lingua} /></span></Claim></p>
          <dl>
            <div><dt data-met1="campo-0">{m.campos[lang][0]}</dt><dd><a href={c.source_url} rel="noopener noreferrer external"><CampoDaLinha id={c.id} campo="source" valor={c.source} lang={lang} lingua={linguaDaFonte(c.source, lang)} /></a></dd></div>
            <div><dt data-met1="campo-1">{m.campos[lang][1]}</dt><dd><Documento href={c.document.url} rel={c.document.url ? "noopener noreferrer external" : undefined}><CampoDaLinha id={c.id} campo="document.title" valor={c.document.title} lang={lang} lingua={linguaDoTituloDoDocumento(c.document.title, lang)} /></Documento></dd></div>
            <div><dt data-met1="campo-2">{m.campos[lang][2]}</dt><dd><CampoDaLinha id={c.id} campo={campoLocalizador} valor={localizador} lang={lang} lingua={localizadorIngles ? null : linguaDoLocalizador(c.document.locator, c.document.title, lang)} /></dd></div>
            <div><dt data-met1="campo-3">{m.campos[lang][3]}</dt><dd><blockquote><CampoDaLinha id={c.id} campo="excerpt" valor={c.excerpt} lang={lang} lingua={linguaDoTituloDoDocumento(c.document.title, lang)} /></blockquote></dd></div>
            <div><dt data-met1="campo-4">{m.campos[lang][4]}</dt><dd><CampoDaLinha id={c.id} campo="access_date" valor={c.access_date} lang={lang} /></dd></div>
          </dl>
        </div>
        <p class="metodo-p" data-met1="divida"><Frase partes={m.divida[lang]} lang={lang} provas={p} /></p>
      </div>
    </section>
    <section class="metodo-secao" id={ids[1]}>
      <div class="regra-cabeca"><h2>{m.titulos[lang][1]}</h2></div>
      <div class="metodo-corpo" id="releitura">
        <ol class="met1-percurso">
          {m.passos.map((passo, i) => (
            <li class={`met1-passo met1-${tipos[i]}`}>
              <svg class="met1-maquina" viewBox="0 0 160 100" aria-hidden="true" focusable="false">
                <path class="met1-trilho" d="M0 50H22M118 50H160" />
                <rect class="met1-no" x="22" y="20" width="96" height="60" rx={tipos[i] === 'modelo' || tipos[i] === 'leitura' ? '18' : '3'} />
                {tipos[i] === 'programa' ? <><path d="m53 36-12 14 12 14m34-28 12 14-12 14m-22 5 10-38" /></> : tipos[i] === 'modelo' ? <><circle cx="53" cy="43" r="4" /><circle cx="85" cy="43" r="4" /><path d="M49 59Q69 72 89 59" /></> : tipos[i] === 'leitura' ? <><circle cx="64" cy="46" r="14" /><path d="m74 57 16 15M57 46l5 5 10-11" /></> : <><path d="M49 32h31l10 10v27H49ZM80 32v11h10M56 51h26M56 59h26" /></>}
                <circle class="met1-conferencia" cx="118" cy="76" r="12" />
                <path class="met1-visto" d="m112 76 4 4 8-9" />
                <circle class="met1-sinal" cx="8" cy="50" r="3" style={`animation-delay:${i * 0.12}s`} />
              </svg>
              <p data-met1={`passo-${i}`}><Frase partes={passo[lang]} lang={lang} provas={p} /></p>
            </li>
          ))}
        </ol>
      </div>
    </section>
    <section class="metodo-secao" id={ids[2]}>
      <div class="regra-cabeca"><h2>{m.titulos[lang][2]}</h2></div>
      <div class="metodo-corpo" id="por-confirmar">
        <ul class="met1-marcas">{m.marcas.map((marca,i) => <li id={i === 4 ? 'a-cor' : undefined} data-met1={`marca-${i}`}><Frase partes={marca[lang]} lang={lang} provas={p} /></li>)}</ul>
      </div>
    </section>
    <section class="metodo-secao" id={ids[3]}>
      <div class="regra-cabeca"><h2>{m.titulos[lang][3]}</h2></div>
      <div class="metodo-corpo" id="politica-de-ia">
        <p class="metodo-p" data-met1="mudanca"><a href={routePath('correcoes',lang)}><Frase partes={m.mudanca[lang]} lang={lang} provas={p} /></a></p>
        <p class="metodo-p" data-met1="autoria" data-frase-da-politica={lang}><Frase partes={m.autoria[lang]} lang={lang} provas={p} /></p>
        <p class="met1-portas"><a data-met1="ligacao-0" href={routePath('agenda',lang)}>{m.ligacoes[lang][0]}</a>{' '}<a data-met1="ligacao-1" href={DOCUMENTO_DA_POLITICA}>{m.ligacoes[lang][1]}</a></p>
      </div>
    </section>
  </div>
</Base>
