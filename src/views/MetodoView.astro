---
/**
 * Método.
 *
 * O texto português é cópia final da direção e está em src/data/metodo.mjs,
 * transcrito sem alterações. O inglês é tradução do mesmo texto e aguarda
 * revisão da direção.
 *
 * Os marcadores por resolver — três [a confirmar] e um [a verificar] — ficam à
 * vista, com o mesmo aspecto do marcador do livro-razão. Não se escondem nem
 * se resolvem por conta própria.
 *
 * O registo de correções entra dentro da secção «Correções», e é lido do
 * livro-razão, não escrito à mão.
 */
import Base from '../layouts/Base.astro';
import RegistoCorrecoes from '../components/RegistoCorrecoes.astro';
import Frase from '../components/Frase.astro';
import { SECOES } from '../data/metodo.mjs';
import { routePath } from '../lib/routes.mjs';
import { t } from '../i18n/strings.mjs';

const { lang = 'pt' } = Astro.props;
const s = t(lang);
const path = routePath('metodo', lang);
---

<Base lang={lang} path={path} title={s.metodo.metaTitle} description={s.metodo.metaDescription}>
  <div style="padding-top:clamp(20px,3vw,34px)">
    <h1>{s.metodo.h1}</h1>
  </div>

  {
    lang !== 'pt' && (
      <p class="aviso-editorial" style="margin-top:22px">
        {s.metodo.avisoTraducao}
      </p>
    )
  }

  <div style="margin-top:clamp(30px,4vw,48px)">
    {
      SECOES.map((sec) => (
        <section class="metodo-secao" id={sec.id} style="padding-top:clamp(24px,3.2vw,34px)">
          <div>
            <h2>{sec.titulo[lang]}</h2>
            {/* A secção do livro-razão promete que o selo é a porta para a
                linha. A ligação vai na coluna do rótulo, e não no meio do
                texto: a cópia do Método é da direção e transcreve-se sem
                alterações. */}
            {sec.id === 'livro-razao' && (
              <a class="ligacao-dados" href={routePath('livro', lang)}>
                {s.metodo.livroLink} →
              </a>
            )}
          </div>
          <div class="metodo-corpo">
            {sec.blocos[lang].map((bloco) => {
              if (bloco.tipo === 'p') {
                return (
                  <p class="metodo-p">
                    <Frase partes={bloco.partes} lang={lang} />
                  </p>
                );
              }
              if (bloco.tipo === 'ol') {
                return (
                  <ol class="metodo-lista metodo-lista-num">
                    {bloco.itens.map((item) => (
                      <li>
                        <Frase partes={item} lang={lang} />
                      </li>
                    ))}
                  </ol>
                );
              }
              return (
                <ul class="metodo-lista">
                  {bloco.itens.map((item) => (
                    <li>
                      <Frase partes={item} lang={lang} />
                    </li>
                  ))}
                </ul>
              );
            })}

            {sec.registoDeCorrecoes && <RegistoCorrecoes lang={lang} />}
          </div>
        </section>
      ))
    }
  </div>
</Base>
