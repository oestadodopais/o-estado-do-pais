---
import LigacaoDoDossie from '../components/dossies/LigacaoDoDossie.astro';
import PortaDoEstudoEO1 from '../components/PortaDoEstudoEO1.astro';
/**
 * UMA EXPLICAÇÃO, em `/explicacoes/<slug>` e `/en/explainers/<slug>` (bloco EX1, 05.10.2026, o ponto 3 do mandato).
 *
 * A forma do §5, ponto 3, do brief: o título é a pergunta do leitor; a abertura responde com os números maiores;
 * as secções explicam a dinâmica, cada uma com os seus números e, onde a casa já tem a forma, uma figura; «O que
 * isto não diz» fecha; as portas declaradas vão no fim (os recibos e, desde o EX1-b, a página de um tema). Rende o que
 * `explicacaoResolvida()` devolve e mais
 * nada: cada número é um `<Claim>` com o selo ao lado, cada ano é a `<DataDaLinha>` de uma linha, cada nome de
 * uma função é o nome declarado da linha, e as frases que comparam só aparecem enquanto os números lhes dão
 * razão.
 *
 * AS PALAVRAS DECLARADAS levam `data-explicacao-declarado`: saem do inventário das frases porque mudam com os
 * ramos e com as condições, e uma atualização dos dados não pode fechar a construção; quem as confere é a célula
 * da explicação (`tests/explicacoes/explicacao.mjs`), que o `check:voz` corre na mesma corrida, e o detetor da
 * autorreferência continua a lê-las. A mobília da página (o título de «O que isto não diz», o da lista dos
 * números de uma figura, a porta) é da casa e está no inventário.
 */
import CorpoDaExplicacao from '../components/explicacoes/CorpoDaExplicacao.astro';
import Base from '../layouts/Base.astro';
import FraseDaExplicacao from '../components/explicacoes/FraseDaExplicacao.astro';
/* EX4-c (21.10.2026): a porta do fim para um estudo leva o título como a casa o dá a um estudo, com a marca e a língua. */
import { explicacaoResolvida } from '../lib/explicacoes.mjs';
import { routePath } from '../lib/routes.mjs';
import { t } from '../i18n/strings.mjs';
import { SITE_NAME } from '../../site.config.mjs';
import '../styles/explicacoes.css';

const { slug, lang = 'pt' } = Astro.props;
const s = t(lang);
const e = explicacaoResolvida(slug, lang);
const path = routePath('explicacao', lang, { slug });
---

<Base lang={lang} path={path} title={`${e.tituloTexto} · ${SITE_NAME}`} description={e.tituloTexto}>
  <article class="explicacao" data-explicacao={slug}>
    <h1 class="explicacao-titulo" data-explicacao-titulo={slug} data-explicacao-declarado><FraseDaExplicacao partes={e.titulo} lang={lang} selos={false} /></h1>
    <LigacaoDoDossie tipo="explicacao" slug={slug} lang={lang} />
    <CorpoDaExplicacao e={e} lang={lang} />
    {slug === 'dinheiro-do-estado-2026' && <PortaDoEstudoEO1 lang={lang} />}
  </article>
</Base>
