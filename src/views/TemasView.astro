---
import Base from '../layouts/Base.astro';
import TemasDoPais from '../components/TemasDoPais.astro';
import { ROTULOS_B1 } from '../data/rotulos-b1.mjs';
import { routePath } from '../lib/routes.mjs';
import { t } from '../i18n/strings.mjs';
import '../styles/pais.css';
const { lang = 'pt' } = Astro.props;
const r = ROTULOS_B1[lang];
const s = t(lang);
---
<Base lang={lang} path={routePath('temas', lang)} title={s.temas.metaTitle} description={s.temas.metaDescription}>
  <h1 class="temas-titulo">{r.temas}</h1>
  <TemasDoPais lang={lang} />
</Base>
