---
/**
 * O ÍNDICE DO LIVRO-RAZÃO DOS CONCELHOS — `/livro-razao/concelhos`.
 *
 * ---------------------------------------------------------------------------
 * ERA UMA PÁGINA COM TUDO, E PASSA A SER UM ÍNDICE (diretor, 26.08.2026)
 * ---------------------------------------------------------------------------
 * A decisão D6 tirou as linhas dos concelhos do índice principal do livro-razão
 * porque 2 500 linhas numa página não se leem. Com os dados do motor, esta
 * página ficou com 2 416 linhas e **227 008 px de altura a 1280** (352 735 px a
 * 390): o motor de captura não a fotografava inteira, e o problema que a decisão
 * resolveu no índice principal reapareceu aqui, uma ordem de grandeza pior.
 *
 * Passa a haver uma página de livro-razão por concelho, e esta é o índice delas:
 * a pesquisa em cima, com o destino a ser a página de livro-razão do concelho;
 * as três contagens do conjunto, que são chaves da prova; e a lista por
 * distrito, uma linha por concelho, com a mesma ordem da Carta que o índice dos
 * 308 usa.
 *
 * ---------------------------------------------------------------------------
 * A LINHA DE UM CONCELHO NÃO LEVA A SUA CONTAGEM, E A RAZÃO É A REGRA DA CASA
 * ---------------------------------------------------------------------------
 * «Bragança · 8 linhas» seria um número do próprio sítio, e a `IDENTIDADE.md`
 * §10 exige que um número do próprio sítio entre por `data-prova`, com a sua
 * porta e com o portão a recontá-lo por conta própria. Aqui seriam 308 números,
 * um por linha da lista: ou 308 chaves na tabela da prova, ou 308 algarismos sem
 * porta, que é o que o portão fecha (fechou, com um só «308» dentro do título
 * deste estudo). Nenhum dos motivos de `data-nonledger` descreve uma contagem.
 *
 * O que a lista dá é o nome e a porta; quantas linhas cada concelho tem lê-se na
 * página dele, contando-as. As três contagens do CONJUNTO ficam onde têm porta,
 * aqui em cima.
 */
import Base from '../layouts/Base.astro';
import ValorDaProva from '../components/ValorDaProva.astro';
import Pesquisa from '../components/inicio/Pesquisa.astro';
import Claim from '../components/Claim.astro';
import CampoDaLinha from '../components/CampoDaLinha.astro';
import { linhasDosConcelhos, ESTUDO_DOS_CONCELHOS } from '../lib/livro-concelhos.mjs';
import { provenienciaIncompleta } from '../lib/ledger.mjs';
import { concelhos as concelhosDaCarta, coberturaDistingue } from '../lib/inicio.mjs';
import { MUNICIPIOS, DISTRITOS } from '../data/caop-centroids.mjs';
import { MUNICIPIOS_COM_PAGINA } from '../data/municipios.mjs';
import { studyLabel } from '../data/studies.mjs';
import { routePath } from '../lib/routes.mjs';
import { prova } from '../lib/prova.mjs';
import { t } from '../i18n/strings.mjs';
import '../styles/linha.css';
import '../styles/municipio.css';

const { lang = 'pt' } = Astro.props;
const s = t(lang);
const p = prova(lang);
const path = routePath('livroConcelhos', lang);

/* Que concelhos têm linhas deste estudo. É a mesma conta da página de cada um, e
   é dela que sai o estado de cada linha da lista. */
const { grupos, naoDeclaradas } = linhasDosConcelhos();
const comLinhas = new Map(grupos.map((g) => [g.slug, g]));

/**
 * A REFERÊNCIA DO ESTUDO: A LINHA QUE NÃO É DE NENHUM CONCELHO.
 *
 * O teto legal de endividamento é uma constante da lei (artigo 52.º da Lei n.º
 * 73/2013), lida no Anuário Financeiro dos Municípios Portugueses, e é contra
 * ela que os 307 índices de dívida se calculam. Não é uma medida de um concelho:
 * é a referência do estudo inteiro. Atravessou como linha do estudo dos
 * concelhos a 26.08.2026, quando o manifesto do motor lhe mudou o `study` para
 * `concelhos-2026` — até então o seu selo dizia, nas 308 páginas, o nome do
 * estudo de Évora, que é onde ela tinha sido estabelecida.
 *
 * Fica aqui, no índice, com nome e por extenso: uma linha do estudo que não
 * apareça em página nenhuma é uma linha que o sítio guarda e não mostra, e a
 * contagem do topo conta-a. `naoDeclaradas` é a lista das linhas do estudo que
 * nenhuma entrada de concelho declara, e é esse o estado desenhado (IDENTIDADE
 * §7): hoje é uma, amanhã é a que o exportador escrever.
 */
const referencia = naoDeclaradas;

/* A lista por distrito, na ordem da Carta, como o índice dos 308. Nada é
   reordenado à mão: o grupo é o campo que a Carta dá ao concelho. */
const porIndice = new Map(MUNICIPIOS_COM_PAGINA.map((m) => [m.caopIndex, m]));
const distritos = DISTRITOS.map((nome) => ({ nome, entradas: [] }));
MUNICIPIOS.forEach((m, i) => {
  const entrada = porIndice.get(i) ?? null;
  distritos[m[1]].entradas.push({
    nome: entrada ? (entrada.nome[lang] ?? entrada.nome.pt) : m[0],
    slug: entrada?.slug ?? null,
    temLinhas: Boolean(entrada && comLinhas.has(entrada.slug)),
  });
});
const comEntradas = distritos.filter((d) => d.entradas.length > 0);

/* A pesquisa é a peça da casa, com o destino desta página: a página de
   livro-razão do concelho. Um concelho sem linhas deste estudo não é porta. */
const resultados = concelhosDaCarta().map((c) => ({
  ...c,
  pagina: comLinhas.has(c.slug) ? c.pagina : null,
}));
const destinoDoConcelho = (c) =>
  comLinhas.has(c.slug) ? routePath('livroConcelho', lang, { slug: c.slug }) : null;

/* A etiqueta de estado de cada linha, pela mesma regra do índice dos 308 (item
   E8): com todos os concelhos a terem linhas, «tem página» dizia o mesmo 616
   vezes, e as três contagens em cima já dizem o estado do todo. */
const distingue = coberturaDistingue(resultados);
---

<Base
  lang={lang}
  path={path}
  title={s.livroConcelhos.metaTitle}
  description={s.livroConcelhos.metaDescription}
>
  <div class="linha-cabeca">
    <span class="eyebrow">{s.livro.eyebrow}</span>
    <h1>{studyLabel(ESTUDO_DOS_CONCELHOS, lang)}</h1>
    <p class="lede" style="margin-top:16px">{s.livroConcelhos.lede}</p>
    <p class="livro-contas">
      <ValorDaProva chave="concelhos_linhas" item={p.concelhos_linhas} lang={lang} />
      {' '}{s.livroConcelhos.contaLinhas}
      {' · '}
      <ValorDaProva chave="concelhos_no_livro" item={p.concelhos_no_livro} lang={lang} />
      {' '}{s.livroConcelhos.contaConcelhos}
      {' · '}
      <ValorDaProva
        chave="concelhos_linhas_completas"
        item={p.concelhos_linhas_completas}
        lang={lang}
      />
      {' '}{s.livroConcelhos.contaCompletas}
    </p>

    {/* A CAIXA CHEGA COM O SCRIPT, E SÓ COM ELE: os resultados saem do servidor
        escondidos e é `public/js/municipios.js` que os acende. Sem script, esta
        página é a lista por distrito, inteira, com as suas portas. */}
    <div class="concelhos-pesquisa" data-pesquisa-bloco hidden>
      <Pesquisa s={s} concelhos={resultados} destino={destinoDoConcelho} />
    </div>
  </div>

  <div class="concelhos">
    {
      comEntradas.map((d) => (
        <section class="concelhos-grupo">
          <h2 class="concelhos-grupo-k">{d.nome}</h2>
          <ul class="concelhos-lista">
            {d.entradas.map((e) =>
              e.temLinhas ? (
                <li class="concelho concelho-com-pagina">
                  {/* A seta entra na porta, pela mesma razão do índice dos 308. */}
                  <a href={routePath('livroConcelho', lang, { slug: e.slug })}>{e.nome} →</a>
                  {distingue && (
                    <span class="concelho-estado">
                      <span data-cobertura="com-pagina">{s.cobertura.temPagina}</span>
                    </span>
                  )}
                </li>
              ) : (
                <li class="concelho">
                  <span class="concelho-nome">{e.nome}</span>
                  {distingue && (
                    <span class="concelho-estado" data-cobertura="sem-linha">
                      {s.cobertura.semLinhaAinda}
                    </span>
                  )}
                </li>
              ),
            )}
          </ul>
        </section>
      ))
    }
  </div>

  {referencia.length > 0 && (
    <div class="linha" style="margin-top:clamp(26px,3.4vw,40px)">
      <div class="linha-corpo">
        <section class="linha-bloco" aria-labelledby="referencia" data-concelho-referencia>
          <h2 class="linha-bloco-titulo livro-grupo-k" id="referencia">
            {s.livroConcelhos.referenciaK}
          </h2>
          <div class="livro-lista">
            {referencia.map((c) => (
              <div
                class="livro-item"
                data-estado={provenienciaIncompleta(c) ? 'por-confirmar' : 'completa'}
              >
                <span class="livro-item-valor">
                  <Claim id={c.id} lang={lang} as="span" class="livro-item-num" chip={true} />
                </span>
                <div class="livro-item-corpo">
                  <code class="livro-item-id" data-linha-claim={c.id} data-linha-campo="id">
                    {c.id}
                  </code>
                  <div class="livro-item-meta">
                    <CampoDaLinha
                      id={c.id}
                      campo="unit"
                      valor={c.unit}
                      lang={lang}
                      class="livro-item-unidade"
                      originalPt={true}
                    />
                    {c.source !== null && c.source !== undefined && (
                      <span class="livro-item-campo">
                        <span class="livro-item-k">{s.prov.fonte}</span>{' '}
                        <CampoDaLinha id={c.id} campo="source" valor={c.source} lang={lang} />
                      </span>
                    )}
                    {c.access_date !== null && c.access_date !== undefined && (
                      <span class="livro-item-campo">
                        <span class="livro-item-k">{s.prov.lido}</span>{' '}
                        <CampoDaLinha
                          id={c.id}
                          campo="access_date"
                          valor={c.access_date}
                          lang={lang}
                        />
                      </span>
                    )}
                  </div>
                </div>
              </div>
            ))}
          </div>
        </section>
      </div>
    </div>
  )}

  <div class="prov" style="margin-top:clamp(30px,4vw,44px)">
    <div class="prov-row">
      <span class="prov-study">{s.livro.seloK}</span>
      <span class="prov-vals">
        <span class="src-chip src-chip-amostra" aria-hidden="true"></span>
        {s.livro.seloCheio}
        {' · '}
        <span class="src-chip src-chip-amostra is-unverified" aria-hidden="true"></span>
        {s.livro.seloTracejado}
      </span>
    </div>
  </div>

  <p class="rodape-nav" style="margin-top:14px">
    <a href={routePath('livro', lang)}>{s.livroConcelhos.voltarLivro} →</a>
  </p>

  <script src="/js/municipios.js" defer is:inline></script>
</Base>
