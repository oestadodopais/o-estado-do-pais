---
/**
 * O RECIBO DE UMA LINHA DE SÉRIE (bloco UE1, 29.09.2026).
 *
 * É o destino da porta da faixa da União num cartão: os 28 pontos da série numa
 * tabela (o país, o valor, a marca da fonte), a fonte e a proveniência como nos
 * recibos das linhas, e as duas linhas de que a série é gémea. Disposição B da
 * `IDENTIDADE.md` §3, como o recibo de uma linha: o corpo com a prova, e a
 * coluna do aparelho.
 *
 * NENHUM ALGARISMO SEM ORIGEM. Cada valor vai por `PontoDaSerie`
 * (`data-ponto`), cada campo por `CampoDaSerie` (`data-serie-campo`), cada data
 * por `DataDaSerie` (o motivo `data-da-linha`, recomposto pelo `check:formas`),
 * e cada nome de país por `NomeDoPais` (`data-pais`), que o lê da tabela de
 * autoridade do Serviço das Publicações. O portão de HTML confere os quatro.
 *
 * A ORDEM DOS PONTOS É A DA SÉRIE: a protocolar da tabela dos nomes, e a União
 * no fim. Não se ordena por valor, porque o recibo é a prova do que a fonte
 * publica, e a ordem por valor é a da faixa do cartão.
 */
import Base from '../layouts/Base.astro';
import NomeDaMedida from '../components/NomeDaMedida.astro';
import PontoDaSerie from '../components/serie/PontoDaSerie.astro';
import NomeDoPais from '../components/serie/NomeDoPais.astro';
import CampoDaSerie from '../components/serie/CampoDaSerie.astro';
import DataDaSerie from '../components/serie/DataDaSerie.astro';
import { getClaim } from '../lib/ledger.mjs';
import { getSerie, pontosDaSerie, paisesDaUniao, fonteDaTabelaDosPaises, AGREGADO_DA_UNIAO } from '../lib/series.mjs';
import { nomeDoCartao } from '../lib/nomes.mjs';
import { routePath, LANGS } from '../lib/routes.mjs';
import { unidadeDaLinha } from '../i18n/unidades.mjs';
import { studyLabel } from '../data/studies.mjs';
import { SITE_NAME } from '../../site.config.mjs';
import { t } from '../i18n/strings.mjs';
import '../styles/linha.css';
import '../styles/serie.css';

const { lang = 'pt', id } = Astro.props;
const s = t(lang);
const serie = getSerie(id);
const linhaPt = getClaim(String(serie.linha_de_portugal));
const linhaUe = getClaim(String(serie.linha_da_uniao));
const pontos = pontosDaSerie(serie);
const documento = /** @type {Record<string, string>} */ (serie.document);
const bandeiras = /** @type {Record<string, string>} */ (serie.bandeiras ?? {});
const unidade = unidadeDaLinha(serie.unit, lang);
const nome = nomeDoCartao(linhaPt, lang);
if (!nome) throw new Error(`série «${id}»: a linha portuguesa não tem nome de cartão.`);
/* O DIA EM QUE A TABELA DOS NOMES FOI LIDA. Os 27 documentos leram-se na mesma
   corrida, e o recibo diz um dia: se não forem todos do mesmo dia, a construção
   para, porque um dia só seria falso. */
const diasDaTabela = [...new Set(paisesDaUniao().map((p) => p.lido_em.slice(0, 10)))];
if (diasDaTabela.length !== 1) throw new Error(`a tabela dos nomes foi lida em ${diasDaTabela.length} dias; o recibo diz um.`);
const { tabela } = fonteDaTabelaDosPaises();
const outraLingua = LANGS.find((l) => l !== lang) ?? 'pt';
const path = routePath('serie', lang, { slug: id });
const titulo = `${nome.texto} · ${s.livro.serie.metaSufixo} · ${s.livro.eyebrow} · ${SITE_NAME}`;
/* A DESCRIÇÃO NÃO LEVA O IDENTIFICADOR: tem algarismos, e o `<head>` não tem
   onde os provar. O identificador está no corpo, com a sua marca. */
const descricao = `${s.livro.serie.eyebrow} · ${nome.texto} ${s.livro.serie.nosPaises} · ${serie.source}`;
---

<Base lang={lang} path={path} title={titulo} description={descricao}>
  <div class="linha-cabeca serie-cabeca">
    <span class="eyebrow">{s.livro.serie.eyebrow}</span>
    <h1 class="serie-titulo">
      <NomeDaMedida linha={linhaPt} lang={lang} escada="cartao" class="serie-titulo-nome" />{' '}
      <span data-voz>{s.livro.serie.nosPaises}</span>
    </h1>
    <p class="serie-periodo">
      <span class="linha-campo-k" data-voz>{s.livro.serie.periodoK}</span>{' '}
      <DataDaSerie serie={id} campo="periodo" valor={String(serie.periodo)} lang={lang} />
      {' · '}
      <CampoDaSerie serie={id} campo="unit" valor={unidade.texto} lingua={unidade.lingua} />
    </p>
    <p class="linha-id">
      <span class="linha-id-k">{s.livro.linha.identificadorK}</span>{' '}
      <CampoDaSerie serie={id} campo="id" valor={id} as="code" />
    </p>
  </div>

  <div class="linha">
    <div class="linha-corpo">
      <p class="linha-atribuicao">
        <span data-voz>{s.livro.linha.publicadoPor}</span>{' '}
        <CampoDaSerie serie={id} campo="source" valor={String(serie.source)} />
        {', '}<span data-voz>{s.livro.linha.publicadoEm}</span>{' «'}
        <CampoDaSerie serie={id} campo="document.title" valor={documento.title} lingua={lang === 'pt' ? 'en' : null} />
        {'» ('}<CampoDaSerie serie={id} campo="document.edition" valor={documento.edition} />{').'}
      </p>

      <section class="linha-bloco serie-pontos" aria-labelledby="pontos">
        <h2 class="linha-bloco-titulo" id="pontos">{s.livro.serie.pontosK}</h2>
        <table class="serie-tabela" data-serie-tabela={id}>
          <thead>
            <tr>
              <th scope="col">{s.livro.serie.paisK}</th>
              <th scope="col" class="serie-num">{s.livro.serie.valorK}</th>
              <th scope="col">{s.livro.serie.marcaK}</th>
            </tr>
          </thead>
          <tbody>
            {pontos.map((p) => {
              const geo = String(p.geo);
              const marca = p.bandeira ? String(p.bandeira) : null;
              return (
                <tr data-serie-ponto={`${id}#${geo}`} class:list={[geo === 'PT' && 'serie-portugal', geo === AGREGADO_DA_UNIAO && 'serie-uniao']}>
                  <th scope="row">
                    {geo === AGREGADO_DA_UNIAO ? <span data-voz>{s.cartao.uniaoEuropeia}</span> : <NomeDoPais geo={geo} lang={lang} />}
                  </th>
                  <td class="serie-num"><PontoDaSerie serie={id} geo={geo} /></td>
                  <td class="serie-marca">
                    {marca && (
                      <>
                        <span data-ponto-bandeira={`${id}#${geo}`}>{marca}</span>{' '}
                        <CampoDaSerie serie={id} campo={`bandeiras.${marca}`} valor={bandeiras[marca]} lingua={lang === 'pt' ? 'en' : null} class="serie-marca-rotulo" />
                      </>
                    )}
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </section>

      <section class="linha-bloco serie-prova" aria-labelledby="prova-k" id="prova">
        <h2 class="linha-bloco-titulo" id="prova-k">{s.livro.linha.provaK}</h2>
        <p>
          <span class="linha-campo-k">{s.livro.serie.pedidoK}</span>{' '}
          <a href={String(serie.source_url)} class="serie-pedido"><CampoDaSerie serie={id} campo="source_url" valor={String(serie.source_url)} /></a>
        </p>
        <p>
          <span class="linha-campo-k">{s.livro.serie.paginaDaFonteK}</span>{' '}
          <a href={documento.url}><CampoDaSerie serie={id} campo="document.url" valor={documento.url} /></a>
        </p>
        <p>
          <span class="linha-campo-k">{s.livro.serie.literalK}</span>{' '}
          <CampoDaSerie serie={id} campo="excerpt" valor={String(serie.excerpt)} lingua={lang === 'pt' ? 'en' : null} as="q" />
        </p>
        <p>
          <span class="linha-campo-k">{s.livro.serie.lidoK}</span>{' '}
          <DataDaSerie serie={id} campo="access_date" valor={String(serie.access_date)} lang={lang} />
        </p>
        <p>
          <span class="linha-campo-k">{s.livro.serie.publicadoK}</span>{' '}
          <DataDaSerie serie={id} campo="published_at" valor={String(serie.published_at)} lang={lang} />
        </p>
      </section>

      <section class="linha-bloco serie-nomes" aria-labelledby="nomes">
        <h2 class="linha-bloco-titulo" id="nomes">{s.livro.serie.nomesK}</h2>
        <p>
          <span data-voz>{s.livro.serie.nomesFrase}</span>{' '}
          <span data-tabela-dos-paises="lido_em">{diasDaTabela[0].split('-').reverse().join('.')}</span>{'. '}
          <a href={tabela}>{s.livro.serie.nomesPorta}</a>
        </p>
      </section>
    </div>

    <aside class="aparelho" aria-labelledby="aparelho">
      <h2 class="aparelho-titulo" id="aparelho">{s.livro.linha.aparelhoK}</h2>
      <dl class="aparelho-ficha">
        <dt>{s.livro.serie.gemeasK}</dt>
        <dd><a href={routePath('linha', lang, { slug: linhaPt.id })}>{s.livro.serie.linhaDePortugal}</a></dd>
        <dd><a href={routePath('linha', lang, { slug: linhaUe.id })}>{s.livro.serie.linhaDaUniao}</a></dd>
        <dt>{s.livro.serie.estudoK}</dt>
        <dd><span data-nonledger="proveniencia">{studyLabel(String(serie.study), lang)}</span></dd>
        <dt>{s.livro.serie.outraEdicaoK}</dt>
        <dd><a href={routePath('serie', outraLingua, { slug: id })} hreflang={outraLingua === 'en' ? 'en' : 'pt-PT'}>{s.livro.serie.noutraEdicao}</a></dd>
      </dl>
    </aside>
  </div>
</Base>
