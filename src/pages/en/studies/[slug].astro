---
import EstudoView from '../../../views/EstudoView.astro';
import { WORKS } from '../../../data/studies.mjs';

export function getStaticPaths() {
  return WORKS.filter(w => w.estado !== 'retirado').map((w) => ({ params: { slug: w.slug } }));
}

const { slug } = Astro.params;
---
<EstudoView lang="en" slug={slug} />
