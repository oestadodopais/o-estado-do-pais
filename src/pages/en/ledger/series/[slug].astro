---
import SerieView from '../../../../views/SerieView.astro';
import { allSeries } from '../../../../lib/series.mjs';

export function getStaticPaths() {
  return allSeries().filter((s) => s.eixo === 'pais').map((s) => ({ params: { slug: s.id } }));
}

const { slug } = Astro.params;
---
<SerieView lang="en" id={slug} />
