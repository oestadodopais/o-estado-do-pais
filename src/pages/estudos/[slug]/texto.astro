---
import { todosOsRegistos } from '../../../lib/registos.mjs';
import { routePath } from '../../../lib/routes.mjs';
export function getStaticPaths() {
  return todosOsRegistos().filter(r => r.lang === 'pt').map(r => ({ params: { slug: r.slug } }));
}
return Astro.redirect(routePath('estudo', 'pt', { slug: Astro.params.slug }) + '/', 301);
---
