---
/* Uma explicação (bloco EX1, 05.10.2026): a casca fina de `/explicacoes/<slug>`, uma página por explicação
   declarada em `src/data/explicacoes/`. */
import ExplicacaoView from '../../views/ExplicacaoView.astro';
import { slugsDasExplicacoes } from '../../lib/explicacoes.mjs';

export function getStaticPaths() {
  return slugsDasExplicacoes().map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
---
<ExplicacaoView lang="pt" slug={slug} />
