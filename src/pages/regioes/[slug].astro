---
/**
 * A página de uma região, nas duas edições, da mesma construção.
 * Os caminhos saem da lista de dados e do livro-razão: uma região sem linhas
 * não tem página (Emenda 21e), e não há lista escrita à mão.
 */
import RegiaoView from '../../views/RegiaoView.astro';
import { slugsDasRegioes } from '../../lib/regioes.mjs';

export function getStaticPaths() {
  return slugsDasRegioes().map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
---
<RegiaoView lang="pt" slug={slug} />
