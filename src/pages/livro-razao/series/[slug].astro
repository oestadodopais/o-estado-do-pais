---
/**
 * Uma página por linha de série do livro-razão (bloco UE1, 29.09.2026), nas
 * duas edições e da mesma construção. Os caminhos saem das próprias séries.
 * Desde o bloco RP3 (04.10.2026), só as séries de países (`eixo: pais`): as
 * séries no tempo têm o seu ficheiro de página, `[...serie].astro`, ao lado.
 */
import SerieView from '../../../views/SerieView.astro';
import { allSeries } from '../../../lib/series.mjs';

export function getStaticPaths() {
  return allSeries().filter((s) => s.eixo === 'pais').map((s) => ({ params: { slug: s.id } }));
}

const { slug } = Astro.params;
---
<SerieView lang="pt" id={slug} />
